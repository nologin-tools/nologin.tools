{
	"name": "nologin-tools",
	"account_id": "1446cafd2b53be9b96d5ec5b0b0c786f",
	"pages_build_output_dir": "./dist",
	"compatibility_date": "2026-02-18",
	"compatibility_flags": [
		"nodejs_compat",
		"disable_nodejs_process_v2"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nologin-tools-db",
			"database_id": "7160f24b-69df-4e43-8c27-ff4f439c007e",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"SITE_URL": "https://nologin.tools",
		"RATE_LIMIT_MAX_SUBMISSIONS": "3",
		"RATE_LIMIT_WINDOW_HOURS": "24"
	},
	"observability": {
		"enabled": true
	}
}
