---
export const prerender = false;

import SubmitSuccessPage from '../../components/SubmitSuccessPage.astro';
import type { Locale } from '../../i18n/config';

const urlLang = Astro.url.searchParams.get('lang') as Locale | null;
const cookieLang = Astro.cookies.get('nologin_locale')?.value as Locale | undefined;
const locale: Locale = urlLang || cookieLang || 'en';
---

<SubmitSuccessPage locale={locale} />
