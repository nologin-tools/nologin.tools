    {/* Code Examples */}
    <section class="mb-12">
      <h2 class="text-2xl font-bold font-mono text-neutral-900 tracking-tight mb-6 uppercase tracking-wide">
        {t(locale, 'dev.section.code')}
      </h2>

      <div class="space-y-4">
        <div class="bg-white border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] overflow-hidden">
          <div class="px-5 py-3 bg-neutral-100 border-b-2 border-neutral-900 font-mono text-xs font-bold text-neutral-900 uppercase">
            TypeScript / JavaScript (Fetch API)
          </div>
          <pre class="p-5 bg-neutral-900 text-neutral-200 text-xs font-mono overflow-x-auto"><code>{`const res = await fetch('https://nologin.tools/api/v1/tools?category=Privacy&clientSide=1');
const { data } = await res.json();
console.log('Found', data.total, 'private tools:', data.tools.map(t => t.name));`}</code></pre>
