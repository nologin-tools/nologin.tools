  </div>

  <script src="/widget.js" async></script>
  <script is:inline>
    (function () {
      let activeMode = 'category';

      const modeCatBtn = document.getElementById('widget-mode-category');
      const modeAltBtn = document.getElementById('widget-mode-alternative');
      const catGroup = document.getElementById('widget-category-group');
      const altGroup = document.getElementById('widget-alternative-group');
      const catSelect = document.getElementById('widget-category-select');
      const altSelect = document.getElementById('widget-alternative-select');
      const themeSelect = document.getElementById('widget-theme-select');
      const maxSelect = document.getElementById('widget-max-select');
      const codeDisplay = document.getElementById('widget-code-display');
      const copyBtn = document.getElementById('widget-copy-btn');
      const copyText = document.getElementById('widget-copy-text');
      const liveTarget = document.getElementById('widget-live-target');

      function updateWidget() {
        if (!liveTarget || !codeDisplay) return;

        const theme = themeSelect ? themeSelect.value : 'auto';
        const max = maxSelect ? maxSelect.value : '3';
        let snippet = '';

        liveTarget.innerHTML = '';
        const widgetDiv = document.createElement('div');
        widgetDiv.className = 'nologin-widget';
        widgetDiv.setAttribute('data-theme', theme);
        widgetDiv.setAttribute('data-max', max);

        if (activeMode === 'category') {
          const cat = catSelect ? catSelect.value : '';
          if (cat) {
            widgetDiv.setAttribute('data-category', cat);
            snippet = '<div class="nologin-widget" data-category="' + cat + '" data-theme="' + theme + '" data-max="' + max + '"></div>\n<script src="https://nologin.tools/widget.js" async><' + '/script>';
          } else {
            snippet = '<div class="nologin-widget" data-theme="' + theme + '" data-max="' + max + '"></div>\n<script src="https://nologin.tools/widget.js" async><' + '/script>';
          }
        } else {
          const alt = altSelect ? altSelect.value : 'canva';
          widgetDiv.setAttribute('data-alternative', alt);
          snippet = '<div class="nologin-widget" data-alternative="' + alt + '" data-theme="' + theme + '" data-max="' + max + '"></div>\n<script src="https://nologin.tools/widget.js" async><' + '/script>';
        }

        codeDisplay.textContent = snippet;
        liveTarget.appendChild(widgetDiv);

        if (window.NoLoginWidget && window.NoLoginWidget.render) {
          window.NoLoginWidget.render(widgetDiv, window.location.origin);
        }
      }

      modeCatBtn?.addEventListener('click', function () {
        activeMode = 'category';
        modeCatBtn.className = 'py-2 px-3 text-xs font-bold rounded-lg transition-all bg-white text-neutral-900 shadow-2xs cursor-pointer';
        modeAltBtn.className = 'py-2 px-3 text-xs font-bold rounded-lg transition-all text-neutral-600 hover:text-neutral-900 cursor-pointer';
        catGroup?.classList.remove('hidden');
        altGroup?.classList.add('hidden');
        updateWidget();
      });

      modeAltBtn?.addEventListener('click', function () {
        activeMode = 'alternative';
        modeAltBtn.className = 'py-2 px-3 text-xs font-bold rounded-lg transition-all bg-white text-neutral-900 shadow-2xs cursor-pointer';
        modeCatBtn.className = 'py-2 px-3 text-xs font-bold rounded-lg transition-all text-neutral-600 hover:text-neutral-900 cursor-pointer';
        altGroup?.classList.remove('hidden');
        catGroup?.classList.add('hidden');
        updateWidget();
      });

      catSelect?.addEventListener('change', updateWidget);
      altSelect?.addEventListener('change', updateWidget);
      themeSelect?.addEventListener('change', updateWidget);
      maxSelect?.addEventListener('change', updateWidget);

      copyBtn?.addEventListener('click', async function () {
        try {
          await navigator.clipboard.writeText(codeDisplay?.textContent || '');
          if (copyText) {
            const original = copyText.textContent;
            copyText.textContent = 'Copied!';
            setTimeout(function () {
              copyText.textContent = original;
            }, 2000);
          }
        } catch (_) {}
      });

      if (window.NoLoginWidget) {
        updateWidget();
      } else {
        window.addEventListener('load', updateWidget);
      }
    })();
  </script>
</Layout>
