        <div class="bg-white border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] overflow-hidden">
          <div class="px-5 py-3 bg-neutral-100 border-b-2 border-neutral-900 font-mono text-xs font-bold text-neutral-900 uppercase">
            Python (requests)
          </div>
          <pre class="p-5 bg-neutral-900 text-neutral-200 text-xs font-mono overflow-x-auto"><code>{`import requests

res = requests.get('https://nologin.tools/api/v1/tools', params={'category': 'Design', 'offline': '1'})
tools = res.json()['data']['tools']
for tool in tools:
    print(f"{tool['name']} -> {tool['url']}")`}</code></pre>
        </div>
      </div>
