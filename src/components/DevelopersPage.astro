---
import Layout from '../layouts/Layout.astro';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
await loadTranslations(locale);

const pageTitle = t(locale, 'dev.title');
const pageDescription = t(locale, 'dev.description');
const canonicalPath = getLocalizedPath('/developers', locale);

// Schema.org WebPage + TechArticle
const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: t(locale, 'dev.hero.heading'),
  description: pageDescription,
  url: `https://nologin.tools${canonicalPath}`,
  inLanguage: locale,
  proficiencyLevel: 'Beginner',
  author: {
    '@type': 'Organization',
    name: 'NoLoginTools.org',
    url: 'https://nologintools.org',
  },
};

// Schema.org Breadcrumbs
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(locale, 'common.home'),
      item: `https://nologin.tools${getLocalizedPath('/', locale)}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t(locale, 'nav.developers'),
      item: `https://nologin.tools${canonicalPath}`,
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(webPageLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    {/* Breadcrumb Navigation */}
    <nav class="flex items-center gap-2 text-xs font-mono font-bold text-neutral-500 mb-8 overflow-x-auto whitespace-nowrap" aria-label="Breadcrumb">
      <a href={getLocalizedPath('/', locale)} class="hover:text-neutral-900 transition-colors">
        {t(locale, 'common.home')}
      </a>
      <span>/</span>
      <span class="text-neutral-900 font-bold">{t(locale, 'nav.developers')}</span>
    </nav>

    {/* Hero Section */}
    <header class="mb-12 border-b-2 border-neutral-900 pb-8">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 text-xs font-mono font-bold bg-yellow-300 text-neutral-900 border-2 border-neutral-900 mb-4 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] uppercase tracking-wider">
        <span>⚡</span>
        <span>{t(locale, 'dev.hero.badge')}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight mb-4 font-mono">
        {t(locale, 'dev.hero.heading')}
      </h1>

      <p class="text-base sm:text-lg text-neutral-700 leading-relaxed max-w-3xl mb-8">
        {t(locale, 'dev.hero.subtitle')}
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/api/v1/openapi.json"
          target="_blank"
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-neutral-900 hover:bg-neutral-800 text-white font-mono text-xs font-bold uppercase border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] transition-none"
        >
          <span>📜</span>
          <span>{t(locale, 'dev.btn.viewSpec')}</span>
          <span class="text-neutral-400">&nearr;</span>
        </a>
        <a
          href="/api/v1/mcp.json"
          target="_blank"
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-white hover:bg-yellow-50 text-neutral-900 font-mono text-xs font-bold uppercase border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] transition-none"
        >
          <span>🤖</span>
          <span>{t(locale, 'dev.btn.viewMcp')}</span>
          <span class="text-neutral-500">&nearr;</span>
        </a>
      </div>
    </header>

    {/* Platform Specs Matrix */}
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-14" aria-label="Platform Matrix">
      <div class="bg-white border-2 border-neutral-900 p-5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-500 mb-1">
          {t(locale, 'dev.card.baseUrl')}
        </div>
        <div class="text-xs font-mono font-bold text-neutral-900 truncate">
          https://nologin.tools/api/v1/
        </div>
      </div>
      <div class="bg-white border-2 border-neutral-900 p-5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-500 mb-1">
          {t(locale, 'dev.card.auth')}
        </div>
        <div class="text-xs font-mono font-bold text-emerald-800 flex items-center gap-1.5">
          <span>[✓]</span>
          <span>{t(locale, 'dev.card.authVal')}</span>
        </div>
      </div>
      <div class="bg-white border-2 border-neutral-900 p-5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-500 mb-1">
          {t(locale, 'dev.card.rateLimit')}
        </div>
        <div class="text-xs font-mono font-bold text-neutral-900">
          {t(locale, 'dev.card.rateLimitVal')}
        </div>
      </div>
      <div class="bg-white border-2 border-neutral-900 p-5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-500 mb-1">
          {t(locale, 'dev.card.spec')}
        </div>
        <div class="text-xs font-mono font-bold text-neutral-900">
          {t(locale, 'dev.card.specVal')}
        </div>
      </div>
    </section>

    {/* Endpoints Reference */}
    <section class="mb-16">
      <h2 class="text-2xl font-bold font-mono text-neutral-900 tracking-tight mb-6 uppercase tracking-wide">
        {t(locale, 'dev.section.endpoints')}
      </h2>

      <div class="space-y-8">
        {/* Endpoint 1: GET /api/v1/tools */}
        <article class="bg-white border-2 border-neutral-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
          <div class="p-6 border-b-2 border-neutral-900 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 bg-emerald-200 text-neutral-900 border border-neutral-900 font-mono text-xs font-bold">
                GET
              </span>
              <span class="font-mono text-sm font-bold text-neutral-900">
                /api/v1/tools
              </span>
            </div>
            <span class="text-xs font-mono text-neutral-500">
              Search, filter, and paginate verified tools
            </span>
          </div>

          <div class="p-6 space-y-5">
            <div>
              <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-600 mb-3">
                Query Parameters
              </h4>
              <div class="overflow-x-auto border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                <table class="w-full text-left text-xs">
                  <thead class="bg-neutral-900 border-b-2 border-neutral-900 font-mono font-bold text-white">
                    <tr>
                      <th class="p-2.5 border-r border-neutral-700">Parameter</th>
                      <th class="p-2.5 border-r border-neutral-700">Type</th>
                      <th class="p-2.5 border-r border-neutral-700">Description</th>
                      <th class="p-2.5">Example</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-neutral-200 font-mono bg-white">
                    <tr>
                      <td class="p-2.5 font-bold text-neutral-900 border-r border-neutral-200">q</td>
                      <td class="p-2.5 text-neutral-500 border-r border-neutral-200">string</td>
                      <td class="p-2.5 text-neutral-700 border-r border-neutral-200">Keyword search across name, task, and description</td>
                      <td class="p-2.5 text-neutral-900 font-bold">q=pdf</td>
                    </tr>
                    <tr>
                      <td class="p-2.5 font-bold text-neutral-900 border-r border-neutral-200">category</td>
                      <td class="p-2.5 text-neutral-500 border-r border-neutral-200">string</td>
                      <td class="p-2.5 text-neutral-700 border-r border-neutral-200">Filter by category (AI, Design, Media, Privacy, etc.)</td>
                      <td class="p-2.5 text-neutral-900 font-bold">category=Design</td>
                    </tr>
                    <tr>
                      <td class="p-2.5 font-bold text-neutral-900 border-r border-neutral-200">clientSide</td>
                      <td class="p-2.5 text-neutral-500 border-r border-neutral-200">boolean</td>
                      <td class="p-2.5 text-neutral-700 border-r border-neutral-200">Filter for in-browser client-side memory processing</td>
                      <td class="p-2.5 text-neutral-900 font-bold">clientSide=1</td>
                    </tr>
                    <tr>
                      <td class="p-2.5 font-bold text-neutral-900 border-r border-neutral-200">offline</td>
                      <td class="p-2.5 text-neutral-500 border-r border-neutral-200">boolean</td>
                      <td class="p-2.5 text-neutral-700 border-r border-neutral-200">Filter for PWA offline-capable tools</td>
                      <td class="p-2.5 text-neutral-900 font-bold">offline=1</td>
                    </tr>
                    <tr>
                      <td class="p-2.5 font-bold text-neutral-900 border-r border-neutral-200">openSource</td>
                      <td class="p-2.5 text-neutral-500 border-r border-neutral-200">boolean</td>
                      <td class="p-2.5 text-neutral-700 border-r border-neutral-200">Filter for verified open-source tools</td>
                      <td class="p-2.5 text-neutral-900 font-bold">openSource=1</td>
                    </tr>
                    <tr>
                      <td class="p-2.5 font-bold text-neutral-900 border-r border-neutral-200">limit / offset</td>
                      <td class="p-2.5 text-neutral-500 border-r border-neutral-200">integer</td>
                      <td class="p-2.5 text-neutral-700 border-r border-neutral-200">Pagination limit (max 100) and offset</td>
                      <td class="p-2.5 text-neutral-900 font-bold">limit=10&offset=0</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div>
              <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-600 mb-2">
                Sample Request & Response
              </h4>
              <pre class="bg-neutral-900 text-neutral-200 text-xs font-mono p-4 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] overflow-x-auto"><code>curl -s "https://nologin.tools/api/v1/tools?category=Media&clientSide=1&limit=2"</code></pre>
            </div>
          </div>
        </article>

        {/* Endpoint 2: GET /api/v1/tools/{slug} */}
        <article class="bg-white border-2 border-neutral-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
          <div class="p-6 border-b-2 border-neutral-900 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 bg-emerald-200 text-neutral-900 border border-neutral-900 font-mono text-xs font-bold">
                GET
              </span>
              <span class="font-mono text-sm font-bold text-neutral-900">
                /api/v1/tools/:slug
              </span>
            </div>
            <span class="text-xs font-mono text-neutral-500">
              Fetch full security audit, specs, and health for a single tool
            </span>
          </div>

          <div class="p-6 space-y-4">
            <div>
              <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-600 mb-2">
                Sample Request
              </h4>
              <pre class="bg-neutral-900 text-neutral-200 text-xs font-mono p-4 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] overflow-x-auto"><code>curl -s "https://nologin.tools/api/v1/tools/excalidraw-com"</code></pre>
            </div>
          </div>
        </article>

        {/* Endpoint 3: GET /api/v1/workflows */}
        <article class="bg-white border-2 border-neutral-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
          <div class="p-6 border-b-2 border-neutral-900 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 bg-emerald-200 text-neutral-900 border border-neutral-900 font-mono text-xs font-bold">
                GET
              </span>
              <span class="font-mono text-sm font-bold text-neutral-900">
                /api/v1/workflows
              </span>
            </div>
            <span class="text-xs font-mono text-neutral-500">
              Retrieve curated multi-tool workflow recipes
            </span>
          </div>

          <div class="p-6 space-y-4">
            <div>
              <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-600 mb-2">
                Sample Request
              </h4>
              <pre class="bg-neutral-900 text-neutral-200 text-xs font-mono p-4 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] overflow-x-auto"><code>curl -s "https://nologin.tools/api/v1/workflows?slug=private-podcast-production"</code></pre>
            </div>
          </div>
        </article>
      </div>
    </section>

    {/* AI & MCP Protocol Integration */}
    <section class="mb-16 bg-neutral-900 text-white border-2 border-neutral-900 p-8 sm:p-10 shadow-[5px_5px_0px_0px_rgba(0,0,0,1)]">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 text-xs font-mono font-bold bg-neutral-800 text-yellow-300 border border-neutral-700 mb-4">
          <span>🤖</span>
          <span>Model Context Protocol (MCP)</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-4 font-mono">
          {t(locale, 'dev.section.mcp')}
        </h2>
        <p class="text-sm text-neutral-300 leading-relaxed mb-6 font-mono">
          {t(locale, 'dev.section.mcpDesc')}
        </p>

        <div class="space-y-4 mb-6">
          <div>
            <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-400 mb-2">
              Instant AI Assistant Setup (`claude_desktop_config.json` or `.cursor/mcp.json`)
            </h4>
            <pre class="bg-neutral-950 text-neutral-200 text-xs font-mono p-4 border border-neutral-800 overflow-x-auto"><code>{JSON.stringify({
  mcpServers: {
    "nologin-tools": {
      command: "npx",
      args: ["-y", "nologin-tools-mcp"]
    }
  }
}, null, 2)}</code></pre>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono">
          <div class="p-3 bg-neutral-800/90 border border-neutral-700">
            <div class="font-mono font-bold text-emerald-400 mb-1">search_nologin_tools</div>
            <div class="text-neutral-400 text-[11px]">Filter tools by query, offline status, and client-side execution.</div>
          </div>
          <div class="p-3 bg-neutral-800/90 border border-neutral-700">
            <div class="font-mono font-bold text-emerald-400 mb-1">get_tool_details</div>
            <div class="text-neutral-400 text-[11px]">Retrieve security audit, privacy specs, and uptime stats.</div>
          </div>
          <div class="p-3 bg-neutral-800/90 border border-neutral-700">
            <div class="font-mono font-bold text-emerald-400 mb-1">list_workflows</div>
            <div class="text-neutral-400 text-[11px]">Query multi-tool chained recipes for end-to-end tasks.</div>
          </div>
          <div class="p-3 bg-neutral-800/90 border border-neutral-700">
            <div class="font-mono font-bold text-emerald-400 mb-1">find_alternatives</div>
            <div class="text-neutral-400 text-[11px]">Instantly find zero-login replacements for closed SaaS (Canva, Photoshop, etc.).</div>
          </div>
        </div>
      </div>
    </section>

    {/* Embeddable Web Widget Generator */}
    <section class="mb-16">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2 py-0.5 text-xs font-mono font-bold bg-emerald-100 text-emerald-950 border border-neutral-900">
          Widget
        </span>
        <span class="text-xs text-neutral-500 font-mono">&lt;4KB · Shadow DOM · Zero Dependencies</span>
      </div>
      <h2 class="text-2xl font-bold text-neutral-900 tracking-tight mb-2 font-mono">
        {t(locale, 'dev.section.widget')}
      </h2>
      <p class="text-sm text-neutral-700 leading-relaxed max-w-3xl mb-8">
        {t(locale, 'dev.section.widgetDesc')}
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        {/* Controls Card */}
        <div class="lg:col-span-5 bg-white border-2 border-neutral-900 p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] space-y-5">
          {/* Mode Switcher */}
          <div>
            <label class="block text-xs font-mono font-bold uppercase tracking-wider text-neutral-700 mb-2">
              {t(locale, 'dev.widget.filterType')}
            </label>
            <div class="grid grid-cols-2 gap-2 p-1 bg-neutral-100 border-2 border-neutral-900">
              <button
                type="button"
                id="widget-mode-category"
                class="py-2 px-3 text-xs font-mono font-bold border-2 border-neutral-900 bg-neutral-900 text-white cursor-pointer transition-none"
              >
                {t(locale, 'dev.widget.byCategory')}
              </button>
              <button
                type="button"
                id="widget-mode-alternative"
                class="py-2 px-3 text-xs font-mono font-bold border-2 border-transparent text-neutral-700 hover:text-neutral-900 cursor-pointer transition-none"
              >
                {t(locale, 'dev.widget.byAlternative')}
              </button>
            </div>
          </div>

          {/* Category Select */}
          <div id="widget-category-group">
            <label for="widget-category-select" class="block text-xs font-mono font-bold uppercase tracking-wider text-neutral-700 mb-2">
              {t(locale, 'dev.widget.categoryLabel')}
            </label>
            <select
              id="widget-category-select"
              class="w-full text-xs font-mono font-bold px-3 py-2.5 bg-white border-2 border-neutral-900 focus:outline-none focus:bg-yellow-50 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
            >
              <option value="">All Categories (Featured)</option>
              <option value="Design" selected>Design</option>
              <option value="Utilities">Utilities</option>
              <option value="Privacy">Privacy</option>
              <option value="Development">Development</option>
              <option value="Media">Media</option>
              <option value="AI">AI</option>
              <option value="Writing">Writing</option>
              <option value="Productivity">Productivity</option>
              <option value="Security">Security</option>
              <option value="Network">Network</option>
            </select>
          </div>

          {/* Alternative Select */}
          <div id="widget-alternative-group" class="hidden">
            <label for="widget-alternative-select" class="block text-xs font-mono font-bold uppercase tracking-wider text-neutral-700 mb-2">
              {t(locale, 'dev.widget.alternativeLabel')}
            </label>
            <select
              id="widget-alternative-select"
              class="w-full text-xs font-mono font-bold px-3 py-2.5 bg-white border-2 border-neutral-900 focus:outline-none focus:bg-yellow-50 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
            >
              <option value="canva" selected>Canva (Graphics & Design)</option>
              <option value="figma">Figma (Vector & Wireframes)</option>
              <option value="notion">Notion (Docs & Markdown)</option>
              <option value="photoshop">Photoshop (Raster & Photo)</option>
              <option value="wetransfer">WeTransfer (File Transfer)</option>
              <option value="tinyurl">TinyURL / Bitly (Link Shortener)</option>
              <option value="miro">Miro (Whiteboard)</option>
              <option value="lucidchart">Lucidchart (Architecture & Flowcharts)</option>
            </select>
          </div>

          {/* Theme & Max Items Grid */}
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="widget-theme-select" class="block text-xs font-mono font-bold uppercase tracking-wider text-neutral-700 mb-2">
                {t(locale, 'dev.widget.themeLabel')}
              </label>
              <select
                id="widget-theme-select"
                class="w-full text-xs font-mono font-bold px-3 py-2.5 bg-white border-2 border-neutral-900 focus:outline-none focus:bg-yellow-50 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
              >
                <option value="auto">Auto (System)</option>
                <option value="light">Light</option>
                <option value="dark">Dark</option>
              </select>
            </div>

            <div>
              <label for="widget-max-select" class="block text-xs font-mono font-bold uppercase tracking-wider text-neutral-700 mb-2">
                {t(locale, 'dev.widget.maxLabel')}
              </label>
              <select
                id="widget-max-select"
                class="w-full text-xs font-mono font-bold px-3 py-2.5 bg-white border-2 border-neutral-900 focus:outline-none focus:bg-yellow-50 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
              >
                <option value="2">2 Tools</option>
                <option value="3" selected>3 Tools</option>
                <option value="4">4 Tools</option>
                <option value="5">5 Tools</option>
              </select>
            </div>
          </div>

          {/* Embed Code & Copy */}
          <div class="pt-2 border-t-2 border-neutral-900">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-600">HTML Snippet</span>
              <button
                type="button"
                id="widget-copy-btn"
                class="text-xs font-mono font-bold text-neutral-900 hover:text-emerald-700 underline inline-flex items-center gap-1 cursor-pointer"
              >
                <span id="widget-copy-icon">📋</span>
                <span id="widget-copy-text">{t(locale, 'dev.widget.copyCode')}</span>
              </button>
            </div>
            <pre class="bg-neutral-900 text-neutral-200 text-[11px] font-mono p-3 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] overflow-x-auto leading-relaxed"><code id="widget-code-display">&lt;div class="nologin-widget" data-category="Design" data-theme="auto" data-max="3"&gt;&lt;/div&gt;
&lt;script src="https://nologin.tools/widget.js" async&gt;&lt;/script&gt;</code></pre>
          </div>
        </div>

        {/* Live Preview Card */}
        <div class="lg:col-span-7 space-y-3">
          <div class="flex items-center justify-between text-xs text-neutral-500 px-1 font-mono font-bold">
            <span class="uppercase tracking-wider">{t(locale, 'dev.widget.preview')}</span>
            <span class="text-[11px] text-emerald-800 flex items-center gap-1">
              <span class="w-2 h-2 bg-emerald-600 inline-block"></span>
              Isolated Shadow DOM
            </span>
          </div>

          <div class="p-4 sm:p-6 bg-neutral-50 border-2 border-neutral-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] min-h-[260px] flex flex-col justify-center">
            <div id="widget-live-target"></div>
          </div>
