---
import Layout from '../layouts/Layout.astro';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
await loadTranslations(locale);

const pageTitle = t(locale, 'dev.title');
const pageDescription = t(locale, 'dev.description');
const canonicalPath = getLocalizedPath('/developers', locale);

// Schema.org WebPage + TechArticle
const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: t(locale, 'dev.hero.heading'),
  description: pageDescription,
  url: `https://nologin.tools${canonicalPath}`,
  inLanguage: locale,
  proficiencyLevel: 'Beginner',
  author: {
    '@type': 'Organization',
    name: 'NoLoginTools.org',
    url: 'https://nologintools.org',
  },
};

// Schema.org Breadcrumbs
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(locale, 'common.home'),
      item: `https://nologin.tools${getLocalizedPath('/', locale)}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t(locale, 'nav.developers'),
      item: `https://nologin.tools${canonicalPath}`,
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(webPageLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    {/* Breadcrumb Navigation */}
    <nav class="flex items-center gap-2 text-xs text-neutral-500 mb-8 overflow-x-auto whitespace-nowrap" aria-label="Breadcrumb">
      <a href={getLocalizedPath('/', locale)} class="hover:text-neutral-900 transition-colors">
        {t(locale, 'common.home')}
      </a>
      <span>/</span>
      <span class="text-neutral-900 font-medium">{t(locale, 'nav.developers')}</span>
    </nav>

    {/* Hero Section */}
    <header class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-purple-50 text-purple-700 border border-purple-200 mb-4 shadow-2xs">
        <span>⚡</span>
        <span>{t(locale, 'dev.hero.badge')}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight mb-4">
        {t(locale, 'dev.hero.heading')}
      </h1>

      <p class="text-base sm:text-lg text-neutral-600 leading-relaxed max-w-3xl mb-8">
        {t(locale, 'dev.hero.subtitle')}
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/api/v1/openapi.json"
          target="_blank"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-bold transition-all shadow-xs"
        >
          <span>📜</span>
          <span>{t(locale, 'dev.btn.viewSpec')}</span>
          <span class="text-neutral-400">&nearr;</span>
        </a>
        <a
          href="/api/v1/mcp.json"
          target="_blank"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-800 border border-purple-200 text-xs font-bold transition-all shadow-2xs"
        >
          <span>🤖</span>
          <span>{t(locale, 'dev.btn.viewMcp')}</span>
          <span class="text-purple-400">&nearr;</span>
        </a>
      </div>
    </header>

    {/* Platform Specs Matrix */}
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-14" aria-label="Platform Matrix">
      <div class="bg-white border border-neutral-200 rounded-2xl p-5 shadow-2xs">
        <div class="text-[11px] font-bold uppercase tracking-wider text-neutral-500 mb-1">
          {t(locale, 'dev.card.baseUrl')}
        </div>
        <div class="text-xs font-mono font-bold text-neutral-900 truncate">
          https://nologin.tools/api/v1/
        </div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-2xl p-5 shadow-2xs">
        <div class="text-[11px] font-bold uppercase tracking-wider text-neutral-500 mb-1">
          {t(locale, 'dev.card.auth')}
        </div>
        <div class="text-xs font-bold text-emerald-700 flex items-center gap-1.5">
          <span>✓</span>
          <span>{t(locale, 'dev.card.authVal')}</span>
        </div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-2xl p-5 shadow-2xs">
        <div class="text-[11px] font-bold uppercase tracking-wider text-neutral-500 mb-1">
          {t(locale, 'dev.card.rateLimit')}
        </div>
        <div class="text-xs font-bold text-neutral-800">
          {t(locale, 'dev.card.rateLimitVal')}
        </div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-2xl p-5 shadow-2xs">
        <div class="text-[11px] font-bold uppercase tracking-wider text-neutral-500 mb-1">
          {t(locale, 'dev.card.spec')}
        </div>
        <div class="text-xs font-bold text-neutral-800">
          {t(locale, 'dev.card.specVal')}
        </div>
      </div>
    </section>

    {/* Endpoints Reference */}
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-neutral-900 tracking-tight mb-6">
        {t(locale, 'dev.section.endpoints')}
      </h2>

      <div class="space-y-8">
        {/* Endpoint 1: GET /api/v1/tools */}
        <article class="bg-white border border-neutral-200 rounded-2xl overflow-hidden shadow-2xs">
          <div class="p-6 border-b border-neutral-100 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800 font-mono text-xs font-bold">
                GET
              </span>
              <span class="font-mono text-sm font-bold text-neutral-900">
                /api/v1/tools
              </span>
            </div>
            <span class="text-xs text-neutral-500 font-medium">
              Search, filter, and paginate verified tools
            </span>
          </div>

          <div class="p-6 space-y-5">
            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-3">
                Query Parameters
              </h4>
              <div class="overflow-x-auto border border-neutral-200 rounded-xl">
                <table class="w-full text-left text-xs">
                  <thead class="bg-neutral-50 border-b border-neutral-200 font-mono font-bold text-neutral-700">
                    <tr>
                      <th class="p-2.5">Parameter</th>
                      <th class="p-2.5">Type</th>
                      <th class="p-2.5">Description</th>
                      <th class="p-2.5">Example</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-neutral-100 font-mono">
                    <tr>
                      <td class="p-2.5 font-bold text-neutral-900">q</td>
                      <td class="p-2.5 text-neutral-500">string</td>
                      <td class="p-2.5 font-sans text-neutral-600">Keyword search across name, task, and description</td>
                      <td class="p-2.5 text-neutral-800">q=pdf</td>
                    </tr>
                    <tr>
                      <td class="p-2.5 font-bold text-neutral-900">category</td>
                      <td class="p-2.5 text-neutral-500">string</td>
                      <td class="p-2.5 font-sans text-neutral-600">Filter by category (AI, Design, Media, Privacy, etc.)</td>
                      <td class="p-2.5 text-neutral-800">category=Design</td>
                    </tr>
                    <tr>
                      <td class="p-2.5 font-bold text-neutral-900">clientSide</td>
                      <td class="p-2.5 text-neutral-500">boolean</td>
                      <td class="p-2.5 font-sans text-neutral-600">Filter for in-browser client-side memory processing</td>
                      <td class="p-2.5 text-neutral-800">clientSide=1</td>
                    </tr>
                    <tr>
                      <td class="p-2.5 font-bold text-neutral-900">offline</td>
                      <td class="p-2.5 text-neutral-500">boolean</td>
                      <td class="p-2.5 font-sans text-neutral-600">Filter for PWA offline-capable tools</td>
                      <td class="p-2.5 text-neutral-800">offline=1</td>
                    </tr>
                    <tr>
                      <td class="p-2.5 font-bold text-neutral-900">openSource</td>
                      <td class="p-2.5 text-neutral-500">boolean</td>
                      <td class="p-2.5 font-sans text-neutral-600">Filter for verified open-source tools</td>
                      <td class="p-2.5 text-neutral-800">openSource=1</td>
                    </tr>
                    <tr>
                      <td class="p-2.5 font-bold text-neutral-900">limit / offset</td>
                      <td class="p-2.5 text-neutral-500">integer</td>
                      <td class="p-2.5 font-sans text-neutral-600">Pagination limit (max 100) and offset</td>
                      <td class="p-2.5 text-neutral-800">limit=10&offset=0</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-2">
                Sample Request & Response
              </h4>
              <pre class="bg-neutral-900 text-neutral-200 text-xs font-mono p-4 rounded-xl overflow-x-auto"><code>curl -s "https://nologin.tools/api/v1/tools?category=Media&clientSide=1&limit=2"</code></pre>
            </div>
          </div>
        </article>

        {/* Endpoint 2: GET /api/v1/tools/{slug} */}
        <article class="bg-white border border-neutral-200 rounded-2xl overflow-hidden shadow-2xs">
          <div class="p-6 border-b border-neutral-100 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800 font-mono text-xs font-bold">
                GET
              </span>
              <span class="font-mono text-sm font-bold text-neutral-900">
                /api/v1/tools/:slug
              </span>
            </div>
            <span class="text-xs text-neutral-500 font-medium">
              Fetch full security audit, specs, and health for a single tool
            </span>
          </div>

          <div class="p-6 space-y-4">
            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-2">
                Sample Request
              </h4>
              <pre class="bg-neutral-900 text-neutral-200 text-xs font-mono p-4 rounded-xl overflow-x-auto"><code>curl -s "https://nologin.tools/api/v1/tools/excalidraw-com"</code></pre>
            </div>
          </div>
        </article>

        {/* Endpoint 3: GET /api/v1/workflows */}
        <article class="bg-white border border-neutral-200 rounded-2xl overflow-hidden shadow-2xs">
          <div class="p-6 border-b border-neutral-100 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800 font-mono text-xs font-bold">
                GET
              </span>
              <span class="font-mono text-sm font-bold text-neutral-900">
                /api/v1/workflows
              </span>
            </div>
            <span class="text-xs text-neutral-500 font-medium">
              Retrieve curated multi-tool workflow recipes
            </span>
          </div>

          <div class="p-6 space-y-4">
            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-2">
                Sample Request
              </h4>
              <pre class="bg-neutral-900 text-neutral-200 text-xs font-mono p-4 rounded-xl overflow-x-auto"><code>curl -s "https://nologin.tools/api/v1/workflows?slug=private-podcast-production"</code></pre>
            </div>
          </div>
        </article>
      </div>
    </section>

    {/* AI & MCP Protocol Integration */}
    <section class="mb-16 bg-neutral-900 text-white rounded-3xl p-8 sm:p-10 shadow-lg">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-neutral-800 text-purple-400 border border-neutral-700 mb-4">
          <span>🤖</span>
          <span>Model Context Protocol (MCP)</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-4">
          {t(locale, 'dev.section.mcp')}
        </h2>
        <p class="text-sm text-neutral-300 leading-relaxed mb-6">
          {t(locale, 'dev.section.mcpDesc')}
        </p>

        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-400 mb-3">
          Claude Desktop Configuration (`claude_desktop_config.json`)
        </h4>
        <pre class="bg-neutral-950 text-neutral-200 text-xs font-mono p-4 rounded-xl overflow-x-auto border border-neutral-800 mb-6"><code>{JSON.stringify({
  mcpServers: {
    nologin_tools: {
      url: "https://nologin.tools/api/v1/mcp.json",
      type: "sse",
    }
  }
}, null, 2)}</code></pre>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div class="p-3 bg-neutral-800/80 rounded-xl border border-neutral-700">
            <div class="font-mono font-bold text-emerald-400 mb-1">search_nologin_tools</div>
            <div class="text-neutral-400 text-[11px]">Filter tools by query, offline status, and client-side execution.</div>
          </div>
          <div class="p-3 bg-neutral-800/80 rounded-xl border border-neutral-700">
            <div class="font-mono font-bold text-emerald-400 mb-1">get_tool_details</div>
            <div class="text-neutral-400 text-[11px]">Retrieve security audit, privacy specs, and uptime stats.</div>
          </div>
          <div class="p-3 bg-neutral-800/80 rounded-xl border border-neutral-700">
            <div class="font-mono font-bold text-emerald-400 mb-1">list_workflows</div>
            <div class="text-neutral-400 text-[11px]">Query multi-tool chained recipes for end-to-end tasks.</div>
          </div>
        </div>
      </div>
    </section>

    {/* Dynamic Badges API */}
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-neutral-900 tracking-tight mb-6">
        {t(locale, 'dev.section.badges')}
      </h2>

      <div class="bg-white border border-neutral-200 rounded-2xl p-6 shadow-2xs space-y-6">
        <p class="text-sm text-neutral-600 leading-relaxed">
          Embed official real-time verification shields into your open-source README, docs, or landing page:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-4 bg-neutral-50 rounded-xl border border-neutral-200">
            <div class="text-xs font-bold text-neutral-800 mb-2">Live Dynamic SVG Badge:</div>
            <img src="/api/badge/excalidraw-com.svg" alt="NoLogin Verified" class="mb-3" />
            <pre class="bg-neutral-900 text-neutral-200 text-[11px] font-mono p-2.5 rounded-lg overflow-x-auto"><code>[![NoLogin Verified](https://nologin.tools/api/badge/excalidraw-com.svg)](https://nologin.tools/badge/excalidraw-com)</code></pre>
          </div>

          <div class="p-4 bg-neutral-900 rounded-xl border border-neutral-800">
            <div class="text-xs font-bold text-neutral-200 mb-2">Dark Theme SVG Shield:</div>
            <img src="/badges/flat-dark.svg" alt="NoLogin Verified" class="mb-3" />
            <pre class="bg-neutral-950 text-neutral-200 text-[11px] font-mono p-2.5 rounded-lg overflow-x-auto"><code>[![NoLogin Verified](https://nologin.tools/badges/flat-dark.svg)](https://nologin.tools/badge/excalidraw-com)</code></pre>
          </div>
        </div>
      </div>
    </section>

    {/* Code Examples */}
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-neutral-900 tracking-tight mb-6">
        {t(locale, 'dev.section.code')}
      </h2>

      <div class="space-y-4">
        <div class="bg-white border border-neutral-200 rounded-2xl overflow-hidden shadow-2xs">
          <div class="px-5 py-3 bg-neutral-100 border-b border-neutral-200 font-mono text-xs font-bold text-neutral-700">
            TypeScript / JavaScript (Fetch API)
          </div>
          <pre class="p-5 bg-neutral-900 text-neutral-200 text-xs font-mono overflow-x-auto"><code>{`const res = await fetch('https://nologin.tools/api/v1/tools?category=Privacy&clientSide=1');
const { data } = await res.json();
console.log('Found', data.total, 'private tools:', data.tools.map(t => t.name));`}</code></pre>
        </div>

        <div class="bg-white border border-neutral-200 rounded-2xl overflow-hidden shadow-2xs">
          <div class="px-5 py-3 bg-neutral-100 border-b border-neutral-200 font-mono text-xs font-bold text-neutral-700">
            Python (requests)
          </div>
          <pre class="p-5 bg-neutral-900 text-neutral-200 text-xs font-mono overflow-x-auto"><code>{`import requests

res = requests.get('https://nologin.tools/api/v1/tools', params={'category': 'Design', 'offline': '1'})
tools = res.json()['data']['tools']
for tool in tools:
    print(f"{tool['name']} -> {tool['url']}")`}</code></pre>
        </div>
      </div>
    </section>
  </div>
</Layout>
