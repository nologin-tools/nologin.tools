---
import Layout from '../layouts/Layout.astro';
import HealthBadge from './HealthBadge.astro';
import TagPicker from './TagPicker.astro';
import { formatDate, timeAgo } from '../lib/utils';
import { sortTagsCategoryFirst, categoryToSlug, isTagPageAllowed, tagValueToSlug } from '../lib/tags';
import { resolveEffectiveStatus, type EffectiveStatus } from '../lib/health';
import { buildToolSeoMeta, getToolCanonicalPath, resolveToolCanonicalLocale } from '../lib/tool-seo.mjs';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import { getToolEditorial } from '../data/loader';
import { getRelatedArticlesForTool } from '../lib/tool-blogs';
import { findAlternativeByAlias } from '../lib/alternatives';
import { findComparisonsForTool } from '../lib/comparisons';
import { findWorkflowsForTool } from '../lib/workflows';
import { computePrivacyScorecard } from '../lib/privacy-scorecard.mjs';


interface Props {
  tool: {
    id: number;
    slug: string;
    name: string;
    url: string;
    description: string | null;
    coreTask: string;
    seoTitle?: string | null;
    seoDescription?: string | null;
    seoFocusKeyword?: string | null;
    seoIntent?: string | null;
    seoTaskPhrase?: string | null;
    status: string;
    approvedAt: Date | string | null;
    archiveUrl: string | null;
    isFeatured: boolean;
    submitterEmail: string | null;
    twitterUrl?: string | null;
    githubUrl?: string | null;
    discordUrl?: string | null;
    repoUrl?: string | null;
    githubStars?: number | null;
    githubForks?: number | null;
    githubLicense?: string | null;
    githubLanguage?: string | null;
    githubUpdatedAt?: Date | string | null;
    githubFetchedAt?: Date | string | null;
    badgeDisplayType?: string | null;
  };
  toolTags: { tagKey: string; tagValue: string }[];
  recentChecks: { isOnline: boolean; httpStatus?: number | null; responseTimeMs?: number | null; checkedAt: Date }[];
  healthHistory: { isOnline: boolean; checkedAt: Date }[];
  slug: string;
  locale?: Locale;
  availableLocales?: Set<Locale>;
  relatedTools?: { slug: string; name: string; url: string; description: string | null }[];
}

const {
  tool,
  toolTags,
  recentChecks,
  healthHistory,
  slug,
  locale = DEFAULT_LOCALE,
  availableLocales,
  relatedTools = [],
} = Astro.props;
await loadTranslations(locale);

const effectiveStatus = resolveEffectiveStatus(recentChecks);
const latestHealth = recentChecks[0] ?? null;

// Group health by day
const healthByDay = new Map<string, EffectiveStatus>();
const checksPerDay = new Map<string, boolean[]>();
for (const check of healthHistory) {
  const day = check.checkedAt.toISOString().split('T')[0];
  if (!checksPerDay.has(day)) checksPerDay.set(day, []);
  checksPerDay.get(day)!.push(check.isOnline);
}
for (const [day, results] of checksPerDay) {
  const onlineCount = results.filter(Boolean).length;
  if (onlineCount === results.length) healthByDay.set(day, 'online');
  else if (onlineCount === 0) healthByDay.set(day, 'offline');
  else healthByDay.set(day, 'unstable');
}

// Generate last 14 days for timeline
const days: { date: string; label: string; status: EffectiveStatus | null }[] = [];
for (let i = 13; i >= 0; i--) {
  const d = new Date(Date.now() - i * 86400000);
  const key = d.toISOString().split('T')[0];
  days.push({
    date: key,
    label: d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
    status: healthByDay.get(key) ?? null,
  });
}

const hasSocialLinks = tool.twitterUrl || tool.githubUrl || tool.discordUrl;
const hasRepoData = tool.repoUrl;
const repoPath = tool.repoUrl ? tool.repoUrl.replace('https://github.com/', '').replace(/\/$/, '') : '';

function formatNumber(n: number): string {
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
  return String(n);
}

const isVerified = tool.status === 'approved';
const isPending = tool.status === 'pending';
const isRejected = tool.status === 'rejected';
const isOffline = effectiveStatus === 'offline';

const approvedDate = tool.approvedAt ? new Date(tool.approvedAt).toISOString().split('T')[0] : undefined;
const seo = buildToolSeoMeta(tool, locale);
const canonicalLocale = resolveToolCanonicalLocale(locale, availableLocales);

const categoryTag = toolTags.find(t => t.tagKey === 'category');
const dataTag = toolTags.find(t => t.tagKey === 'data');
const privacyTag = toolTags.find(t => t.tagKey === 'privacy');
const hostingTag = toolTags.find(t => t.tagKey === 'hosting');
const offlineTag = toolTags.find(t => t.tagKey === 'offline');
const sameAs = [tool.twitterUrl, tool.githubUrl, tool.discordUrl, tool.repoUrl].filter(Boolean) as string[];
const keywords = [seo.focusKeyword, ...toolTags.map(t => t.tagValue)].filter(Boolean).join(', ');

const pricingTag = toolTags.find(t => t.tagKey === 'pricing');
const pricingValue = pricingTag?.tagValue;

function getApplicationCategory(cat?: string): string {
  switch (cat) {
    case 'AI': return 'AIApplication';
    case 'Design': return 'DesignApplication';
    case 'Writing': return 'BusinessApplication';
    case 'Development': return 'DeveloperApplication';
    case 'Productivity': return 'ProductivityApplication';
    case 'Media': return 'MultimediaApplication';
    case 'Privacy': return 'SecurityApplication';
    case 'Finance': return 'FinanceApplication';
    case 'Education': return 'EducationalApplication';
    default: return 'WebApplication';
  }
}

function buildOffers() {
  const base: Record<string, unknown> = {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'USD',
    url: tool.url,
    availability: 'https://schema.org/InStock',
  };
  if (pricingValue === 'Freemium') {
    base.description = 'Free tier available; premium features require payment';
  } else if (pricingValue === 'Ad-Supported') {
    base.description = 'Free to use; supported by advertisements';
  }
  return base;
}

const editorial = getToolEditorial(slug, locale);
const scorecard = computePrivacyScorecard({ ...tool, tags: toolTags }, recentChecks, editorial);
const relatedArticles = getRelatedArticlesForTool(slug, locale);
const toolComparisons = findComparisonsForTool(slug);
const toolWorkflows = findWorkflowsForTool(slug);

const featureList = [
  tool.coreTask,
  'No account or login required',
  ...(editorial?.pros || []),
  ...toolTags.map(t => t.tagValue),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  url: tool.url,
  description: seo.description,
  applicationCategory: getApplicationCategory(categoryTag?.tagValue),
  operatingSystem: 'All, Web Browser',
  isAccessibleForFree: true,
  image: `https://nologin.tools/api/og/${slug}`,
  inLanguage: locale,
  offers: buildOffers(),
  featureList,
  publisher: {
    '@type': 'Organization',
    name: 'NoLoginTools.org',
    url: 'https://nologintools.org',
  },
  ...(tool.repoUrl ? { downloadUrl: tool.repoUrl, codeRepository: tool.repoUrl } : {}),
  ...(approvedDate ? { datePublished: approvedDate } : {}),
  ...(tool.githubUpdatedAt
    ? { dateModified: new Date(tool.githubUpdatedAt).toISOString().split('T')[0] }
    : approvedDate ? { dateModified: approvedDate } : {}),
  ...(sameAs.length > 0 ? { sameAs } : {}),
  ...(keywords ? { keywords } : {}),
  ...(editorial?.alternativeTo?.length ? {
    isSimilarTo: editorial.alternativeTo.map((alt) => ({
      '@type': 'SoftwareApplication',
      name: alt,
    })),
  } : {}),
  ...(editorial ? {
    review: {
      '@type': 'Review',
      reviewRating: {
        '@type': 'Rating',
        ratingValue: scorecard.overallScore,
        bestRating: 100,
        worstRating: 0,
      },
      reviewBody: scorecard.summary,
      positiveNotes: {
        '@type': 'ItemList',
        itemListElement: editorial.pros.map((p, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          name: p,
        })),
      },
      negativeNotes: {
        '@type': 'ItemList',
        itemListElement: editorial.cons.map((c, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          name: c,
        })),
      },
      author: {
        '@type': 'Organization',
        name: 'NoLoginTools Editorial Team',
        url: 'https://nologin.tools/about',
      },
    },
  } : {}),
  ...(relatedArticles.length > 0 ? {
    subjectOf: relatedArticles.map((a) => ({
      '@type': 'Article',
      headline: a.title,
      description: a.description,
      url: `https://nologin.tools${a.url}`,
    })),
  } : {}),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(locale, 'common.home'), item: `https://nologin.tools${getLocalizedPath('/', locale)}` },
    ...(categoryTag ? [{ '@type': 'ListItem', position: 2, name: categoryTag.tagValue, item: `https://nologin.tools${getLocalizedPath(`/category/${categoryToSlug(categoryTag.tagValue)}`, locale)}` }] : []),
    { '@type': 'ListItem', position: categoryTag ? 3 : 2, name: tool.name, item: `https://nologin.tools${getLocalizedPath(`/tool/${slug}`, locale)}` },
  ],
};

const faqLd = isVerified ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: locale,
  mainEntity: [
    {
      '@type': 'Question',
      name: t(locale, 'tool.faq.q2', { name: tool.name }),
      acceptedAnswer: { '@type': 'Answer', text: t(locale, 'tool.faq.a2', { name: tool.name, coreTask: tool.coreTask }) },
    },
    {
      '@type': 'Question',
      name: t(locale, 'tool.faq.q1', { name: tool.name }),
      acceptedAnswer: { '@type': 'Answer', text: t(locale, 'tool.faq.a1', { name: tool.name }) },
    },
  ],
} : null;
---

<Layout
  title={seo.title}
  description={seo.description || t(locale, 'tool.defaultDescription', { name: tool.name })}
  ogType="article"
  canonicalOverride={getToolCanonicalPath(slug, canonicalLocale)}
  publishedTime={approvedDate}
  ogImagePath={`/api/og/${slug}`}
  locale={locale}
  availableLocales={availableLocales}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8 sm:mb-10">
      <ol class="flex items-center gap-2 text-sm font-bold text-neutral-400">
        <li>
          <a href={getLocalizedPath('/', locale)} class="hover:text-neutral-900 transition-colors">{t(locale, 'common.home')}</a>
        </li>
        <li aria-hidden="true">
          <svg class="w-4 h-4 text-neutral-300" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
        </li>
        {categoryTag && (
          <>
            <li>
              <a href={getLocalizedPath(`/category/${categoryToSlug(categoryTag.tagValue)}`, locale)} class="hover:text-neutral-900 transition-colors">{categoryTag.tagValue}</a>
            </li>
            <li aria-hidden="true">
              <svg class="w-4 h-4 text-neutral-300" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
            </li>
          </>
        )}
        <li aria-current="page" class="text-neutral-900 truncate max-w-[200px] sm:max-w-none">{tool.name}</li>
      </ol>
    </nav>

    <!-- Status banners -->
    {isPending && (
      <div class="border-l-4 border-amber-500 pl-4 py-2 bg-amber-50 mb-8">
        <p class="text-amber-900 font-bold text-sm">{t(locale, 'tool.pendingReview')}</p>
        <p class="text-xs text-amber-800/70 leading-relaxed">
          {t(locale, 'tool.pendingDesc')}
        </p>
      </div>
    )}

    <!-- Main content -->
    <div class="space-y-8">
      <!-- Header -->
      <div>
        <div class="flex items-center gap-3 mb-3">
          <img
            src={`https://www.google.com/s2/favicons?domain=${new URL(tool.url).hostname}&sz=32`}
            alt={tool.name}
            width="24"
            height="24"
            class="w-6 h-6 object-contain"
            onerror={`this.style.display='none'`}
          />
          <h1 class="text-2xl font-bold text-neutral-900">{tool.name}</h1>
          {tool.isFeatured && (
            <span class="text-yellow-500 text-sm" title={t(locale, 'common.featured')}>★</span>
          )}
        </div>

        <div class="flex flex-wrap items-center gap-3 text-sm text-neutral-400 mb-4">
          <span>{new URL(tool.url).hostname}</span>
          {isVerified && tool.approvedAt && (
            <>
              <span class="text-neutral-300">·</span>
              <span>{t(locale, 'tool.verified', { date: formatDate(tool.approvedAt) })}</span>
            </>
          )}
          {tool.badgeDisplayType === 'explicit' && (
            <>
              <span class="text-neutral-300">·</span>
              <a
                href={`/badge/${tool.slug}#embed`}
                class="inline-flex items-center gap-1 text-xs font-semibold text-green-700 bg-green-50 border border-green-200 px-2 py-0.5 rounded hover:bg-green-100 transition-colors"
                title={t(locale, 'tool.badgeActiveDesc')}
              >
                <svg class="w-3 h-3 text-green-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <polyline points="9 12 11 14 15 10"></polyline>
                </svg>
                {t(locale, 'tool.badgeActive')}
              </a>
            </>
          )}
          <span class="text-neutral-300">·</span>
          <HealthBadge status={effectiveStatus} lastCheckedAt={latestHealth?.checkedAt ?? null} locale={locale} />
        </div>

        {hasSocialLinks && (
          <div class="flex items-center gap-3 text-sm text-neutral-500 mb-4">
            {tool.twitterUrl && (
              <a href={tool.twitterUrl} target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900 transition-colors">Twitter</a>
            )}
            {tool.twitterUrl && (tool.githubUrl || tool.discordUrl) && (
              <span class="text-neutral-300">·</span>
            )}
            {tool.githubUrl && (
              <a href={tool.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900 transition-colors">GitHub</a>
            )}
            {tool.githubUrl && tool.discordUrl && (
              <span class="text-neutral-300">·</span>
            )}
            {tool.discordUrl && (
              <a href={tool.discordUrl} target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900 transition-colors">Discord</a>
            )}
          </div>
        )}

        <div class="flex items-center gap-4">
          {isOffline ? (
            <>
              <button class="btn-minimal-primary opacity-50 cursor-not-allowed" disabled>{t(locale, 'tool.toolOffline')}</button>
              {tool.archiveUrl && (
                <a href={tool.archiveUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">
                  {t(locale, 'tool.viewArchive')}
                </a>
              )}
            </>
          ) : (
            <a href={tool.url} target="_blank" rel="noopener noreferrer" class="btn-minimal-primary">
              {t(locale, 'tool.openTool')}
              <svg class="ml-1.5 w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 010-1.06l7.22-7.22H5.75a.75.75 0 010-1.5h8.5a.75.75 0 01.75.75v8.5a.75.75 0 01-1.5 0V6.56l-7.22 7.22a.75.75 0 01-1.06 0z" clip-rule="evenodd" />
              </svg>
            </a>
          )}
          {isVerified && (
            <button id="suggest-edit-btn" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">
              {t(locale, 'tool.suggestEdit')}
            </button>
          )}
        </div>
      </div>

      <!-- Description -->
      <div class="border-t border-neutral-100 pt-8">
        <h2 class="text-sm font-medium text-neutral-500 mb-3">{t(locale, 'tool.descriptionLabel')}</h2>
        <p class="text-neutral-700 text-base leading-relaxed">{tool.description}</p>
      </div>

      <!-- No-Login Task -->
      <div class="border-l-2 border-green-500 pl-4">
        <h2 class="text-sm font-medium text-neutral-500 mb-1">{t(locale, 'tool.noLoginTask')}</h2>
        <p class="text-neutral-900 font-medium text-base italic">
          "{tool.coreTask}"
        </p>
      </div>

      <!-- Editorial Review & Hands-on Verification (E-E-A-T & GEO) -->
      {editorial && (
        <section class="border-t border-neutral-100 pt-8 space-y-6" aria-labelledby="editorial-review-heading">
          <div class="flex items-center justify-between">
            <h2 id="editorial-review-heading" class="text-xs font-bold text-neutral-400 uppercase tracking-wider">
              {t(locale, 'tool.editorial.heading')}
            </h2>
            <span class="text-[10px] uppercase font-mono tracking-widest px-2 py-0.5 border border-green-600 bg-green-50 text-green-800 font-bold">
              Hands-on Verified
            </span>
          </div>

          <!-- Best For Callout -->
          <div class="bg-neutral-50 border border-neutral-200 p-4 sm:p-5">
            <div class="text-xs font-bold font-mono uppercase text-neutral-500 mb-1.5">
              {t(locale, 'tool.editorial.bestFor')}
            </div>
            <p class="text-neutral-900 font-medium text-base leading-relaxed">
              {editorial.bestFor}
            </p>
            {editorial.alternativeTo?.length > 0 && (
              <div class="mt-4 pt-3 border-t border-neutral-200/80 flex flex-wrap items-center gap-2">
                <span class="text-xs text-neutral-500 font-mono">
                  {t(locale, 'tool.editorial.alternatives')}:
                </span>
                {editorial.alternativeTo.map((alt) => {
                  const target = findAlternativeByAlias(alt);
                  return target ? (
                    <a
                      href={getLocalizedPath(`/alternative/${target.slug}`, locale)}
                      class="inline-flex items-center px-2 py-0.5 bg-white border border-neutral-300 hover:border-neutral-900 hover:text-neutral-900 text-xs font-mono font-medium text-neutral-800 shadow-xs transition-colors"
                      title={`View no-login alternatives to ${target.name}`}
                    >
                      {alt} &rarr;
                    </a>
                  ) : (
                    <span class="inline-flex items-center px-2 py-0.5 bg-white border border-neutral-300 text-xs font-mono font-medium text-neutral-800 shadow-xs">
                      {alt}
                    </span>
                  );
                })}
              </div>
            )}
          </div>

          <!-- Pros & Cons Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Pros -->
            <div class="bg-white border border-neutral-200 p-4 sm:p-5">
              <h3 class="text-xs font-bold font-mono uppercase text-green-700 mb-3 flex items-center gap-1.5">
                <span class="w-4 h-4 rounded-full bg-green-100 text-green-800 flex items-center justify-center text-xs font-bold">+</span>
                {t(locale, 'tool.editorial.pros')}
              </h3>
              <ul class="space-y-2.5">
                {editorial.pros.map((pro) => (
                  <li class="flex items-start gap-2 text-sm text-neutral-700 leading-relaxed">
                    <span class="text-green-600 font-bold select-none shrink-0 mt-0.5">✓</span>
                    <span>{pro}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Cons -->
            <div class="bg-white border border-neutral-200 p-4 sm:p-5">
              <h3 class="text-xs font-bold font-mono uppercase text-neutral-600 mb-3 flex items-center gap-1.5">
                <span class="w-4 h-4 rounded-full bg-neutral-100 text-neutral-700 flex items-center justify-center text-xs font-bold">&minus;</span>
                {t(locale, 'tool.editorial.cons')}
              </h3>
              <ul class="space-y-2.5">
                {editorial.cons.map((con) => (
                  <li class="flex items-start gap-2 text-sm text-neutral-600 leading-relaxed">
                    <span class="text-neutral-400 font-bold select-none shrink-0 mt-0.5">&minus;</span>
                    <span>{con}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )}

      <!-- Deep Privacy & Sandbox Audit Scorecard -->
      <section class="border-t border-neutral-200 pt-8 space-y-6" aria-labelledby="scorecard-heading">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <h2 id="scorecard-heading" class="text-xs font-bold text-neutral-500 uppercase tracking-wider">
              {t(locale, 'tool.scorecard.heading')}
            </h2>
          </div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-neutral-100 border border-neutral-200 text-[11px] font-mono font-bold text-neutral-700">
            <span>🛡️</span>
            <span>{t(locale, 'tool.scorecard.auditStatement')}</span>
          </div>
        </div>

        {/* Hero Grade & Overall Index Card */}
        <div class="bg-white border-2 border-neutral-900 rounded-2xl p-5 sm:p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-5 border-b border-neutral-200">
            <div class="flex items-center gap-4">
              <div class={`w-16 h-16 rounded-xl flex items-center justify-center font-extrabold text-3xl font-mono shadow-xs ${
                scorecard.overallGrade === 'A+' ? 'bg-emerald-500 text-white border-2 border-emerald-700' :
                scorecard.overallGrade === 'A' ? 'bg-emerald-100 text-emerald-900 border-2 border-emerald-400' :
                scorecard.overallGrade === 'B+' ? 'bg-sky-100 text-sky-900 border-2 border-sky-400' :
                'bg-neutral-100 text-neutral-800 border-2 border-neutral-300'
              }`}>
                {scorecard.overallGrade}
              </div>
              <div>
                <div class="text-[11px] uppercase font-mono font-bold text-neutral-500 tracking-wider">
                  {t(locale, 'tool.scorecard.overallGrade')}
                </div>
                <div class="text-base sm:text-lg font-bold text-neutral-900">
                  {scorecard.overallGrade === 'A+' ? 'Gold Standard: Zero Account & Full Local Sandbox' :
                   scorecard.overallGrade === 'A' ? 'High-Assurance Privacy Architecture' :
                   scorecard.overallGrade === 'B+' ? 'Verified No-Login with Cloud API' :
                   'Functional No-Login Standard'}
                </div>
              </div>
            </div>

            <div class="flex sm:flex-col items-baseline sm:items-end justify-between gap-1 border-t sm:border-t-0 pt-3 sm:pt-0 border-neutral-100">
              <span class="text-xs font-mono font-bold text-neutral-500 uppercase">
                {t(locale, 'tool.scorecard.score')}
              </span>
              <div class="flex items-baseline gap-1">
                <span class="text-3xl font-black font-mono text-neutral-900">{scorecard.overallScore}</span>
                <span class="text-xs font-mono text-neutral-400">/ 100</span>
              </div>
            </div>
          </div>

          <p class="mt-4 text-sm text-neutral-700 leading-relaxed font-medium">
            {scorecard.summary}
          </p>
