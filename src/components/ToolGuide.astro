---
import { getToolGuide } from '../lib/tool-guides';
import type { Locale } from '../i18n/config';

interface Props { slug: string; locale: Locale }
const { slug, locale } = Astro.props;
const guide = getToolGuide(slug, locale);
const zh = locale === 'zh';
---

{guide && (
  <section id="tested-workflow" class="border-t border-neutral-200 pt-8 space-y-5 scroll-mt-6" aria-labelledby="tested-workflow-heading">
    <div class="space-y-2">
      <p class="text-xs font-mono text-neutral-500">
        {zh ? '实测日期' : 'Tested'} <time datetime={guide.testedAt}>{guide.testedAt}</time>
      </p>
      <h2 id="tested-workflow-heading" class="text-xl font-bold text-neutral-900">{guide.title}</h2>
      <p class="text-neutral-700 leading-relaxed">{guide.summary}</p>
    </div>
    <div class="border-l-2 border-neutral-900 pl-4">
      <h3 class="text-sm font-semibold mb-2">{zh ? '测试输入' : 'Test input'}</h3>
      <pre class="whitespace-pre-wrap break-words text-sm text-neutral-700 font-mono">{guide.input}</pre>
    </div>
    <ol class="list-decimal pl-5 space-y-3 text-neutral-700 leading-relaxed">
      {guide.steps.map(step => <li>{step}</li>)}
    </ol>
    <div class="bg-neutral-50 border border-neutral-200 p-4 space-y-2">
      <h3 class="font-semibold">{zh ? '观察到的结果' : 'Observed result'}</h3>
      <p class="text-neutral-700 leading-relaxed">{guide.result}</p>
      {guide.artifact && <a class="text-sm underline underline-offset-4" href={guide.artifact.href} download>{guide.artifact.label}</a>}
    </div>
    {guide.screenshot && (
      <figure>
        <a href={guide.screenshot.src} aria-label={zh ? '查看完整测试截图' : 'View full test screenshot'}>
          <img src={guide.screenshot.src} alt={guide.screenshot.alt} width={guide.screenshot.width} height={guide.screenshot.height} loading="lazy" decoding="async" class="w-full h-auto border border-neutral-200" />
        </a>
        <figcaption class="mt-2 text-xs text-neutral-500">{guide.screenshot.alt}</figcaption>
      </figure>
    )}
    <p class="text-sm text-neutral-600 leading-relaxed"><strong>{zh ? '适用边界：' : 'Limits: '}</strong>{guide.limitations}</p>
    {guide.sources?.length && (
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {guide.sources.map(source => <li><a class="underline underline-offset-4" href={source.href}>{source.label}</a></li>)}
      </ul>
    )}
  </section>
)}
