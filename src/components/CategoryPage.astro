---
import Layout from '../layouts/Layout.astro';
import { TAG_DEFINITIONS, categoryToSlug } from '../lib/tags';
import { getApprovedTools, getToolHealthStatus, computeScore as computeToolScore, getLocalizedDescription, getCategoryEditorial } from '../data/loader';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
  category: string;
}

const { locale, category } = Astro.props;
await loadTranslations(locale);

const editorial = getCategoryEditorial(category, locale);

const approvedTools = getApprovedTools();

const categoryTools = approvedTools
  .filter((tool) => tool.tags.some((tag) => tag.tagKey === 'category' && tag.tagValue === category))
  .map((tool) => {
    const health = getToolHealthStatus(tool);
    const score = computeToolScore(tool, health);
    return { ...tool, health, score };
  })
  .sort((a, b) => b.score - a.score);

const categoryDef = TAG_DEFINITIONS.find((d) => d.key === 'category');
const allCategories = categoryDef ? categoryDef.values : [];

function getHostname(url: string): string {
  try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return ''; }
}

function translateCategory(cat: string): string {
  const key = `tag.category.${cat}`;
  const translated = t(locale, key);
  return translated === key ? cat : translated;
}

const translatedCategory = translateCategory(category);
const pageTitle = t(locale, 'category.page.title', { category: translatedCategory });
const pageDescription = t(locale, 'category.page.description', { category: translatedCategory });

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: editorial?.overview ? `${editorial.overview.slice(0, 160)}...` : pageDescription,
  url: `https://nologin.tools${getLocalizedPath(`/category/${categoryToSlug(category)}`, locale)}`,
  inLanguage: locale,
  ...(editorial ? {
    about: {
      '@type': 'Thing',
      name: translatedCategory,
      description: editorial.overview,
    },
  } : {}),

  mainEntity: {
    '@type': 'ItemList',
    name: t(locale, 'category.page.heading', { category: translatedCategory }),
    numberOfItems: categoryTools.length,
    itemListElement: categoryTools.map((tool, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: tool.name,
      url: `https://nologin.tools${getLocalizedPath(`/tool/${tool.slug}`, locale)}`,
    })),
  },
};

const faqQuestions = [
  { q: t(locale, 'category.faq.q1', { category: translatedCategory }), a: t(locale, 'category.faq.a1', { category: translatedCategory, count: categoryTools.length }) },
  { q: t(locale, 'category.faq.q2', { category: translatedCategory }), a: t(locale, 'category.faq.a2', { category: translatedCategory }) },
  { q: t(locale, 'category.faq.q3', { category: translatedCategory }), a: t(locale, 'category.faq.a3', { category: translatedCategory }) },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: locale,
  mainEntity: faqQuestions.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(locale, 'common.home'), item: `https://nologin.tools${getLocalizedPath('/', locale)}` },
    { '@type': 'ListItem', position: 2, name: t(locale, 'category.page.heading', { category: translatedCategory }), item: `https://nologin.tools${getLocalizedPath(`/category/${categoryToSlug(category)}`, locale)}` },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-2 text-sm font-bold text-neutral-400">
        <li>
          <a href={getLocalizedPath('/', locale)} class="hover:text-neutral-900 transition-colors">{t(locale, 'common.home')}</a>
        </li>
        <li aria-hidden="true">
          <svg class="w-4 h-4 text-neutral-300" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
        </li>
        <li aria-current="page" class="text-neutral-900">
          {t(locale, 'category.page.heading', { category: translatedCategory })}
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-12 border-b-4 border-neutral-900 pb-6">
      <h1 class="text-3xl sm:text-4xl font-black text-neutral-900 tracking-tight uppercase italic">
        {t(locale, 'category.page.heading', { category: translatedCategory })}
      </h1>
      <p class="mt-2 text-sm text-neutral-500 font-bold uppercase tracking-wider">
        {t(locale, 'category.page.toolCount', { count: categoryTools.length })}
      </p>
    </header>

    <!-- Category Navigation -->
    <nav class="mb-12 text-sm text-retro-mono" aria-label="Category navigation">
      <div class="flex flex-wrap gap-x-3 gap-y-2">
        {allCategories.map((cat) => (
          <a
            href={getLocalizedPath(`/category/${categoryToSlug(cat)}`, locale)}
            aria-current={cat === category ? 'page' : undefined}
            class:list={[
              'px-2 py-1 border uppercase font-bold transition-all',
              cat === category
                ? 'border-neutral-900 bg-neutral-900 text-white'
                : 'border-neutral-200 hover:border-neutral-900 hover:bg-neutral-900 hover:text-white',
            ]}
          >
            {translateCategory(cat)}
          </a>
        ))}
      </div>
    </nav>

    <!-- Editorial Guide & Selection Matrix (E-E-A-T) -->
    {editorial && (
      <section class="mb-12 border-2 border-neutral-900 bg-neutral-50 p-6 sm:p-8 space-y-6" aria-labelledby="category-guide-heading">
        <div class="flex items-center justify-between border-b border-neutral-200 pb-3">
          <h2 id="category-guide-heading" class="text-xs font-bold text-neutral-500 uppercase tracking-widest font-mono">
            {t(locale, 'category.editorial.heading')}
          </h2>
          <span class="text-[10px] uppercase font-mono tracking-widest px-2 py-0.5 border border-neutral-900 bg-white font-bold">
            Curated Analysis
          </span>
        </div>

        <div>
          <h3 class="text-xl font-bold text-neutral-900 mb-2">
            {editorial.title}
          </h3>
          <p class="text-neutral-700 text-sm sm:text-base leading-relaxed">
            {editorial.overview}
          </p>
        </div>

        <!-- Architecture & Privacy -->
        <div class="bg-white border border-neutral-200 p-4 sm:p-5">
          <h4 class="text-xs font-bold font-mono uppercase text-neutral-500 mb-1.5">
            {t(locale, 'category.editorial.architecture')}
          </h4>
          <p class="text-neutral-700 text-sm leading-relaxed">
            {editorial.architectureInsights}
          </p>
        </div>

        <!-- Tradeoffs Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-white border border-neutral-200 p-4">
            <h4 class="text-xs font-bold font-mono uppercase text-green-700 mb-1.5 flex items-center gap-1.5">
              <span class="w-3.5 h-3.5 rounded-full bg-green-100 text-green-800 flex items-center justify-center text-[10px] font-bold">+</span>
              {t(locale, 'category.editorial.gain')}
            </h4>
            <p class="text-neutral-700 text-xs sm:text-sm leading-relaxed">
              {editorial.tradeoffs.gain}
            </p>
          </div>
          <div class="bg-white border border-neutral-200 p-4">
            <h4 class="text-xs font-bold font-mono uppercase text-neutral-600 mb-1.5 flex items-center gap-1.5">
              <span class="w-3.5 h-3.5 rounded-full bg-neutral-100 text-neutral-700 flex items-center justify-center text-[10px] font-bold">&minus;</span>
              {t(locale, 'category.editorial.sacrifice')}
            </h4>
            <p class="text-neutral-600 text-xs sm:text-sm leading-relaxed">
              {editorial.tradeoffs.sacrifice}
            </p>
          </div>
        </div>

        <!-- Recommended Workflow -->
        {editorial.recommendedWorkflow && (
          <div class="border-t border-neutral-200/80 pt-4 flex flex-col sm:flex-row sm:items-baseline gap-2">
            <span class="text-xs font-bold font-mono uppercase text-neutral-500 shrink-0">
              {t(locale, 'category.editorial.workflow')}:
            </span>
            <p class="text-neutral-800 text-xs sm:text-sm font-medium leading-relaxed">
              {editorial.recommendedWorkflow}
            </p>
          </div>
        )}
      </section>
    )}

    <!-- Tool List -->
    <ul>
      {categoryTools.map((tool) => {
        const hostname = getHostname(tool.url);
        return (
          <li class="tool-item group">
            <div class="flex items-start gap-3 min-w-0 flex-1">
              <img
                src={`https://www.google.com/s2/favicons?domain=${hostname}&sz=32`}
                alt={tool.name}
                width="16"
                height="16"
                class="w-4 h-4 mt-1.5 shrink-0 grayscale group-hover:grayscale-0 transition-all"
                loading="lazy"
                onerror={`this.style.display='none'`}
              />
              <div class="min-w-0 flex flex-col flex-1">
                <div class="flex items-center gap-2 min-w-0">
                  {tool.isFeatured && (
                    <span class="text-yellow-600 shrink-0 text-xs" title={t(locale, 'common.featured')}>★</span>
                  )}
                  <a
                    href={getLocalizedPath(`/tool/${tool.slug}`, locale)}
                    class="font-bold text-lg text-neutral-900 hover:underline decoration-2 underline-offset-4"
                  >
                    {tool.name}
                  </a>
                  <a
                    href={tool.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-neutral-400 hover:text-neutral-600 text-xs font-mono transition-colors hidden sm:inline"
                  >
                    ({hostname})
                  </a>
                </div>
                {getLocalizedDescription(tool, locale) && (
                  <p class="text-neutral-600 text-sm">
                    {getLocalizedDescription(tool, locale)}
                  </p>
                )}
              </div>
            </div>
          </li>
        );
      })}
    </ul>

    <!-- FAQ -->
    <section class="mt-16 border-t border-neutral-200 pt-8">
      <h2 class="text-lg font-bold text-neutral-900 mb-6 uppercase">{t(locale, 'category.faq.heading')}</h2>
      <dl class="space-y-4">
        {faqQuestions.map((faq) => (
          <div>
            <dt class="text-sm font-bold text-neutral-700">{faq.q}</dt>
            <dd class="mt-1 text-sm text-neutral-500">{faq.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Browse All -->
    <div class="mt-12 pt-8 border-t border-neutral-200">
      <a
        href={getLocalizedPath('/', locale)}
        class="text-sm font-bold uppercase tracking-wider text-neutral-500 hover:text-neutral-900 hover:underline decoration-2 underline-offset-4"
      >
        ← {t(locale, 'category.page.browseAll')}
      </a>
    </div>
  </div>
</Layout>
