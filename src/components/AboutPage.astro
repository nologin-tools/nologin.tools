---
import Layout from '../layouts/Layout.astro';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
await loadTranslations(locale);
const aboutModifiedDate = '2026-03-20T00:00:00.000Z';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'nologin.tools',
  url: 'https://nologin.tools',
  description: 'Curated directory of verified privacy-friendly web tools that work without login or accounts.',
  inLanguage: locale,
  publisher: {
    '@type': 'Organization',
    name: 'NoLoginTools.org',
    url: 'https://nologintools.org',
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: `https://nologin.tools${getLocalizedPath('/finder', locale)}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://nologin.tools/#organization',
  name: 'NoLoginTools.org',
  url: 'https://nologintools.org',
  logo: {
    '@type': 'ImageObject',
    url: 'https://nologin.tools/og-default.png',
    width: 1200,
    height: 630,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hello@nologin.tools',
    contactType: 'editorial and privacy inquiries',
  },
  description: t(locale, 'home.jsonLd.orgDescription'),
  foundingDate: '2025',
  sameAs: [
    'https://x.com/nologin_tools',
    'https://github.com/nologin-tools',
  ],
  knowsAbout: [
    'Privacy Tools',
    'No-Login Web Software',
    'Client-Side Computing',
    'Open Source Software',
  ],
};
---

<Layout
  title={t(locale, 'about.title')}
  description={t(locale, 'about.description')}
  locale={locale}
  modifiedTime={aboutModifiedDate}
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'common.home'), item: `https://nologin.tools${getLocalizedPath('/', locale)}` },
      { '@type': 'ListItem', position: 2, name: t(locale, 'about.heading'), item: `https://nologin.tools${getLocalizedPath('/about', locale)}` },
    ],
  })} />

  <div class="max-w-4xl mx-auto px-6 py-16 sm:py-24">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-2 text-xs font-mono font-bold text-neutral-500">
        <li>
          <a href={getLocalizedPath('/', locale)} class="hover:text-neutral-900 transition-colors">{t(locale, 'common.home')}</a>
        </li>
        <li aria-hidden="true">
          <svg class="w-3.5 h-3.5 text-neutral-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
        </li>
        <li aria-current="page" class="text-neutral-900 font-bold">{t(locale, 'about.heading')}</li>
      </ol>
    </nav>

    <div class="mb-12 border-b-2 border-neutral-900 pb-8">
      <h1 class="text-3xl font-black tracking-tight text-neutral-900 mb-3">{t(locale, 'about.heading')}</h1>
      <p class="text-base text-neutral-700 max-w-2xl leading-relaxed">
        {t(locale, 'about.intro')}
      </p>
      <p class="text-xs font-mono font-bold text-neutral-500 mt-3">
        {t(locale, 'about.openInitiative')} <a href="https://nologintools.org" target="_blank" rel="noopener noreferrer" class="text-neutral-900 underline hover:text-emerald-700 transition-colors">NoLoginTools.org</a>
      </p>
    </div>

    <section class="border-b-2 border-neutral-900 pb-8 mb-8">
      <h2 class="text-xl font-bold font-mono text-neutral-900 mb-4 uppercase tracking-wide">{t(locale, 'about.missionTitle')}</h2>
      <div class="text-base text-neutral-700 leading-relaxed space-y-3">
        <p>{t(locale, 'about.missionP1')}</p>
        <p class="font-bold text-neutral-900">{t(locale, 'about.missionP2')}</p>
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-b-2 border-neutral-900 pb-8 mb-8">
      <section class="border-2 border-neutral-900 bg-white p-6 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <h2 class="text-lg font-bold font-mono text-neutral-900 mb-4 uppercase tracking-wide">{t(locale, 'about.verificationTitle')}</h2>
        <ul class="space-y-3">
          {[
            t(locale, 'about.verification1'),
            t(locale, 'about.verification2'),
            t(locale, 'about.verification3'),
            t(locale, 'about.verification4'),
          ].map(item => (
            <li class="flex items-start gap-2 text-neutral-700 text-sm">
              <span class="text-emerald-700 font-mono font-bold shrink-0">[✓]</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="border-2 border-neutral-900 bg-white p-6 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <h2 class="text-lg font-bold font-mono text-neutral-900 mb-4 uppercase tracking-wide">{t(locale, 'about.badgeTitle')}</h2>
        <p class="text-sm text-neutral-700 leading-relaxed mb-4">
          {t(locale, 'about.badgeDesc')}
        </p>
        <div class="flex items-center justify-center p-4 border-2 border-neutral-900 bg-neutral-50 mb-4 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
           <img src="/badges/for-the-badge.svg" alt="NoLogin Verified" class="h-8" />
        </div>
        <a href={getLocalizedPath('/badge', locale)} class="btn-retro text-xs font-mono font-bold uppercase">{t(locale, 'about.badgeLearnMore')} &rarr;</a>
      </section>
    </div>

    <!-- Hands-on Verification Methodology -->
    <section class="border-b-2 border-neutral-900 pb-8 mb-8">
      <h2 class="text-xl font-bold font-mono text-neutral-900 mb-2 uppercase tracking-wide">{t(locale, 'about.methodologyTitle')}</h2>
      <p class="text-sm text-neutral-700 leading-relaxed mb-6">
        {t(locale, 'about.methodologyIntro')}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { step: '01', text: t(locale, 'about.methodologyPoint1') },
          { step: '02', text: t(locale, 'about.methodologyPoint2') },
          { step: '03', text: t(locale, 'about.methodologyPoint3') },
          { step: '04', text: t(locale, 'about.methodologyPoint4') },
        ].map((item) => {
          const match = item.text.match(/^(.*?)(?:: |：)(.*)$/);
          const label = match ? match[1] : item.text;
          const desc = match ? match[2] : '';
          return (
            <div class="border-2 border-neutral-900 bg-white p-4 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
              <div class="text-xs font-mono font-bold text-neutral-500 mb-1">METHODOLOGY #{item.step}</div>
              <h3 class="text-sm font-bold text-neutral-900 mb-1">{label}</h3>
              {desc ? (
                <p class="text-xs text-neutral-600 leading-relaxed">{desc}</p>
              ) : null}
            </div>
          );
        })}
      </div>
    </section>

    <section class="pb-8">
      <p class="text-base text-neutral-600 leading-relaxed">
        {t(locale, 'about.outroP1')} <a href="https://nologintools.org" target="_blank" rel="noopener noreferrer" class="text-green-600 hover:text-green-700 transition-colors font-semibold">NoLoginTools.org</a>. {t(locale, 'about.outroP2')}
        <a href="https://github.com/nologin-tools" target="_blank" rel="noopener noreferrer" class="btn-minimal">{t(locale, 'about.exploreGithub')}</a> · <a href={getLocalizedPath('/submit', locale)} class="btn-minimal">{t(locale, 'about.submitTool')}</a>
      </p>
    </section>
  </div>
</Layout>
