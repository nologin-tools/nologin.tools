---
import Layout from '../layouts/Layout.astro';
import {
  getWorkflowBySlug,
  getWorkflowRecipes,
  resolveWorkflowDetails,
} from '../lib/workflows';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
await loadTranslations(locale);

const rawRecipe = getWorkflowBySlug(slug);
if (!rawRecipe) {
  throw new Error(`Workflow recipe not found for slug: ${slug}`);
}

const recipe = resolveWorkflowDetails(rawRecipe, locale);
const allRecipes = getWorkflowRecipes().filter((w) => w.slug !== slug);

function getHostname(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
}

const pageTitle = t(locale, 'workflow.page.title', { title: recipe.title });
const pageDescription = t(locale, 'workflow.page.description', { headline: recipe.headline });
const canonicalPath = getLocalizedPath(`/workflow/${slug}`, locale);

const workflowDate = '2026-03-20T00:00:00.000Z';

// Schema.org WebSite
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'nologin.tools',
  url: 'https://nologin.tools',
  description: 'Curated directory of verified privacy-friendly web tools that work without login or accounts.',
  inLanguage: locale,
  publisher: {
    '@type': 'Organization',
    name: 'NoLoginTools.org',
    url: 'https://nologintools.org',
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: `https://nologin.tools${getLocalizedPath('/finder', locale)}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

// Schema.org Organization
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'NoLoginTools.org',
  url: 'https://nologintools.org',
  logo: 'https://nologin.tools/icon-192.png',
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hello@nologin.tools',
    contactType: 'editorial and privacy inquiries',
  },
  sameAs: [
    'https://github.com/nologin-tools',
  ],
};

// Schema.org HowTo structured data
const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: recipe.title,
  description: recipe.headline,
  totalTime: `PT${parseInt(recipe.timeEstimate, 10) || 15}M`,
  datePublished: '2026-01-15T00:00:00.000Z',
  dateModified: workflowDate,
  inLanguage: locale,
  publisher: {
    '@type': 'Organization',
    name: 'NoLoginTools.org',
    url: 'https://nologintools.org',
  },
  tool: recipe.steps.map((s) => ({
    '@type': 'HowToTool',
    name: s.toolName,
    url: s.toolUrl,
  })),
  step: recipe.steps.map((s) => ({
    '@type': 'HowToStep',
    position: s.stepNumber,
    name: s.actionTitle,
    text: s.actionDescription,
    url: `https://nologin.tools${getLocalizedPath(`/tool/${s.toolSlug}`, locale)}`,
  })),
};

// Schema.org FAQPage structured data
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: locale,
  mainEntity: recipe.faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};

// Schema.org Breadcrumbs
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(locale, 'common.home'),
      item: `https://nologin.tools${getLocalizedPath('/', locale)}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: recipe.title,
      item: `https://nologin.tools${canonicalPath}`,
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  modifiedTime={workflowDate}
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <div class="max-w-5xl mx-auto px-4 py-8 sm:py-12">
    {/* Breadcrumb Navigation */}
    <nav class="flex items-center gap-2 text-xs font-mono font-bold text-neutral-500 mb-8 overflow-x-auto whitespace-nowrap" aria-label="Breadcrumb">
      <a href={getLocalizedPath('/', locale)} class="hover:text-neutral-900 transition-colors">
        {t(locale, 'common.home')}
      </a>
      <span>/</span>
      <span class="text-neutral-400">Workflows</span>
      <span>/</span>
      <span class="text-neutral-900 font-medium truncate max-w-[240px]">{recipe.title}</span>
    </nav>

    {/* Hero Section */}
    <header class="mb-12">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 text-xs font-mono font-bold bg-emerald-100 text-emerald-950 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] mb-4">
        <span>⚡</span>
        <span>{t(locale, 'workflow.page.badge')}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight mb-4">
        {recipe.title}
      </h1>

      <p class="text-base sm:text-lg text-neutral-700 leading-relaxed mb-6 max-w-3xl">
        {recipe.headline}
      </p>

      {/* Meta Chips */}
      <div class="flex flex-wrap items-center gap-3 text-xs mb-8">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 border-2 border-neutral-900 bg-white shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] text-neutral-900 font-mono font-bold">
          <span>⏱️</span>
          <span>{t(locale, 'workflow.page.timeEstimate', { time: recipe.timeEstimate })}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 border-2 border-neutral-900 bg-white shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] text-neutral-900 font-mono font-bold">
          <span>🎯</span>
          <span>{t(locale, 'workflow.page.difficulty', { level: recipe.difficulty })}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 border-2 border-neutral-900 bg-white shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] text-neutral-900 font-mono font-bold">
          <span>📁</span>
          <span>{recipe.category}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 border-2 border-neutral-900 bg-emerald-100 text-emerald-950 font-mono font-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
          <span>✓</span>
          <span>{recipe.steps.length} Chained Tools (100% Free Without Login)</span>
        </span>
      </div>

      {/* Privacy Guarantee Banner */}
      <div class="bg-emerald-50 border-2 border-neutral-900 p-5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-none border-2 border-neutral-900 bg-emerald-200 text-neutral-900 flex items-center justify-center shrink-0 text-base shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
            🛡️
          </div>
          <div>
            <div class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-900 mb-1">
              {t(locale, 'workflow.page.privacyGuarantee')}
            </div>
            <p class="text-sm text-neutral-800 font-mono font-medium leading-relaxed">
              {recipe.privacyGuarantee}
            </p>
          </div>
        </div>
      </div>
    </header>

    {/* Pipeline Topology Flowbar */}
    <section class="mb-14" aria-label={t(locale, 'workflow.page.pipelineHeading')}>
      <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-neutral-500 mb-4 flex items-center gap-2">
        <span>🔗</span>
        <span>{t(locale, 'workflow.page.pipelineHeading')}</span>
      </h2>

      <div class="bg-neutral-50 border-2 border-neutral-900 p-4 sm:p-6 overflow-x-auto shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <div class="flex items-center min-w-max gap-3 sm:gap-4">
          {recipe.steps.map((step, idx) => (
            <div class="flex items-center gap-3 sm:gap-4">
              <div class="bg-white border-2 border-neutral-900 p-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] flex items-center gap-3">
                <div class="w-6 h-6 rounded-none bg-neutral-900 text-white text-xs font-mono font-bold flex items-center justify-center shrink-0">
                  {step.stepNumber}
                </div>
                <div>
                  <div class="text-xs font-bold text-neutral-900 flex items-center gap-1.5">
                    <img
                      src={`https://www.google.com/s2/favicons?domain=${getHostname(step.toolUrl)}&sz=32`}
                      alt={`${step.toolName} icon`}
                      width="16"
                      height="16"
                      class="w-4 h-4 rounded-none shrink-0"
                      loading="lazy"
                    />
                    <span>{step.toolName}</span>
                  </div>
                  <div class="text-[11px] font-mono text-neutral-500 truncate max-w-[140px]">
                    {step.actionTitle}
                  </div>
                </div>
              </div>

              {idx < recipe.steps.length - 1 && (
                <div class="text-neutral-900 text-lg font-mono font-bold select-none px-1">
                  &rarr;
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Step-by-Step Interactive Cards */}
    <section class="mb-16">
      <div class="space-y-8">
        {recipe.steps.map((step) => (
          <article class="bg-white border-2 border-neutral-900 p-6 sm:p-8 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] relative">
            {/* Step Header */}
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b-2 border-neutral-900">
              <div class="flex items-center gap-4">
                <div class="w-9 h-9 rounded-none border-2 border-neutral-900 bg-emerald-600 text-white font-mono font-black text-sm flex items-center justify-center shrink-0 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                  {step.stepNumber}
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-800">
                      {t(locale, 'workflow.page.stepLabel', { number: step.stepNumber })}
                    </span>
                    {step.toolCategory && (
                      <span class="text-[11px] font-mono px-2 py-0.5 border border-neutral-900 bg-neutral-100 text-neutral-800 font-bold">
                        {step.toolCategory}
                      </span>
                    )}
                    {step.toolHealth && (
                      <span class={`text-[11px] font-mono px-2 py-0.5 border border-neutral-900 font-bold ${
                        step.toolHealth.status === 'online'
                          ? 'bg-emerald-100 text-emerald-900'
                          : 'bg-amber-100 text-amber-900'
                      }`}>
                        {step.toolHealth.status === 'online' ? '✓ Online' : '⚠ Unstable'}
                      </span>
                    )}
                  </div>
                  <h3 class="text-xl font-bold text-neutral-900 tracking-tight">
                    {step.actionTitle}
                  </h3>
                </div>
              </div>

              {/* Direct Launch Button */}
              <div class="shrink-0">
                <a
                  href={step.toolUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-mono font-bold border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] transition-none group"
                >
                  <img
                    src={`https://www.google.com/s2/favicons?domain=${getHostname(step.toolUrl)}&sz=32`}
                    alt={`${step.toolName} icon`}
                    width="16"
                    height="16"
                    class="w-4 h-4 rounded-none shrink-0"
                    loading="lazy"
                  />
                  <span>{t(locale, 'workflow.page.launchTool', { tool: step.toolName })}</span>
                  <span class="group-hover:translate-x-0.5 transition-transform">&nearr;</span>
                </a>
              </div>
            </div>

            {/* Input / Output Specs */}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 my-6">
              <div class="bg-neutral-50 border-2 border-neutral-900 p-3.5 flex items-start gap-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                <span class="text-xs font-mono font-bold uppercase tracking-wider px-1.5 py-0.5 border border-neutral-900 bg-neutral-200 text-neutral-900 shrink-0">
                  {t(locale, 'workflow.page.inputLabel')}
                </span>
                <span class="text-xs text-neutral-800 font-mono leading-tight pt-0.5">
                  {step.inputFormat}
                </span>
              </div>
              <div class="bg-emerald-50 border-2 border-neutral-900 p-3.5 flex items-start gap-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                <span class="text-xs font-mono font-bold uppercase tracking-wider px-1.5 py-0.5 border border-neutral-900 bg-emerald-300 text-emerald-950 shrink-0">
                  {t(locale, 'workflow.page.outputLabel')}
                </span>
                <span class="text-xs text-emerald-950 font-mono font-bold leading-tight pt-0.5">
                  {step.outputFormat}
                </span>
              </div>
            </div>

            {/* Action Description */}
            <div class="text-sm text-neutral-800 leading-relaxed space-y-3 mb-6">
              <p>{step.actionDescription}</p>
            </div>

            {/* Pro Tip Box */}
            <div class="bg-amber-50 border-2 border-neutral-900 p-4 mb-6 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] font-mono">
              <div class="flex items-start gap-3">
                <span class="text-base select-none">💡</span>
                <div class="text-xs text-neutral-900 leading-relaxed">
                  <strong class="font-bold text-amber-900">{t(locale, 'workflow.page.proTip')}:</strong> {step.proTip}
                </div>
              </div>
            </div>

            {/* Tool Detail Link */}
            <div class="pt-4 border-t-2 border-neutral-900 flex items-center justify-between text-xs font-mono">
              <span class="text-neutral-600">
                Verified NoLogin Tool: <strong class="text-neutral-900">{step.toolName}</strong> ({getHostname(step.toolUrl)})
              </span>
              <a
                href={getLocalizedPath(`/tool/${step.toolSlug}`, locale)}
                class="font-bold text-neutral-900 hover:text-emerald-700 underline transition-colors inline-flex items-center gap-1"
              >
                <span>{t(locale, 'workflow.page.auditLink', { tool: step.toolName })}</span>
                <span>&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* Why This Stack Beats Cloud SaaS */}
    <section class="mb-16 bg-neutral-900 text-white border-2 border-neutral-900 p-8 sm:p-10 shadow-[5px_5px_0px_0px_rgba(0,0,0,1)]">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 text-xs font-mono font-bold bg-neutral-800 text-emerald-400 border border-neutral-700 mb-4">
          <span>🛡️</span>
          <span>Zero-Account Architecture</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-4 font-mono">
          {t(locale, 'workflow.page.whyHeading')}
        </h2>
        <p class="text-sm sm:text-base text-neutral-300 leading-relaxed mb-6 font-mono">
          {recipe.summary}
        </p>
        <p class="text-sm sm:text-base text-neutral-300 leading-relaxed font-mono">
          {recipe.whyThisStack}
        </p>
      </div>
    </section>

    {/* Frequently Asked Questions */}
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-neutral-900 mb-6 font-mono">
        {t(locale, 'workflow.page.faqHeading')}
      </h2>

      <div class="space-y-4">
        {recipe.faqs.map((faq) => (
          <div class="bg-white border-2 border-neutral-900 p-5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
            <h3 class="text-base font-bold text-neutral-900 mb-2">
              {faq.question}
            </h3>
            <p class="text-sm text-neutral-700 leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

    {/* Explore More Recipes */}
    <section class="mb-12 border-t-2 border-neutral-900 pt-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-neutral-900 font-mono">
          {t(locale, 'workflow.page.exploreOther')}
        </h2>
        <a
          href={getLocalizedPath('/', locale)}
          class="text-xs font-mono font-bold text-neutral-700 hover:text-neutral-900 transition-colors underline"
        >
          {t(locale, 'workflow.page.browseAll')} &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {allRecipes.map((other) => (
          <a
            href={getLocalizedPath(`/workflow/${other.slug}`, locale)}
            class="p-5 bg-white border-2 border-neutral-900 hover:bg-yellow-50 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] transition-none group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs text-neutral-500 mb-2 font-mono">
                <span class="font-bold text-neutral-900 bg-neutral-100 border border-neutral-900 px-2 py-0.5">
                  {other.category}
                </span>
                <span>⏱️ {other.timeEstimate}</span>
              </div>
              <h3 class="font-bold text-neutral-900 group-hover:text-emerald-800 transition-colors mb-2 text-sm leading-snug">
                {other.title}
              </h3>
              <p class="text-xs text-neutral-600 line-clamp-2 leading-relaxed mb-4">
                {other.headline}
              </p>
            </div>
            <div class="text-xs font-mono font-bold text-neutral-900 inline-flex items-center gap-1 group-hover:underline">
              <span>View Recipe</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
