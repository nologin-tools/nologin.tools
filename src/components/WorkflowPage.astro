---
import Layout from '../layouts/Layout.astro';
import {
  getWorkflowBySlug,
  getWorkflowRecipes,
  resolveWorkflowDetails,
} from '../lib/workflows';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
await loadTranslations(locale);

const rawRecipe = getWorkflowBySlug(slug);
if (!rawRecipe) {
  throw new Error(`Workflow recipe not found for slug: ${slug}`);
}

const recipe = resolveWorkflowDetails(rawRecipe, locale);
const allRecipes = getWorkflowRecipes().filter((w) => w.slug !== slug);

function getHostname(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
}

const pageTitle = t(locale, 'workflow.page.title', { title: recipe.title });
const pageDescription = t(locale, 'workflow.page.description', { headline: recipe.headline });
const canonicalPath = getLocalizedPath(`/workflow/${slug}`, locale);

// Schema.org HowTo structured data
const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: recipe.title,
  description: recipe.headline,
  totalTime: `PT${parseInt(recipe.timeEstimate, 10) || 15}M`,
  tool: recipe.steps.map((s) => ({
    '@type': 'HowToTool',
    name: s.toolName,
    url: s.toolUrl,
  })),
  step: recipe.steps.map((s) => ({
    '@type': 'HowToStep',
    position: s.stepNumber,
    name: s.actionTitle,
    text: s.actionDescription,
    url: `https://nologin.tools${getLocalizedPath(`/tool/${s.toolSlug}`, locale)}`,
  })),
};

// Schema.org FAQPage structured data
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: locale,
  mainEntity: recipe.faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};

// Schema.org Breadcrumbs
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(locale, 'common.home'),
      item: `https://nologin.tools${getLocalizedPath('/', locale)}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: recipe.title,
      item: `https://nologin.tools${canonicalPath}`,
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(howToLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <div class="max-w-5xl mx-auto px-4 py-8 sm:py-12">
    {/* Breadcrumb Navigation */}
    <nav class="flex items-center gap-2 text-xs text-neutral-500 mb-8 overflow-x-auto whitespace-nowrap" aria-label="Breadcrumb">
      <a href={getLocalizedPath('/', locale)} class="hover:text-neutral-900 transition-colors">
        {t(locale, 'common.home')}
      </a>
      <span>/</span>
      <span class="text-neutral-400">Workflows</span>
      <span>/</span>
      <span class="text-neutral-900 font-medium truncate max-w-[240px]">{recipe.title}</span>
    </nav>

    {/* Hero Section */}
    <header class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 mb-4">
        <span>⚡</span>
        <span>{t(locale, 'workflow.page.badge')}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight mb-4">
        {recipe.title}
      </h1>

      <p class="text-lg text-neutral-600 leading-relaxed mb-6 max-w-3xl">
        {recipe.headline}
      </p>

      {/* Meta Chips */}
      <div class="flex flex-wrap items-center gap-3 text-xs mb-8">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-neutral-100 text-neutral-800 font-medium">
          <span>⏱️</span>
          <span>{t(locale, 'workflow.page.timeEstimate', { time: recipe.timeEstimate })}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-neutral-100 text-neutral-800 font-medium">
          <span>🎯</span>
          <span>{t(locale, 'workflow.page.difficulty', { level: recipe.difficulty })}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-neutral-100 text-neutral-800 font-medium">
          <span>📁</span>
          <span>{recipe.category}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-800 font-medium border border-emerald-100">
          <span>✓</span>
          <span>{recipe.steps.length} Chained Tools (100% Free Without Login)</span>
        </span>
      </div>

      {/* Privacy Guarantee Banner */}
      <div class="bg-gradient-to-r from-emerald-50 via-teal-50/60 to-emerald-50 border border-emerald-200 rounded-2xl p-5 shadow-2xs">
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center shrink-0 text-base shadow-xs">
            🛡️
          </div>
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-emerald-800 mb-1">
              {t(locale, 'workflow.page.privacyGuarantee')}
            </div>
            <p class="text-sm text-emerald-950 font-medium leading-relaxed">
              {recipe.privacyGuarantee}
            </p>
          </div>
        </div>
      </div>
    </header>

    {/* Pipeline Topology Flowbar */}
    <section class="mb-14" aria-label={t(locale, 'workflow.page.pipelineHeading')}>
      <h2 class="text-xs font-bold uppercase tracking-widest text-neutral-500 mb-4 flex items-center gap-2">
        <span>🔗</span>
        <span>{t(locale, 'workflow.page.pipelineHeading')}</span>
      </h2>

      <div class="bg-neutral-50 border border-neutral-200 rounded-2xl p-4 sm:p-6 overflow-x-auto">
        <div class="flex items-center min-w-max gap-3 sm:gap-4">
          {recipe.steps.map((step, idx) => (
            <div class="flex items-center gap-3 sm:gap-4">
              <div class="bg-white border border-neutral-200 hover:border-neutral-400 rounded-xl p-3 shadow-2xs transition-all flex items-center gap-3">
                <div class="w-7 h-7 rounded-full bg-neutral-900 text-white text-xs font-bold flex items-center justify-center shrink-0">
                  {step.stepNumber}
                </div>
                <div>
                  <div class="text-xs font-bold text-neutral-900 flex items-center gap-1.5">
                    <img
                      src={`https://www.google.com/s2/favicons?domain=${getHostname(step.toolUrl)}&sz=32`}
                      alt=""
                      class="w-4 h-4 rounded-xs shrink-0"
                      loading="lazy"
                    />
                    <span>{step.toolName}</span>
                  </div>
                  <div class="text-[11px] text-neutral-500 truncate max-w-[140px]">
                    {step.actionTitle}
                  </div>
                </div>
              </div>

              {idx < recipe.steps.length - 1 && (
                <div class="text-neutral-400 text-lg font-bold select-none px-1">
                  &rarr;
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Step-by-Step Interactive Cards */}
    <section class="mb-16">
      <div class="space-y-8">
        {recipe.steps.map((step) => (
          <article class="bg-white border border-neutral-200 rounded-2xl p-6 sm:p-8 shadow-xs hover:shadow-md transition-shadow relative overflow-hidden">
            {/* Step Header */}
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-neutral-100">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-xl bg-emerald-700 text-white font-black text-sm flex items-center justify-center shrink-0 shadow-xs">
                  {step.stepNumber}
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-xs font-bold uppercase tracking-wider text-emerald-700">
                      {t(locale, 'workflow.page.stepLabel', { number: step.stepNumber })}
                    </span>
                    {step.toolCategory && (
                      <span class="text-[11px] px-2 py-0.5 rounded-md bg-neutral-100 text-neutral-600 font-medium">
                        {step.toolCategory}
                      </span>
                    )}
                    {step.toolHealth && (
                      <span class={`text-[11px] px-2 py-0.5 rounded-md font-medium ${
                        step.toolHealth.status === 'online'
                          ? 'bg-emerald-50 text-emerald-700'
                          : 'bg-amber-50 text-amber-700'
                      }`}>
                        {step.toolHealth.status === 'online' ? '✓ Online' : '⚠ Unstable'}
                      </span>
                    )}
                  </div>
                  <h3 class="text-xl font-bold text-neutral-900 tracking-tight">
                    {step.actionTitle}
                  </h3>
                </div>
              </div>

              {/* Direct Launch Button */}
              <div class="shrink-0">
                <a
                  href={step.toolUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white text-xs font-bold transition-colors shadow-2xs group"
                >
                  <img
                    src={`https://www.google.com/s2/favicons?domain=${getHostname(step.toolUrl)}&sz=32`}
                    alt=""
                    class="w-4 h-4 rounded-xs shrink-0"
                    loading="lazy"
                  />
                  <span>{t(locale, 'workflow.page.launchTool', { tool: step.toolName })}</span>
                  <span class="group-hover:translate-x-0.5 transition-transform">&nearr;</span>
                </a>
              </div>
            </div>

            {/* Input / Output Specs */}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 my-6">
              <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-3.5 flex items-start gap-3">
                <span class="text-xs font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-neutral-200 text-neutral-700 shrink-0">
                  {t(locale, 'workflow.page.inputLabel')}
                </span>
                <span class="text-xs text-neutral-700 font-mono leading-tight pt-0.5">
                  {step.inputFormat}
                </span>
              </div>
              <div class="bg-emerald-50/50 border border-emerald-200 rounded-xl p-3.5 flex items-start gap-3">
                <span class="text-xs font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-emerald-200 text-emerald-800 shrink-0">
                  {t(locale, 'workflow.page.outputLabel')}
                </span>
                <span class="text-xs text-emerald-950 font-mono font-medium leading-tight pt-0.5">
                  {step.outputFormat}
                </span>
              </div>
            </div>

            {/* Action Description */}
            <div class="text-sm text-neutral-700 leading-relaxed space-y-3 mb-6">
              <p>{step.actionDescription}</p>
            </div>

            {/* Pro Tip Box */}
            <div class="bg-amber-50/60 border border-amber-200 rounded-xl p-4 mb-6">
              <div class="flex items-start gap-3">
                <span class="text-base select-none">💡</span>
                <div class="text-xs text-amber-950 leading-relaxed">
                  <strong class="font-bold text-amber-900">{t(locale, 'workflow.page.proTip')}:</strong> {step.proTip}
                </div>
              </div>
            </div>

            {/* Tool Detail Link */}
            <div class="pt-4 border-t border-neutral-100 flex items-center justify-between text-xs">
              <span class="text-neutral-500">
                Verified NoLogin Tool: <strong class="text-neutral-800">{step.toolName}</strong> ({getHostname(step.toolUrl)})
              </span>
              <a
                href={getLocalizedPath(`/tool/${step.toolSlug}`, locale)}
                class="font-bold text-neutral-900 hover:text-emerald-700 transition-colors inline-flex items-center gap-1"
              >
                <span>{t(locale, 'workflow.page.auditLink', { tool: step.toolName })}</span>
                <span>&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* Why This Stack Beats Cloud SaaS */}
    <section class="mb-16 bg-neutral-900 text-white rounded-3xl p-8 sm:p-10 shadow-lg">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-neutral-800 text-emerald-400 border border-neutral-700 mb-4">
          <span>🛡️</span>
          <span>Zero-Account Architecture</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-4">
          {t(locale, 'workflow.page.whyHeading')}
        </h2>
        <p class="text-sm sm:text-base text-neutral-300 leading-relaxed mb-6">
          {recipe.summary}
        </p>
        <p class="text-sm sm:text-base text-neutral-300 leading-relaxed">
          {recipe.whyThisStack}
        </p>
      </div>
    </section>

    {/* Frequently Asked Questions */}
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-neutral-900 mb-6">
        {t(locale, 'workflow.page.faqHeading')}
      </h2>

      <div class="space-y-4">
        {recipe.faqs.map((faq) => (
          <div class="bg-white border border-neutral-200 rounded-xl p-5 shadow-2xs">
            <h3 class="text-base font-bold text-neutral-900 mb-2">
              {faq.question}
            </h3>
            <p class="text-sm text-neutral-600 leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

    {/* Explore More Recipes */}
    <section class="mb-12 border-t border-neutral-200 pt-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-neutral-900">
          {t(locale, 'workflow.page.exploreOther')}
        </h2>
        <a
          href={getLocalizedPath('/', locale)}
          class="text-xs font-bold text-neutral-600 hover:text-neutral-900 transition-colors"
        >
          {t(locale, 'workflow.page.browseAll')} &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {allRecipes.map((other) => (
          <a
            href={getLocalizedPath(`/workflow/${other.slug}`, locale)}
            class="p-5 bg-white border border-neutral-200 hover:border-emerald-600 rounded-2xl shadow-2xs hover:shadow-md transition-all group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs text-neutral-500 mb-2">
                <span class="font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md">
                  {other.category}
                </span>
                <span>⏱️ {other.timeEstimate}</span>
              </div>
              <h3 class="font-bold text-neutral-900 group-hover:text-emerald-700 transition-colors mb-2 text-sm leading-snug">
                {other.title}
              </h3>
              <p class="text-xs text-neutral-600 line-clamp-2 leading-relaxed mb-4">
                {other.headline}
              </p>
            </div>
            <div class="text-[11px] font-bold text-emerald-700 inline-flex items-center gap-1">
              <span>View Recipe</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
