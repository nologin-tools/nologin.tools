---
import Layout from '../layouts/Layout.astro';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
await loadTranslations(locale);
---

<Layout
  title={t(locale, 'submit.title')}
  description={t(locale, 'submit.description')}
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'common.home'), item: `https://nologin.tools${getLocalizedPath('/', locale)}` },
      { '@type': 'ListItem', position: 2, name: t(locale, 'submit.heading'), item: `https://nologin.tools${getLocalizedPath('/submit', locale)}` },
    ],
  })} />

  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-12 sm:py-24">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-2 text-sm font-bold text-neutral-400">
        <li>
          <a href={getLocalizedPath('/', locale)} class="hover:text-neutral-900 transition-colors">{t(locale, 'common.home')}</a>
        </li>
        <li aria-hidden="true">
          <svg class="w-4 h-4 text-neutral-300" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
        </li>
        <li aria-current="page" class="text-neutral-900">{t(locale, 'submit.heading')}</li>
      </ol>
    </nav>

    <div class="text-center mb-10 sm:mb-12">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 mb-3">{t(locale, 'submit.heading')}</h1>
      <p class="text-sm sm:text-base text-neutral-500 max-w-lg mx-auto leading-relaxed">
        {t(locale, 'submit.intro')}
      </p>
    </div>

    <form id="submit-form" class="space-y-6" novalidate>
      <!-- Tool URL -->
      <div>
        <label for="url" class="block text-xs font-mono font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
          {t(locale, 'submit.toolUrl')} <span class="text-red-500">*</span>
        </label>
        <input
          type="url"
          id="url"
          name="url"
          required
          autofocus
          placeholder="https://excalidraw.com"
          class="w-full px-4 py-3 bg-white border-2 border-neutral-900 rounded-none text-base font-mono text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:bg-yellow-50 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-colors"
        />
        <p class="text-xs text-red-600 font-mono mt-1.5 font-bold hidden" data-error="url"></p>
      </div>

      <!-- Submitter Email -->
      <div>
        <label for="submitterEmail" class="block text-xs font-mono font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
          {t(locale, 'submit.emailLabel')}
          <span class="text-xs font-normal text-neutral-500 lowercase">({t(locale, 'common.optional')})</span>
        </label>
        <input
          type="email"
          id="submitterEmail"
          name="submitterEmail"
          maxlength="254"
          placeholder="you@example.com"
          class="w-full px-4 py-2.5 bg-white border-2 border-neutral-900 rounded-none text-sm font-mono text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:bg-yellow-50 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-colors"
        />
        <p class="text-xs font-mono text-neutral-500 mt-1.5">
          {t(locale, 'submit.emailHint')}
        </p>
        <p class="text-xs text-red-600 font-mono mt-1.5 font-bold hidden" data-error="submitterEmail"></p>
      </div>

      <!-- No-Login Commitment Note -->
      <div class="p-3.5 bg-neutral-50 border border-neutral-300 text-xs font-mono text-neutral-600 leading-relaxed">
        <strong>Note:</strong> {t(locale, 'submit.pledge')}
      </div>

      <!-- Error message box -->
      <div
        id="form-error"
        class="hidden p-4 bg-red-100 border-2 border-red-900 rounded-none text-xs font-mono font-bold text-red-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
      ></div>

      <!-- Submit button -->
      <div class="pt-2">
        <button
          type="submit"
          id="submit-btn"
          data-submitting={t(locale, 'submit.submitting')}
          class="btn-primary w-full py-3.5 text-center font-mono font-bold uppercase tracking-wider text-sm shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px]"
        >
          {t(locale, 'submit.submitBtn')}
        </button>
        <p class="text-center text-xs font-mono text-neutral-400 mt-4">
          {t(locale, 'submit.submitDisclaimer')}
        </p>
      </div>
    </form>

    <!-- Verified Badge & Ranking Boost Callout -->
    <div class="p-5 sm:p-6 bg-emerald-50 border-2 border-neutral-900 rounded-none shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] mt-10">
      <div class="flex items-start gap-4">
        <div class="w-8 h-8 rounded-none border-2 border-neutral-900 bg-emerald-300 text-neutral-900 flex items-center justify-center shrink-0 mt-0.5 shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        </div>
        <div class="space-y-2">
          <h3 class="text-sm font-mono font-bold text-neutral-900 uppercase tracking-wide">
            {t(locale, 'submit.incentiveTitle')}
          </h3>
          <p class="text-xs text-neutral-700 leading-relaxed font-mono">
            {t(locale, 'submit.incentiveDesc')}
          </p>
          <div class="pt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs font-mono font-bold text-emerald-900">
            <span class="inline-flex items-center gap-1">
              [✓] {t(locale, 'submit.incentivePerkBoost')}
            </span>
            <span class="inline-flex items-center gap-1">
              [✓] {t(locale, 'submit.incentivePerkFastTrack')}
            </span>
            <span class="inline-flex items-center gap-1">
              [✓] {t(locale, 'submit.incentivePerkCert')}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('submit-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const formError = document.getElementById('form-error')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous errors
      document.querySelectorAll('[data-error]').forEach((el) => {
        el.classList.add('hidden');
        el.parentElement?.querySelector('input')?.classList.remove('!border-red-600', '!bg-red-50');
      });
      formError.classList.add('hidden');

      const formData = new FormData(form);
      const url = (formData.get('url') as string || '').trim();
      const submitterEmail = (formData.get('submitterEmail') as string || '').trim();

      // Client-side validation
      let hasError = false;

      if (!url) {
        showError('url', 'A valid URL is required.');
        hasError = true;
      } else {
        try {
          const parsed = new URL(url);
          if (!['http:', 'https:'].includes(parsed.protocol)) {
            showError('url', 'Please enter a valid HTTP or HTTPS URL.');
            hasError = true;
          }
        } catch {
          showError('url', 'Please enter a complete URL (e.g., https://...).');
          hasError = true;
        }
      }

      if (submitterEmail && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(submitterEmail)) {
        showError('submitterEmail', 'Please enter a valid email address.');
        hasError = true;
      }

      if (hasError) {
        formError.innerHTML = `
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>Please correct the errors highlighted above before submitting.</span>
          </div>
        `;
        formError.classList.remove('hidden');
        return;
      }

      const originalBtnHtml = submitBtn.innerHTML;
      const submittingText = submitBtn.dataset.submitting || 'Verifying & Submitting...';
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        ${submittingText}
      `;

      try {
        const res = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url, submitterEmail }),
        });

        const result = await res.json();

        if (result.ok) {
          window.location.href = `/submit/success?slug=${result.data.slug}`;
        } else {
          if (result.details?.slug) {
            formError.innerHTML = `
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                <span>This tool has already been submitted. <a href="/tool/${result.details.slug}" class="underline font-black hover:text-red-900 transition-colors">View it here &rarr;</a></span>
              </div>
            `;
          } else if (result.details) {
            for (const [field, msg] of Object.entries(result.details)) {
              showError(field, msg as string);
            }
            formError.textContent = result.error || 'Submission failed. Please check your inputs.';
          } else {
            formError.textContent = result.error || 'An unexpected error occurred. Please try again.';
          }
          formError.classList.remove('hidden');
          formError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } catch {
        formError.textContent = 'Network error. Please check your connection and try again.';
        formError.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
      }
    });

    function showError(field: string, message: string) {
      const el = document.querySelector(`[data-error="${field}"]`);
      if (el) {
        el.innerHTML = `
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            ${message}
          </div>
        `;
        el.classList.remove('hidden');

        const input = el.parentElement?.querySelector('input');
        if (input) {
          input.classList.add('!border-red-600', '!bg-red-50');
        }
      }
    }
  </script>
</Layout>
