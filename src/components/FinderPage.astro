---
import Layout from '../layouts/Layout.astro';
import { getFinderTools, type FinderToolItem } from '../lib/finder';
import { TAG_DEFINITIONS } from '../lib/tags';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
await loadTranslations(locale);

const tools = getFinderTools(locale);
const totalToolsCount = tools.length;

const categoryDef = TAG_DEFINITIONS.find((d) => d.key === 'category');
const categories = categoryDef ? categoryDef.values : [];

// Compute tool count per category
const categoryCounts: Record<string, number> = {};
for (const tool of tools) {
  categoryCounts[tool.category] = (categoryCounts[tool.category] || 0) + 1;
}

function translateCategory(cat: string): string {
  const key = `tag.category.${cat}`;
  const translated = t(locale, key);
  return translated === key ? cat : translated;
}

const pageTitle = t(locale, 'finder.title');
const pageDescription = t(locale, 'finder.description');
const canonicalPath = getLocalizedPath('/finder', locale);

const toolDates = tools
  .map((t) => t.approvedAt ? new Date(t.approvedAt).getTime() : 0)
  .filter((d) => !isNaN(d) && d > 0);
const latestToolDate = toolDates.length > 0
  ? new Date(Math.max(...toolDates)).toISOString()
  : new Date().toISOString();

// Schema.org WebPage + SearchAction
const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  url: `https://nologin.tools${canonicalPath}`,
  inLanguage: locale,
  dateModified: latestToolDate,
  potentialAction: {
    '@type': 'SearchAction',
    target: `https://nologin.tools${canonicalPath}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

// Schema.org Breadcrumbs
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(locale, 'common.home'),
      item: `https://nologin.tools${getLocalizedPath('/', locale)}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t(locale, 'nav.finder'),
      item: `https://nologin.tools${canonicalPath}`,
    },
  ],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://nologin.tools/#website',
  name: 'nologin.tools',
  url: 'https://nologin.tools',
  publisher: {
    '@id': 'https://nologin.tools/#organization',
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `https://nologin.tools${canonicalPath}?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://nologin.tools/#organization',
  name: 'NoLoginTools.org',
  url: 'https://nologintools.org',
  logo: {
    '@type': 'ImageObject',
    url: 'https://nologin.tools/og-default.png',
    width: 1200,
    height: 630,
  },
  description: t(locale, 'home.jsonLd.orgDescription'),
  foundingDate: '2025',
  areaServed: 'Worldwide',
  email: 'contact@nologintools.org',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'contact@nologintools.org',
    url: 'https://nologintools.org/about',
  },
  sameAs: [
    'https://x.com/nologin_tools',
    'https://github.com/nologin-tools',
  ],
};

const finderFaqs = [
  {
    q: t(locale, 'finder.faq.q1'),
    a: t(locale, 'finder.faq.a1'),
  },
  {
    q: t(locale, 'finder.faq.q2'),
    a: t(locale, 'finder.faq.a2'),
  },
  {
    q: t(locale, 'finder.faq.q3'),
    a: t(locale, 'finder.faq.a3'),
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: locale,
  mainEntity: finderFaqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: a,
    },
  })),
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  modifiedTime={latestToolDate}
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    {/* Breadcrumb Navigation */}
    <nav class="flex items-center gap-2 text-xs text-neutral-500 mb-8 overflow-x-auto whitespace-nowrap" aria-label="Breadcrumb">
      <a href={getLocalizedPath('/', locale)} class="hover:text-neutral-900 transition-colors">
        {t(locale, 'common.home')}
      </a>
      <span>/</span>
      <span class="text-neutral-900 font-medium">{t(locale, 'nav.finder')}</span>
    </nav>

    {/* Hero Section */}
    <header class="mb-10 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-yellow-300 text-neutral-900 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] text-xs font-mono font-bold uppercase tracking-wider mb-4">
        <span>🧭</span>
        <span>{t(locale, 'finder.hero.badge')}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-neutral-900 tracking-tight uppercase italic mb-3">
        {t(locale, 'finder.hero.heading')}
      </h1>
      <p class="text-sm sm:text-base text-neutral-600 leading-relaxed">
        {t(locale, 'finder.hero.subtitle')}
      </p>
    </header>

    {/* Control Deck */}
    <section class="bg-neutral-50 border-2 border-neutral-900 p-4 sm:p-6 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] mb-8" aria-label="Tool Filters">
      {/* Search Input Box */}
      <form
        role="search"
        action={canonicalPath}
        method="GET"
        onsubmit="event.preventDefault();"
        class="relative mb-6"
        toolname="search-tools"
        tooldescription="Search and filter verified no-login web utilities across categories and tags"
      >
        <label for="finder-search-input" class="sr-only">{t(locale, 'finder.search.placeholder')}</label>
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-neutral-400 select-none text-base" aria-hidden="true">🔍</span>
        <input
          id="finder-search-input"
          name="q"
          type="search"
          aria-label={t(locale, 'finder.search.placeholder')}
          placeholder={t(locale, 'finder.search.placeholder')}
          class="w-full pl-11 pr-10 py-3.5 bg-white border-2 border-neutral-900 text-sm font-mono font-bold text-neutral-900 placeholder:text-neutral-400 focus:outline-hidden transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          id="finder-clear-search-btn"
          type="button"
          class="hidden absolute right-3 top-1/2 -translate-y-1/2 w-6 h-6 bg-neutral-200 hover:bg-neutral-900 hover:text-white border border-neutral-900 text-neutral-900 text-xs font-mono font-bold flex items-center justify-center transition-colors cursor-pointer"
          aria-label="Clear search"
        >
          ✕
        </button>
      </form>

      {/* Category Chips Carousel */}
      <div class="mb-6">
        <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-500 mb-2.5">
          {t(locale, 'tag.category')}
        </div>
        <div id="category-chips-container" class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none whitespace-nowrap">
          <button
            type="button"
            data-cat="all"
            class="cat-chip active px-3 py-1.5 text-xs font-mono font-bold border-2 transition-all cursor-pointer bg-neutral-900 text-white border-neutral-900 uppercase"
          >
            {t(locale, 'finder.category.all')} ({totalToolsCount})
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              data-cat={cat.toLowerCase()}
              class="cat-chip px-3 py-1.5 text-xs font-mono font-bold border-2 transition-all cursor-pointer bg-white text-neutral-800 border-neutral-300 hover:border-neutral-900 uppercase"
            >
              {translateCategory(cat)} ({categoryCounts[cat] || 0})
            </button>
          ))}
        </div>
      </div>

      {/* Execution & Privacy Checkbox Toggles */}
      <div class="border-t border-neutral-200 pt-5 mb-5">
        <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-500 mb-3">
          {t(locale, 'finder.filter.heading')}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
          {/* Client-Side Only */}
          <label class="filter-toggle-card flex items-start gap-3 p-3 bg-white border-2 border-neutral-300 hover:border-neutral-900 cursor-pointer select-none transition-all">
            <input type="checkbox" id="filter-clientside" class="mt-0.5 border-2 border-neutral-900 text-neutral-900 focus:ring-0 w-4 h-4 cursor-pointer" />
            <div>
              <div class="text-xs font-mono font-bold text-neutral-900 flex items-center gap-1.5">
                <span>🛡️</span>
                <span>{t(locale, 'finder.filter.clientSide')}</span>
              </div>
              <div class="text-[11px] text-neutral-500 leading-tight mt-0.5">
                {t(locale, 'finder.filter.clientSideDesc')}
              </div>
            </div>
          </label>

          {/* Works Offline */}
          <label class="filter-toggle-card flex items-start gap-3 p-3 bg-white border-2 border-neutral-300 hover:border-neutral-900 cursor-pointer select-none transition-all">
            <input type="checkbox" id="filter-offline" class="mt-0.5 border-2 border-neutral-900 text-neutral-900 focus:ring-0 w-4 h-4 cursor-pointer" />
            <div>
              <div class="text-xs font-mono font-bold text-neutral-900 flex items-center gap-1.5">
                <span>✈️</span>
                <span>{t(locale, 'finder.filter.offline')}</span>
              </div>
              <div class="text-[11px] text-neutral-500 leading-tight mt-0.5">
                {t(locale, 'finder.filter.offlineDesc')}
              </div>
            </div>
          </label>

          {/* Open Source */}
          <label class="filter-toggle-card flex items-start gap-3 p-3 bg-white border-2 border-neutral-300 hover:border-neutral-900 cursor-pointer select-none transition-all">
            <input type="checkbox" id="filter-oss" class="mt-0.5 border-2 border-neutral-900 text-neutral-900 focus:ring-0 w-4 h-4 cursor-pointer" />
            <div>
              <div class="text-xs font-mono font-bold text-neutral-900 flex items-center gap-1.5">
                <span>💻</span>
                <span>{t(locale, 'finder.filter.openSource')}</span>
              </div>
              <div class="text-[11px] text-neutral-500 leading-tight mt-0.5">
                {t(locale, 'finder.filter.openSourceDesc')}
              </div>
            </div>
          </label>

          {/* 100% Free */}
          <label class="filter-toggle-card flex items-start gap-3 p-3 bg-white border-2 border-neutral-300 hover:border-neutral-900 cursor-pointer select-none transition-all">
            <input type="checkbox" id="filter-free" class="mt-0.5 border-2 border-neutral-900 text-neutral-900 focus:ring-0 w-4 h-4 cursor-pointer" />
            <div>
              <div class="text-xs font-mono font-bold text-neutral-900 flex items-center gap-1.5">
                <span>🎁</span>
                <span>{t(locale, 'finder.filter.free')}</span>
              </div>
              <div class="text-[11px] text-neutral-500 leading-tight mt-0.5">
                {t(locale, 'finder.filter.freeDesc')}
              </div>
            </div>
          </label>
        </div>
      </div>

      {/* Sort & Action Bar */}
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-4 border-t border-neutral-200">
        <div class="flex items-center gap-2 text-xs font-mono font-bold text-neutral-800">
          <span id="match-counter-text">
            {t(locale, 'finder.results.matching', { count: String(totalToolsCount) })}
          </span>
          <button
            id="reset-all-filters-btn"
            type="button"
            class="hidden text-neutral-400 hover:text-red-600 underline font-normal transition-colors cursor-pointer text-xs ml-2"
          >
            {t(locale, 'finder.results.clearFilters')}
          </button>
        </div>

        <div class="flex items-center gap-2">
          <label for="finder-sort-select" class="text-xs font-mono font-bold text-neutral-500 whitespace-nowrap">
            {t(locale, 'finder.sort.label')}:
          </label>
          <select
            id="finder-sort-select"
            class="bg-white border-2 border-neutral-900 px-2.5 py-1.5 text-xs font-mono font-bold text-neutral-900 focus:outline-hidden cursor-pointer"
          >
            <option value="score">{t(locale, 'finder.sort.recommended')}</option>
            <option value="name-asc">{t(locale, 'finder.sort.nameAsc')}</option>
            <option value="name-desc">{t(locale, 'finder.sort.nameDesc')}</option>
          </select>
        </div>
      </div>
    </section>

    {/* Results Grid (Server-Prerendered + Client-Managed) */}
    <div id="results-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-16">
      {tools.map((tool) => (
        <article
          class="tool-card bg-white border-2 border-neutral-900 rounded-none p-5 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] transition-all flex flex-col justify-between"
          data-slug={tool.slug}
          data-name={tool.name}
          data-category={tool.category.toLowerCase()}
          data-clientside={tool.isClientSideOnly ? '1' : '0'}
          data-offline={tool.worksOffline ? '1' : '0'}
          data-oss={tool.isOpenSource ? '1' : '0'}
          data-free={tool.isFree ? '1' : '0'}
          data-score={tool.score}
        >
          <div>
            {/* Header: Favicon + Name + Health */}
            <div class="flex items-start justify-between gap-3 mb-2.5">
              <div class="flex items-center gap-2.5 min-w-0">
                <img
                  src={`https://www.google.com/s2/favicons?domain=${tool.hostname}&sz=32`}
                  alt={`${tool.name} icon`}
                  width="20"
                  height="20"
                  class="w-5 h-5 shrink-0"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
                <h3 class="text-base font-bold text-neutral-900 truncate">
                  <a href={getLocalizedPath(`/tool/${tool.slug}`, locale)} class="hover:underline decoration-2">
                    {tool.isFeatured && <span class="text-yellow-500 mr-1 select-none font-mono">★</span>}
                    {tool.name}
                  </a>
                </h3>
              </div>

              <div class="flex items-center gap-1.5 shrink-0">
                <span class="text-[10px] uppercase font-mono font-bold px-2 py-0.5 border border-neutral-900 bg-neutral-100 text-neutral-800">
                  {translateCategory(tool.category)}
                </span>
                {tool.health && (
                  <span class={`text-[10px] px-1.5 py-0.5 border border-neutral-900 font-mono font-bold ${
                    tool.health === 'online'
                      ? 'bg-green-200 text-green-900'
                      : 'bg-amber-200 text-amber-900'
                  }`}>
                    {tool.health === 'online' ? '✓' : '⚠'}
                  </span>
                )}
              </div>
            </div>

            {/* Core Task Badge */}
            {tool.coreTask && (
              <div class="mb-3">
                <span class="inline-block text-[11px] font-mono text-neutral-800 bg-neutral-100 px-2 py-0.5 border border-neutral-300 truncate max-w-full">
                  {tool.coreTask}
                </span>
              </div>
            )}

            {/* Description */}
            <p class="text-xs text-neutral-600 leading-relaxed line-clamp-2 mb-4">
              {tool.description}
            </p>

            {/* Attribute Badges */}
            <div class="flex flex-wrap gap-1.5 mb-5">
              {tool.isClientSideOnly && (
                <span class="inline-flex items-center gap-1 text-[10px] font-mono font-bold px-2 py-0.5 bg-neutral-100 text-neutral-800 border border-neutral-900">
                  <span>🛡️</span>
                  <span>{t(locale, 'finder.filter.clientSide')}</span>
                </span>
              )}
              {tool.worksOffline && (
                <span class="inline-flex items-center gap-1 text-[10px] font-mono font-bold px-2 py-0.5 bg-neutral-100 text-neutral-800 border border-neutral-900">
                  <span>✈️</span>
                  <span>{t(locale, 'finder.filter.offline')}</span>
                </span>
              )}
              {tool.isOpenSource && (
                <span class="inline-flex items-center gap-1 text-[10px] font-mono font-bold px-2 py-0.5 bg-neutral-100 text-neutral-800 border border-neutral-900">
                  <span>💻</span>
                  <span>{t(locale, 'finder.filter.openSource')}</span>
                </span>
              )}
              {tool.isFree && (
                <span class="inline-flex items-center gap-1 text-[10px] font-mono font-bold px-2 py-0.5 bg-neutral-100 text-neutral-800 border border-neutral-900">
                  <span>🎁</span>
                  <span>{t(locale, 'finder.filter.free')}</span>
                </span>
              )}
            </div>
          </div>

          {/* Action CTAs */}
          <div class="pt-3 border-t-2 border-neutral-900 flex items-center justify-between gap-3 text-xs">
            <a
              href={getLocalizedPath(`/tool/${tool.slug}`, locale)}
              class="font-mono font-bold text-neutral-700 hover:text-neutral-900 underline decoration-2 uppercase inline-flex items-center gap-1"
            >
              <span>{t(locale, 'finder.results.audit')}</span>
              <span>&rarr;</span>
            </a>
            <a
              href={tool.url}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 bg-neutral-900 hover:bg-neutral-800 active:translate-x-[1px] active:translate-y-[1px] text-white text-xs font-mono font-bold uppercase tracking-wider border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] inline-flex items-center gap-1.5 group"
            >
              <span>{t(locale, 'finder.results.launch')}</span>
              <span class="group-hover:translate-x-0.5 transition-transform">&nearr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    {/* Empty State */}
    <div id="finder-empty-state" class="hidden text-center py-16 px-4 bg-neutral-50 border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] mb-16">
      <div class="text-4xl mb-3 select-none">🔍</div>
      <h3 class="text-lg font-bold text-neutral-900 mb-2">
        {t(locale, 'finder.empty.title')}
      </h3>
      <p class="text-sm text-neutral-500 max-w-md mx-auto mb-6 leading-relaxed">
        {t(locale, 'finder.empty.desc')}
      </p>
      <button
        id="empty-reset-btn"
        type="button"
        class="px-4 py-2 bg-neutral-900 text-white text-xs font-bold rounded-xl hover:bg-neutral-800 transition-all cursor-pointer shadow-xs"
      >
        {t(locale, 'finder.empty.reset')}
      </button>
    </div>

    {/* FAQ Section */}
    <section class="border-t-2 border-neutral-900 pt-12 mt-12 mb-16" aria-labelledby="finder-faq-heading">
      <h2 id="finder-faq-heading" class="text-xl font-bold font-mono text-neutral-900 tracking-tight uppercase mb-6 flex items-center gap-2">
        <span>💡</span>
        <span>{t(locale, 'finder.faq.heading')}</span>
      </h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {finderFaqs.map(({ q, a }) => (
          <div class="bg-white border-2 border-neutral-900 p-5 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
            <h3 class="text-sm font-bold text-neutral-900 font-mono mb-2">{q}</h3>
            <p class="text-xs text-neutral-600 leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  {/* Embedded Pure Data for Client Engine */}
  <script id="finder-raw-data" type="application/json" set:html={JSON.stringify(tools)} />

  {/* Client-Side Interactive Filter Engine */}
  <script define:vars={{
    matchTemplate: t(locale, 'finder.results.matching', { count: '{count}' })
  }}>
    document.addEventListener('DOMContentLoaded', () => {
      const rawDataEl = document.getElementById('finder-raw-data');
      if (!rawDataEl) return;

      /** @type {Array<any>} */
      const allTools = JSON.parse(rawDataEl.textContent || '[]');

      const searchInput = document.getElementById('finder-search-input');
      const clearSearchBtn = document.getElementById('finder-clear-search-btn');
      const categoryChips = document.querySelectorAll('.cat-chip');
      const clientSideCheck = document.getElementById('filter-clientside');
      const offlineCheck = document.getElementById('filter-offline');
      const ossCheck = document.getElementById('filter-oss');
      const freeCheck = document.getElementById('filter-free');
      const sortSelect = document.getElementById('finder-sort-select');
      const matchCounterText = document.getElementById('match-counter-text');
      const resetAllBtn = document.getElementById('reset-all-filters-btn');
      const emptyResetBtn = document.getElementById('empty-reset-btn');
      const emptyStateEl = document.getElementById('finder-empty-state');
      const resultsGrid = document.getElementById('results-grid');

      let currentCategory = 'all';

      // Read initial state from URL query parameters
      const params = new URLSearchParams(window.location.search);
      if (params.has('q') && searchInput) {
        searchInput.value = params.get('q') || '';
        if (clearSearchBtn) clearSearchBtn.classList.remove('hidden');
      }
      if (params.has('cat')) {
        currentCategory = (params.get('cat') || 'all').toLowerCase();
        categoryChips.forEach((chip) => {
          if (chip.getAttribute('data-cat') === currentCategory) {
            chip.classList.add('active', 'bg-neutral-900', 'text-white', 'border-neutral-900');
            chip.classList.remove('bg-white', 'text-neutral-700', 'border-neutral-300');
          } else {
            chip.classList.remove('active', 'bg-neutral-900', 'text-white', 'border-neutral-900');
            chip.classList.add('bg-white', 'text-neutral-700', 'border-neutral-300');
          }
        });
      }
      if (params.get('clientSide') === '1' && clientSideCheck) clientSideCheck.checked = true;
      if (params.get('offline') === '1' && offlineCheck) offlineCheck.checked = true;
      if (params.get('oss') === '1' && ossCheck) ossCheck.checked = true;
      if (params.get('free') === '1' && freeCheck) freeCheck.checked = true;
      if (params.has('sort') && sortSelect) {
        sortSelect.value = params.get('sort') || 'score';
      }

      function updateUrl() {
        const urlParams = new URLSearchParams();
        const q = (searchInput?.value || '').trim();
        if (q) urlParams.set('q', q);
        if (currentCategory && currentCategory !== 'all') urlParams.set('cat', currentCategory);
        if (clientSideCheck?.checked) urlParams.set('clientSide', '1');
        if (offlineCheck?.checked) urlParams.set('offline', '1');
        if (ossCheck?.checked) urlParams.set('oss', '1');
        if (freeCheck?.checked) urlParams.set('free', '1');
        const sort = sortSelect?.value || 'score';
        if (sort !== 'score') urlParams.set('sort', sort);

        const newSearch = urlParams.toString();
        const newRelativePath = window.location.pathname + (newSearch ? '?' + newSearch : '');
        window.history.replaceState(null, '', newRelativePath);
      }

      function applyFilters() {
        const query = (searchInput?.value || '').trim().toLowerCase();
        const requireClientSide = Boolean(clientSideCheck?.checked);
        const requireOffline = Boolean(offlineCheck?.checked);
        const requireOss = Boolean(ossCheck?.checked);
        const requireFree = Boolean(freeCheck?.checked);
        const sortBy = sortSelect?.value || 'score';

        const hasActiveFilters = Boolean(
          query ||
          currentCategory !== 'all' ||
          requireClientSide ||
          requireOffline ||
          requireOss ||
          requireFree
        );

        if (resetAllBtn) {
          if (hasActiveFilters) {
            resetAllBtn.classList.remove('hidden');
          } else {
            resetAllBtn.classList.add('hidden');
          }
        }

        // Matching items
        const matchingSlugs = new Set();
        const matchedItems = [];

        for (const tool of allTools) {
          if (query) {
            const matchName = tool.name.toLowerCase().includes(query);
            const matchHost = tool.hostname.toLowerCase().includes(query);
            const matchTask = tool.coreTask.toLowerCase().includes(query);
            const matchDesc = tool.description.toLowerCase().includes(query);
            if (!matchName && !matchHost && !matchTask && !matchDesc) {
              continue;
            }
          }

          if (currentCategory !== 'all' && tool.category.toLowerCase() !== currentCategory) {
            continue;
          }

          if (requireClientSide && !tool.isClientSideOnly) continue;
          if (requireOffline && !tool.worksOffline) continue;
          if (requireOss && !tool.isOpenSource) continue;
          if (requireFree && !tool.isFree) continue;

          matchingSlugs.add(tool.slug);
          matchedItems.push(tool);
        }

        // Sort matching items
        matchedItems.sort((a, b) => {
          if (sortBy === 'name-asc') return a.name.localeCompare(b.name);
          if (sortBy === 'name-desc') return b.name.localeCompare(a.name);
          return b.score - a.score;
        });

        // Reorder DOM cards
        if (resultsGrid) {
          const cards = Array.from(resultsGrid.querySelectorAll('.tool-card'));
          const cardMap = new Map(cards.map((c) => [c.getAttribute('data-slug'), c]));

          for (const card of cards) {
            const slug = card.getAttribute('data-slug');
            if (matchingSlugs.has(slug)) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          }

          // Append in sorted order
          for (const item of matchedItems) {
            const el = cardMap.get(item.slug);
            if (el) resultsGrid.appendChild(el);
          }
        }

        // Update counter
        if (matchCounterText) {
          matchCounterText.textContent = matchTemplate.replace('{count}', String(matchedItems.length));
        }

        // Toggle empty state
        if (emptyStateEl) {
          if (matchedItems.length === 0) {
            emptyStateEl.classList.remove('hidden');
          } else {
            emptyStateEl.classList.add('hidden');
          }
        }

        updateUrl();
      }

      // Event Listeners
      let debounceTimer = null;
      searchInput?.addEventListener('input', () => {
        if (clearSearchBtn) {
          if (searchInput.value.length > 0) {
            clearSearchBtn.classList.remove('hidden');
          } else {
            clearSearchBtn.classList.add('hidden');
          }
        }
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(applyFilters, 120);
      });

      clearSearchBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        clearSearchBtn.classList.add('hidden');
        applyFilters();
        searchInput?.focus();
      });

      categoryChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          categoryChips.forEach((c) => {
            c.classList.remove('active', 'bg-neutral-900', 'text-white', 'border-neutral-900');
            c.classList.add('bg-white', 'text-neutral-700', 'border-neutral-300');
          });
          chip.classList.add('active', 'bg-neutral-900', 'text-white', 'border-neutral-900');
          chip.classList.remove('bg-white', 'text-neutral-700', 'border-neutral-300');

          currentCategory = (chip.getAttribute('data-cat') || 'all').toLowerCase();
          applyFilters();
        });
      });

      [clientSideCheck, offlineCheck, ossCheck, freeCheck].forEach((cb) => {
        cb?.addEventListener('change', applyFilters);
      });

      sortSelect?.addEventListener('change', applyFilters);

      function resetAll() {
        if (searchInput) searchInput.value = '';
        if (clearSearchBtn) clearSearchBtn.classList.add('hidden');
        currentCategory = 'all';
        categoryChips.forEach((chip) => {
          if (chip.getAttribute('data-cat') === 'all') {
            chip.classList.add('active', 'bg-neutral-900', 'text-white', 'border-neutral-900');
            chip.classList.remove('bg-white', 'text-neutral-700', 'border-neutral-300');
          } else {
            chip.classList.remove('active', 'bg-neutral-900', 'text-white', 'border-neutral-900');
            chip.classList.add('bg-white', 'text-neutral-700', 'border-neutral-300');
          }
        });
        if (clientSideCheck) clientSideCheck.checked = false;
        if (offlineCheck) offlineCheck.checked = false;
        if (ossCheck) ossCheck.checked = false;
        if (freeCheck) freeCheck.checked = false;
        if (sortSelect) sortSelect.value = 'score';
        applyFilters();
      }

      resetAllBtn?.addEventListener('click', resetAll);
      emptyResetBtn?.addEventListener('click', resetAll);

      // If initial URL parameters were present, run filters immediately
      if (params.toString()) {
        applyFilters();
      }
    });
  </script>
</Layout>
