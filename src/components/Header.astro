---
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { t, loadTranslations, getLocalizedPath, getPathWithoutLocale } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
await loadTranslations(locale);

const currentPath = getPathWithoutLocale(Astro.url.pathname);

const navItems = [
  { label: t(locale, 'nav.tools'), path: '/' },
  { label: t(locale, 'nav.finder'), path: '/finder' },
  { label: t(locale, 'nav.extension'), path: '/extension' },
  { label: t(locale, 'nav.blog'), path: '/blog' },
  { label: t(locale, 'nav.about'), path: '/about' },
];

const mobileNavItems = [
  ...navItems,
  { label: t(locale, 'nav.badge'), path: '/badge' },
  { label: t(locale, 'nav.developers'), path: '/developers' },
  { label: t(locale, 'nav.submit'), path: '/submit' },
];
---

<header class="bg-[#fdfdfc] border-b-2 border-neutral-900 sticky top-0 z-30">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <div class="flex items-center gap-6 sm:gap-8">
      <a href={getLocalizedPath('/', locale)} class="font-black text-xl tracking-tighter text-neutral-900 uppercase italic">
        nologin.tools
      </a>
      <nav class="hidden md:flex items-center gap-5 text-retro-mono" aria-label="Main navigation">
        {navItems.map((item) => {
          const localizedPath = getLocalizedPath(item.path, locale);
          const isActive = item.path === '/' ? currentPath === '/' : currentPath.startsWith(item.path);
          return (
            <a
              href={localizedPath}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'text-xs font-bold uppercase tracking-widest transition-all px-1',
                isActive
                  ? 'bg-neutral-900 text-white'
                  : 'text-neutral-500 hover:text-neutral-900 hover:underline decoration-2 underline-offset-4',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
      <button id="header-bookmark-btn" class="hidden lg:flex items-center gap-1.5 px-2 py-1 bg-yellow-300 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] text-[10px] font-black uppercase tracking-tight hover:bg-yellow-400 transition-all active:translate-x-[1px] active:translate-y-[1px] active:shadow-none ml-2 cursor-pointer">
        ★ <span id="header-bookmark-key">Ctrl+D</span>
      </button>
    </div>
    <div class="flex items-center gap-3">
      <a
        href={getLocalizedPath('/submit', locale)}
        class="hidden sm:inline-flex items-center px-3 py-1 bg-white border-2 border-neutral-900 text-xs font-mono font-bold text-neutral-900 uppercase tracking-wider shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-neutral-50 active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all cursor-pointer"
      >
        + {t(locale, 'nav.submit')}
      </a>
      <div class="hidden md:block">
        <LanguageSwitcher locale={locale} />
      </div>
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-neutral-900 border-2 border-neutral-900 hover:bg-neutral-900 hover:text-white transition-all"
        aria-label={t(locale, 'nav.toggleMenu')}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="square"
        >
          <path d="M3 12h18M3 6h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>
  <nav
    id="mobile-menu"
    class="hidden md:hidden border-t-2 border-neutral-900 bg-white px-6 py-8 space-y-5 text-retro-mono"
    aria-label="Mobile navigation"
  >
    {mobileNavItems.map((item) => {
      const localizedPath = getLocalizedPath(item.path, locale);
      const isActive = item.path === '/' ? currentPath === '/' : currentPath.startsWith(item.path);
      return (
        <a
          href={localizedPath}
          aria-current={isActive ? 'page' : undefined}
          class:list={[
            'block text-sm font-bold uppercase tracking-widest',
            isActive ? 'text-neutral-900 underline decoration-2' : 'text-neutral-500',
          ]}
        >
          {item.label}
        </a>
      );
    })}
    <div class="pt-4 border-t border-neutral-200">
      <LanguageSwitcher locale={locale} />
    </div>
  </nav>

  <!-- Non-blocking toast notification -->
  <div
    id="header-toast"
    role="status"
    aria-live="polite"
    class="hidden fixed bottom-6 right-6 z-50 bg-neutral-900 text-white border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] px-4 py-2.5 text-xs font-mono font-bold flex items-center gap-2 transition-opacity"
  >
    <span class="text-yellow-400">★</span>
    <span id="header-toast-msg"></span>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  const headerBookmarkKey = document.getElementById('header-bookmark-key');
  const headerBookmarkBtn = document.getElementById('header-bookmark-btn');
  const toast = document.getElementById('header-toast');
  const toastMsg = document.getElementById('header-toast-msg');

  const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
  if (headerBookmarkKey) {
    headerBookmarkKey.textContent = isMac ? '⌘+D' : 'Ctrl+D';
  }

  let toastTimer: any = null;
  headerBookmarkBtn?.addEventListener('click', () => {
    const shortcut = isMac ? '⌘+D' : 'Ctrl+D';
    if (toast && toastMsg) {
      toastMsg.textContent = `Press ${shortcut} to bookmark this page`;
      toast.classList.remove('hidden');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add('hidden');
      }, 2500);
    }
  });
</script>
