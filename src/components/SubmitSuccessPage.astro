---
import Layout from '../layouts/Layout.astro';
import { getBadgeEmbedCode, BADGE_STYLES, BADGE_GROUPS, ORIGINAL_BADGE } from '../lib/badge';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import { getDb } from '../db';
import { tools } from '../db/schema';
import { eq } from 'drizzle-orm';
import { parseGitHubRepoUrl } from '../lib/github';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
await loadTranslations(locale);

const slug = Astro.url.searchParams.get('slug') || '';
const siteUrl = Astro.locals.runtime?.env?.SITE_URL || 'https://nologin.tools';

let githubInfo: { owner: string; repo: string } | null = null;
let toolName = slug;

if (slug && Astro.locals.runtime?.env?.DB) {
  try {
    const db = getDb(Astro.locals.runtime.env.DB);
    const [tool] = await db
      .select({ name: tools.name, repoUrl: tools.repoUrl })
      .from(tools)
      .where(eq(tools.slug, slug));
    if (tool) {
      if (tool.name) toolName = tool.name;
      if (tool.repoUrl) {
        githubInfo = parseGitHubRepoUrl(tool.repoUrl);
      }
    }
  } catch {
    // Graceful fallback if DB fails
  }
}

const embedCode = getBadgeEmbedCode(slug, siteUrl, 'flat');
const allEmbedCodes = Object.fromEntries(
  [...BADGE_STYLES, ORIGINAL_BADGE].map((s) => [s.id, getBadgeEmbedCode(slug, siteUrl, s.id)])
);
---

<Layout
  title={t(locale, 'submitSuccess.title')}
  description={t(locale, 'submitSuccess.description')}
  locale={locale}
>
  <div class="max-w-4xl mx-auto px-6 py-16 sm:py-24">
    <!-- Success message -->
    <div class="text-center mb-12 sm:mb-16">
      <div class="w-16 h-16 mx-auto mb-5 rounded-none bg-green-300 border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex items-center justify-center text-neutral-900 text-3xl font-black">
        ✓
      </div>
      <h1 class="text-2xl sm:text-3xl font-black uppercase italic tracking-tight text-neutral-900 mb-3">
        {t(locale, 'submitSuccess.heading')}
      </h1>
      <p class="text-neutral-600 max-w-xl mx-auto text-sm sm:text-base leading-relaxed">
        {t(locale, 'submitSuccess.intro')}
      </p>
    </div>

    <div class="space-y-12">
      <!-- Tool page preview link -->
      {slug && (
        <section class="border-2 border-neutral-900 bg-white shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] rounded-none p-5 sm:p-6">
          <h2 class="text-xs font-mono font-bold text-neutral-500 uppercase tracking-wider mb-2">{t(locale, 'submitSuccess.pendingTitle')}</h2>
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <p class="text-neutral-900 font-bold mb-1">{t(locale, 'submitSuccess.previewListing')}</p>
              <a href={getLocalizedPath(`/tool/${slug}`, locale)} class="text-sm text-neutral-900 hover:underline break-all font-mono font-bold">{siteUrl}{getLocalizedPath(`/tool/${slug}`, locale)}</a>
            </div>
            <a href={getLocalizedPath(`/tool/${slug}`, locale)} class="btn-retro text-xs font-mono font-bold whitespace-nowrap">
              {t(locale, 'submitSuccess.viewPage')} &rarr;
            </a>
          </div>
          <p class="text-xs font-mono text-neutral-500 mt-3 pt-3 border-t border-neutral-200">
            {t(locale, 'submitSuccess.pendingNote')}
          </p>
        </section>
      )}

      <!-- 1-Click GitHub README Fast-Track (if repoUrl available) -->
      {githubInfo && (
        <section class="border-2 border-neutral-900 bg-emerald-50 rounded-none p-6 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="space-y-2">
              <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-none font-mono text-xs font-bold bg-white text-emerald-950 border border-neutral-900 shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                <span>{t(locale, 'submitSuccess.fastTrackTag')}</span>
                <span class="text-neutral-400">·</span>
                <span>Level 3 Ready</span>
              </div>
              <h2 class="text-lg font-bold text-neutral-900">
                {t(locale, 'submitSuccess.fastTrackTitle')}
              </h2>
              <p class="text-xs sm:text-sm text-neutral-700 max-w-xl leading-relaxed">
                {t(locale, 'submitSuccess.fastTrackDesc')}
              </p>
            </div>
            <div class="flex flex-col sm:flex-row md:flex-col gap-2 shrink-0">
              <a
                href={`https://github.com/${githubInfo.owner}/${githubInfo.repo}/edit/HEAD/README.md`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm"
              >
                <span>{t(locale, 'submitSuccess.openReadme')}</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
              {slug && (
                <a
                  href={getLocalizedPath(`/badge/${slug}`, locale)}
                  class="inline-flex items-center justify-center gap-1 text-xs font-mono font-bold text-neutral-800 hover:text-neutral-950 underline py-1"
                >
                  <span>{t(locale, 'submitSuccess.viewCertificate')}</span> &rarr;
                </a>
              )}
            </div>
          </div>
        </section>
      )}

      <!-- Badge Privileges & Integration Guide -->
      <section class="border-t-2 border-neutral-900 pt-10">
        <div class="text-center mb-8">
          <span class="inline-flex items-center gap-1 px-3 py-1 bg-yellow-200 border border-neutral-900 shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] text-neutral-900 rounded-none text-xs font-mono font-bold uppercase tracking-wider mb-3">
            ⭐ {t(locale, 'submitSuccess.perksTitle')}
          </span>
          <h2 class="text-xl sm:text-2xl font-black uppercase text-neutral-900 mb-3">
            {t(locale, 'submitSuccess.badgeTitle')}
          </h2>
          <p class="text-neutral-600 max-w-xl mx-auto text-sm leading-relaxed">
            {t(locale, 'submitSuccess.badgeDesc')}
          </p>
        </div>

        <!-- 3 Perks Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
          <div class="p-4 rounded-none bg-white border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
            <div class="text-green-700 font-bold text-sm mb-1">🚀 {t(locale, 'submitSuccess.perkBoostTitle')}</div>
            <p class="text-xs text-neutral-600 leading-relaxed">{t(locale, 'submitSuccess.perkBoostDesc')}</p>
          </div>
          <div class="p-4 rounded-none bg-white border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
            <div class="text-green-700 font-bold text-sm mb-1">⚡ {t(locale, 'submitSuccess.perkFastTrackTitle')}</div>
            <p class="text-xs text-neutral-600 leading-relaxed">{t(locale, 'submitSuccess.perkFastTrackDesc')}</p>
          </div>
          <div class="p-4 rounded-none bg-white border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
            <div class="text-green-700 font-bold text-sm mb-1">🛡️ {t(locale, 'submitSuccess.perkCertTitle')}</div>
            <p class="text-xs text-neutral-600 leading-relaxed">{t(locale, 'submitSuccess.perkCertDesc')}</p>
          </div>
        </div>

        <p class="text-center text-xs text-neutral-600 mb-8 max-w-lg mx-auto font-mono">
          {t(locale, 'submitSuccess.howToUse')}
        </p>

        <!-- Badge Style Selector -->
        <div class="mb-10">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500 mb-6 text-center">{t(locale, 'submitSuccess.selectStyle')}</h3>
          <div class="space-y-8">
            {BADGE_GROUPS.map((group) => {
              const groupStyles = BADGE_STYLES.filter((s) => s.group === group.id);
              const isDark = group.id === 'dark';
              return groupStyles.length > 0 && (
                <div>
                  <p class="text-xs font-mono font-bold uppercase text-neutral-500 mb-3 text-center">{group.label}</p>
                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
                    {groupStyles.map((style) => (
                      <button
                        class:list={[
                          'badge-style-btn flex flex-col items-center justify-center gap-2.5 p-3 rounded-none border-2 transition-all duration-150 cursor-pointer shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none',
                          isDark ? 'bg-neutral-900 border-neutral-900 text-white' : 'bg-white border-neutral-900 text-neutral-900',
                          style.id === 'flat'
                            ? 'ring-2 ring-green-500'
                            : 'hover:bg-neutral-50',
                        ]}
                        data-style={style.id}
                        data-badge-path={style.path}
                        data-dark={isDark ? 'true' : undefined}
                      >
                        <img src={style.path} alt={style.label} class="h-6" />
                        <span class:list={['text-xs font-mono font-bold', isDark ? 'text-neutral-300' : 'text-neutral-700']}>{style.label}</span>
                      </button>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Preview -->
        <div class="p-6 bg-white border-2 border-neutral-900 rounded-none flex flex-col items-center justify-center gap-3 mb-8 max-w-2xl mx-auto shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
          <span class="text-xs font-mono font-bold text-neutral-500 uppercase">Live Badge Preview</span>
          <img id="badge-preview" src="/badges/flat.svg" alt="NoLogin Verified" class="h-8" />
          {slug && (
            <a href={getLocalizedPath(`/badge/${slug}`, locale)} class="text-xs font-mono font-bold text-neutral-900 hover:underline underline-offset-2">
              View Digital Certificate &rarr;
            </a>
          )}
        </div>

        <div class="grid grid-cols-1 gap-6 text-left max-w-2xl mx-auto">
          <!-- Markdown (GitHub README) -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-neutral-900 flex items-center gap-1.5">
                <span>{t(locale, 'submitSuccess.markdownBadge')}</span>
                <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded-none border border-neutral-900 bg-neutral-100 text-neutral-800">README.md</span>
              </h3>
              <button
                class="copy-btn text-xs font-mono font-bold text-neutral-900 px-3 py-1 bg-white border border-neutral-900 hover:bg-neutral-100 shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all cursor-pointer rounded-none"
                data-code="markdown"
                data-copied-text={t(locale, 'submitSuccess.copiedBtn')}
              >
                {t(locale, 'submitSuccess.copyBtn')}
              </button>
            </div>
            <pre id="code-markdown" class="bg-neutral-900 text-neutral-200 p-4 rounded-none text-[11px] font-mono overflow-x-auto leading-relaxed border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]"><code>{embedCode.markdown}</code></pre>
          </div>

          <!-- HTML / SVG Badge -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-neutral-900">{t(locale, 'submitSuccess.svgBadge')}</h3>
              <button
                class="copy-btn text-xs font-mono font-bold text-neutral-900 px-3 py-1 bg-white border border-neutral-900 hover:bg-neutral-100 shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all cursor-pointer rounded-none"
                data-code="svg"
                data-copied-text={t(locale, 'submitSuccess.copiedBtn')}
              >
                {t(locale, 'submitSuccess.copyBtn')}
              </button>
            </div>
            <pre id="code-svg" class="bg-neutral-900 text-neutral-200 p-4 rounded-none text-[11px] font-mono overflow-x-auto leading-relaxed border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]"><code>{embedCode.svg}</code></pre>
          </div>

          <!-- Meta tag -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-neutral-900">{t(locale, 'submitSuccess.metaTag')}</h3>
              <button
                class="copy-btn text-xs font-mono font-bold text-neutral-900 px-3 py-1 bg-white border border-neutral-900 hover:bg-neutral-100 shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all cursor-pointer rounded-none"
                data-code="meta"
                data-copied-text={t(locale, 'submitSuccess.copiedBtn')}
              >
                {t(locale, 'submitSuccess.copyBtn')}
              </button>
            </div>
            <pre id="code-meta" class="bg-neutral-900 text-neutral-200 p-4 rounded-none text-[11px] font-mono overflow-x-auto leading-relaxed border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]"><code>{embedCode.meta}</code></pre>
          </div>
        </div>
      </section>

      <div class="text-center pt-8">
        <a href={getLocalizedPath('/', locale)} class="btn-minimal-primary">
          {t(locale, 'submitSuccess.backToDirectory')}
        </a>
      </div>
    </div>
  </div>

  <script id="embed-codes-data" type="application/json" set:html={JSON.stringify(allEmbedCodes)} />

  <script>
    // Badge style switching
    const embedCodes: Record<string, { svg: string; markdown: string; meta: string }> = JSON.parse(
      document.getElementById('embed-codes-data')!.textContent!
    );
    const styleBtns = document.querySelectorAll('.badge-style-btn');
    const badgePreview = document.getElementById('badge-preview') as HTMLImageElement;
    const codeMarkdown = document.getElementById('code-markdown');
    const codeSvg = document.getElementById('code-svg');

    styleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const style = (btn as HTMLElement).dataset.style!;
        const badgePath = (btn as HTMLElement).dataset.badgePath!;

        badgePreview.src = badgePath;

        if (codeMarkdown && embedCodes[style]) {
          codeMarkdown.innerHTML = `<code>${embedCodes[style].markdown.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code>`;
        }
        if (codeSvg && embedCodes[style]) {
          codeSvg.innerHTML = `<code>${embedCodes[style].svg.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code>`;
        }

        styleBtns.forEach((b) => {
          const el = b as HTMLElement;
          const isDark = el.dataset.dark === 'true';
          if (el.dataset.style === style) {
            el.classList.add('ring-2', 'ring-green-500', 'border-transparent');
            el.classList.remove('border-neutral-200', 'border-neutral-800', 'hover:border-neutral-300');
          } else {
            el.classList.remove('ring-2', 'ring-green-500', 'border-transparent');
            el.classList.add('hover:border-neutral-300');
            if (isDark) {
              el.classList.add('border-neutral-800');
            } else {
              el.classList.add('border-neutral-200');
            }
          }
        });
      });
    });

    // Copy to clipboard
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const codeId = `code-${(btn as HTMLElement).dataset.code}`;
        const codeEl = document.getElementById(codeId);
        if (codeEl) {
          navigator.clipboard.writeText(codeEl.textContent || '');
          const originalText = btn.textContent;
          btn.textContent = (btn as HTMLElement).dataset.copiedText || 'Copied!';
          setTimeout(() => {
            btn.textContent = originalText;
          }, 2000);
        }
      });
    });
  </script>
</Layout>
