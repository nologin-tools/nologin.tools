---
import Layout from '../layouts/Layout.astro';
import { getAlternativeBySlug, getAlternativeTargets, getToolsForAlternative } from '../lib/alternatives';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import { getLocalizedDescription } from '../data/loader';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
await loadTranslations(locale);

const target = getAlternativeBySlug(slug);
if (!target) {
  throw new Error(`Alternative target not found for slug: ${slug}`);
}

const tools = getToolsForAlternative(target, locale);
const allTargets = getAlternativeTargets();

function getHostname(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
}

const pageTitle = t(locale, 'alternative.page.title', { target: target.name, count: tools.length });
const pageDescription = t(locale, 'alternative.page.description', { target: target.name, count: tools.length });

const canonicalPath = getLocalizedPath(`/alternative/${slug}`, locale);

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: `https://nologin.tools${canonicalPath}`,
  inLanguage: locale,
  about: {
    '@type': 'SoftwareApplication',
    name: target.name,
    applicationCategory: target.category,
  },
  mainEntity: {
    '@type': 'ItemList',
    name: t(locale, 'alternative.page.heading', { target: target.name }),
    numberOfItems: tools.length,
    itemListElement: tools.map((tool, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: tool.name,
      url: `https://nologin.tools${getLocalizedPath(`/tool/${tool.slug}`, locale)}`,
    })),
  },
};

const faqQuestions = [
  {
    q: t(locale, 'alternative.faq.q1', { target: target.name }),
    a: t(locale, 'alternative.faq.a1', { target: target.name }),
  },
  {
    q: t(locale, 'alternative.faq.q2', { target: target.name }),
    a: t(locale, 'alternative.faq.a2', { target: target.name }),
  },
  {
    q: t(locale, 'alternative.faq.q3', { target: target.name }),
    a: t(locale, 'alternative.faq.a3', { target: target.name }),
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: locale,
  mainEntity: faqQuestions.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(locale, 'common.home'), item: `https://nologin.tools${getLocalizedPath('/', locale)}` },
    { '@type': 'ListItem', position: 2, name: target.name, item: `https://nologin.tools${canonicalPath}` },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-2 text-xs font-mono font-bold text-neutral-500">
        <li>
          <a href={getLocalizedPath('/', locale)} class="hover:text-neutral-900 transition-colors">{t(locale, 'common.home')}</a>
        </li>
        <li aria-hidden="true">
          <svg class="w-3.5 h-3.5 text-neutral-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
          </svg>
        </li>
        <li aria-current="page" class="text-neutral-900 font-bold">
          {target.name}
        </li>
      </ol>
    </nav>

    <!-- Hero Header -->
    <header class="mb-10 border-b-2 border-neutral-900 pb-8">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-white text-neutral-900 border-2 border-neutral-900 text-xs font-mono font-bold uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] mb-4">
        <span>🛡️ {t(locale, 'alternative.page.badge')}</span>
        <span>&bull;</span>
        <span>{target.category}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-neutral-900 tracking-tight leading-tight">
        {t(locale, 'alternative.page.heading', { target: target.name })}
      </h1>
      <p class="mt-4 text-base sm:text-lg text-neutral-700 leading-relaxed max-w-3xl">
        {target.headline}.
      </p>
      <div class="mt-5 flex items-center gap-3 text-xs font-mono font-bold text-neutral-600">
        <span class="inline-flex items-center gap-1.5 text-emerald-950 bg-emerald-100 px-2.5 py-1 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
          <span class="w-2 h-2 rounded-none bg-emerald-600"></span>
          {t(locale, 'alternative.page.countVerified', { count: tools.length })}
        </span>
        <span class="text-neutral-400">&bull;</span>
        <span>{target.primaryUtility}</span>
      </div>
    </header>

    <!-- Why Switch / Trust Cards -->
    <section class="mb-14 grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-4 bg-white border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <div class="text-xl mb-2">⚡</div>
        <h3 class="font-mono font-bold text-neutral-900 text-sm mb-1 uppercase tracking-wide">{t(locale, 'alternative.page.whyCard1Title')}</h3>
        <p class="text-xs text-neutral-600 leading-relaxed font-mono">{t(locale, 'alternative.page.whyCard1Desc')}</p>
      </div>
      <div class="p-4 bg-white border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <div class="text-xl mb-2">🔒</div>
        <h3 class="font-mono font-bold text-neutral-900 text-sm mb-1 uppercase tracking-wide">{t(locale, 'alternative.page.whyCard2Title')}</h3>
        <p class="text-xs text-neutral-600 leading-relaxed font-mono">{t(locale, 'alternative.page.whyCard2Desc')}</p>
      </div>
      <div class="p-4 bg-white border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <div class="text-xl mb-2">🛡️</div>
        <h3 class="font-mono font-bold text-neutral-900 text-sm mb-1 uppercase tracking-wide">{t(locale, 'alternative.page.whyCard3Title')}</h3>
        <p class="text-xs text-neutral-600 leading-relaxed font-mono">{t(locale, 'alternative.page.whyCard3Desc')}</p>
      </div>
    </section>

    <!-- Tool Comparison / Cards List -->
    <section class="mb-16">
      <h2 class="text-2xl font-black text-neutral-900 uppercase tracking-tight mb-8 font-mono">
        {t(locale, 'alternative.page.curatedHeading', { target: target.name })}
      </h2>

      <div class="space-y-8">
        {tools.map((tool, index) => {
          const hostname = getHostname(tool.url);
          const localizedDesc = getLocalizedDescription(tool, locale) || tool.description || '';
          return (
            <article class="border-2 border-neutral-900 bg-white p-5 sm:p-7 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b-2 border-neutral-900 pb-5 mb-5">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 border-2 border-neutral-900 bg-neutral-100 flex items-center justify-center shrink-0 overflow-hidden shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                    <img
                      src={`https://www.google.com/s2/favicons?domain=${hostname}&sz=64`}
                      alt={tool.name}
                      width="24"
                      height="24"
                      class="w-6 h-6 object-contain"
                      loading="lazy"
                      onerror="this.style.display='none'"
                    />
                  </div>
                  <div>
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="text-xs font-mono font-bold text-neutral-500">#0{index + 1}</span>
                      <a
                        href={getLocalizedPath(`/tool/${tool.slug}`, locale)}
                        class="text-xl font-bold text-neutral-900 hover:underline"
                      >
                        {tool.name}
                      </a>
                      {tool.isFeatured && (
                        <span class="text-yellow-600 text-sm font-bold" title={t(locale, 'common.featured')}>★</span>
                      )}
                      <span class="text-xs font-mono text-neutral-500">({hostname})</span>
                    </div>
                    <p class="text-xs text-neutral-600 mt-0.5">
                      {tool.bestFor || localizedDesc}
                    </p>
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  <a
                    href={tool.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-4 py-2 bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-mono font-bold border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] transition-none inline-flex items-center gap-1.5"
                  >
                    <span>{t(locale, 'tool.openTool')}</span>
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                  </a>
                  <a
                    href={getLocalizedPath(`/tool/${tool.slug}`, locale)}
                    class="px-3 py-2 bg-white hover:bg-yellow-50 text-neutral-900 text-xs font-mono font-bold border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] transition-none"
                  >
                    Audit
                  </a>
                </div>
              </div>

              <!-- Pros & Cons Grid -->
              {(tool.pros.length > 0 || tool.cons.length > 0) && (
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5 text-xs">
                  {tool.pros.length > 0 && (
                    <div class="bg-emerald-50 border-2 border-neutral-900 p-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                      <div class="font-mono font-bold text-emerald-900 mb-2 flex items-center gap-1 uppercase tracking-wide">
                        <span>✓</span>
                        <span>{t(locale, 'tool.editorial.pros')}</span>
                      </div>
                      <ul class="space-y-1.5 text-neutral-800 font-mono">
                        {tool.pros.map((pro: string) => (
                          <li class="flex items-start gap-1.5">
                            <span class="text-emerald-700 font-bold shrink-0">•</span>
                            <span>{pro}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {tool.cons.length > 0 && (
                    <div class="bg-amber-50 border-2 border-neutral-900 p-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                      <div class="font-mono font-bold text-amber-950 mb-2 flex items-center gap-1 uppercase tracking-wide">
                        <span>&minus;</span>
                        <span>{t(locale, 'tool.editorial.cons')}</span>
                      </div>
                      <ul class="space-y-1.5 text-neutral-800 font-mono">
                        {tool.cons.map((con: string) => (
                          <li class="flex items-start gap-1.5">
                            <span class="text-amber-700 font-bold shrink-0">•</span>
                            <span>{con}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              )}

              <!-- Privacy Architecture Verdict -->
              {tool.privacyVerdict && (
                <div class="bg-neutral-50 border-2 border-neutral-900 p-3 text-xs flex items-start gap-2.5 font-mono shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                  <span class="text-base shrink-0">🛡️</span>
                  <div>
                    <span class="font-bold text-neutral-900 block mb-0.5 uppercase tracking-wide">{t(locale, 'tool.editorial.privacy')}</span>
                    <p class="text-neutral-700 leading-relaxed">{tool.privacyVerdict}</p>
                  </div>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mb-16 border-t-2 border-neutral-900 pt-10">
      <h2 class="text-2xl font-black text-neutral-900 uppercase tracking-tight mb-6 font-mono">
        {t(locale, 'alternative.faq.heading')}
      </h2>
      <dl class="space-y-6">
        {faqQuestions.map((faq) => (
          <div class="border-b-2 border-neutral-200 pb-5">
            <dt class="text-base font-bold text-neutral-900 mb-1">{faq.q}</dt>
            <dd class="text-sm text-neutral-700 leading-relaxed">{faq.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Cross-Linking: Explore More Software Targets -->
    <section class="mb-16 border-t-2 border-neutral-900 pt-10">
      <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500 mb-4">
        {t(locale, 'alternative.page.exploreOther')}
      </h3>
      <div class="flex flex-wrap gap-2">
        {allTargets.map((alt) => (
          <a
            href={getLocalizedPath(`/alternative/${alt.slug}`, locale)}
            class:list={[
              'px-3 py-1.5 text-xs font-mono font-bold border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-none',
              alt.slug === slug
                ? 'bg-neutral-900 text-white'
                : 'bg-white text-neutral-900 hover:bg-yellow-50',
            ]}
          >
            {alt.name}
          </a>
        ))}
      </div>
    </section>

    <!-- Browse All Backlink -->
    <div class="pt-6 border-t-2 border-neutral-900">
      <a
        href={getLocalizedPath('/', locale)}
        class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-700 hover:text-neutral-900 underline"
      >
        ← {t(locale, 'alternative.page.browseAll')}
      </a>
    </div>
  </div>
</Layout>
