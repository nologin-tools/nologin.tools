              <button class="copy-btn text-xs font-medium text-green-600 hover:text-green-700 px-3 py-1 rounded bg-green-50 transition-colors cursor-pointer" data-code="meta" data-copied-text={t(locale, 'badgeDetail.copied')}>{t(locale, 'badgeDetail.copyCode')}</button>
            </div>
            <pre id="code-meta" class="bg-neutral-900 text-neutral-400 p-6 rounded-lg text-[11px] font-mono overflow-x-auto border border-neutral-800"><code>{embedCode.meta}</code></pre>
