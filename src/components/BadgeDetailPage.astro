    </div> <!-- end panel-embed -->

    <script id="embed-codes-data" type="application/json" set:html={JSON.stringify(allEmbedCodes)} />
  </div>

  <script>
    // Tab switching
    const tabs = {
      verification: {
        btn: document.getElementById('tab-verification')!,
        panel: document.getElementById('panel-verification')!,
      },
      embed: {
        btn: document.getElementById('tab-embed')!,
        panel: document.getElementById('panel-embed')!,
      },
    };

    function activateTab(name: 'verification' | 'embed') {
      for (const [key, { btn, panel }] of Object.entries(tabs)) {
        const isActive = key === name;
        panel.classList.toggle('hidden', !isActive);
        btn.setAttribute('aria-selected', String(isActive));
        btn.classList.toggle('border-green-500', isActive);
        btn.classList.toggle('text-green-600', isActive);
        btn.classList.toggle('border-transparent', !isActive);
        btn.classList.toggle('text-neutral-500', !isActive);
      }
    }

    // Initialize from hash
    if (window.location.hash === '#embed') {
      activateTab('embed');
    }

    // Tab click handlers
    tabs.verification.btn.addEventListener('click', () => {
      activateTab('verification');
      history.replaceState(null, '', window.location.pathname);
    });

    tabs.embed.btn.addEventListener('click', () => {
      activateTab('embed');
      history.replaceState(null, '', '#embed');
    });

    // Handle browser back/forward
    window.addEventListener('hashchange', () => {
      activateTab(window.location.hash === '#embed' ? 'embed' : 'verification');
    });

    // Badge style switching
    const embedCodes: Record<string, { svg: string; markdown: string; meta: string }> = JSON.parse(
      document.getElementById('embed-codes-data')!.textContent!
    );
    const styleBtns = document.querySelectorAll('.badge-style-btn');
    const badgePreview = document.getElementById('badge-preview') as HTMLImageElement;
    const codeMarkdown = document.getElementById('code-markdown');
    const codeSvg = document.getElementById('code-svg');

    styleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const style = (btn as HTMLElement).dataset.style!;
        const badgePath = (btn as HTMLElement).dataset.badgePath!;

        // Update preview image
        badgePreview.src = badgePath;

        // Update Markdown and SVG embed code
        if (codeMarkdown && embedCodes[style]) {
          codeMarkdown.innerHTML = `<code>${embedCodes[style].markdown.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code>`;
        }
        if (codeSvg && embedCodes[style]) {
          codeSvg.innerHTML = `<code>${embedCodes[style].svg.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code>`;
        }

        // Update button styles
        styleBtns.forEach((b) => {
          const el = b as HTMLElement;
          const isDark = el.dataset.dark === 'true';
          if (el.dataset.style === style) {
            el.classList.add('ring-2', 'ring-green-500', 'border-transparent');
            el.classList.remove('border-neutral-200', 'border-neutral-800', 'hover:border-neutral-400');
            if (!isDark) el.classList.add('bg-green-50');
          } else {
            el.classList.remove('ring-2', 'ring-green-500', 'border-transparent', 'bg-green-50');
            el.classList.add('hover:border-neutral-400');
            if (isDark) {
              el.classList.add('border-neutral-800');
            } else {
              el.classList.add('border-neutral-200');
            }
          }
        });
      });
    });

    // Copy to clipboard
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const codeId = `code-${(btn as HTMLElement).dataset.code}`;
        const codeEl = document.getElementById(codeId);
        if (codeEl) {
          navigator.clipboard.writeText(codeEl.textContent || '');
          const originalText = btn.textContent;
          btn.textContent = (btn as HTMLElement).dataset.copiedText || 'Copied!';
          setTimeout(() => {
            btn.textContent = originalText;
          }, 2000);
        }
      });
    });

    // Self-service badge verification
    const btnVerify = document.getElementById('btn-verify-badge') as HTMLButtonElement | null;
    if (btnVerify) {
      btnVerify.addEventListener('click', async () => {
        const slug = btnVerify.getAttribute('data-slug');
        if (!slug) return;

        const spinner = document.getElementById('verify-spinner');
        const btnText = document.getElementById('verify-btn-text');
        const statusPill = document.getElementById('badge-status-pill');
        const statusDot = document.getElementById('badge-status-dot');
        const statusText = document.getElementById('badge-status-text');
        const statusDesc = document.getElementById('badge-status-desc');
        const actionWrapper = document.getElementById('verify-action-wrapper');

        const originalText = btnVerify.getAttribute('data-original-text') || 'Verify Badge Now';
        const loadingText = btnVerify.getAttribute('data-loading-text') || 'Scanning...';
        const successText = btnVerify.getAttribute('data-success-text') || 'Verified! Level 3 active status unlocked.';
        const notFoundText = btnVerify.getAttribute('data-not-found-text') || 'Badge not detected yet.';
        const activeText = btnVerify.getAttribute('data-active-text') || 'Active Exhibitor (Level 3)';
        const activeDesc = btnVerify.getAttribute('data-active-desc') || '';

        // Loading state
        btnVerify.setAttribute('disabled', 'true');
        btnVerify.classList.add('opacity-75', 'cursor-not-allowed');
        if (spinner) spinner.classList.remove('hidden');
        if (btnText) btnText.textContent = loadingText;

        try {
          const res = await fetch('/api/badge-verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug }),
          });
          const json = await res.json() as { ok: boolean; error?: string; data?: { verified: boolean; message?: string } };

          if (res.ok && json.ok && json.data?.verified) {
            // Upgrade UI to Level 3 Active
            if (statusPill) {
              statusPill.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold transition-all bg-green-100 text-green-800 border border-green-200';
            }
            if (statusDot) {
              statusDot.className = 'w-2 h-2 rounded-full bg-green-500';
            }
            if (statusText) {
              statusText.textContent = activeText;
            }
            if (statusDesc) {
              statusDesc.textContent = activeDesc;
              statusDesc.classList.remove('hidden');
            }
            if (actionWrapper) {
              actionWrapper.innerHTML = '<span class="inline-flex items-center gap-1.5 text-xs font-bold text-green-700 bg-green-50 px-3 py-1.5 rounded-lg border border-green-200">✓ Level 3 Active</span>';
            }
            alert(successText);
          } else {
            const errorMsg = json.error || json.data?.message || notFoundText;
            alert(errorMsg);
            btnVerify.removeAttribute('disabled');
            btnVerify.classList.remove('opacity-75', 'cursor-not-allowed');
            if (spinner) spinner.classList.add('hidden');
            if (btnText) btnText.textContent = originalText;
          }
        } catch {
          alert('Network error while checking badge. Please try again.');
          btnVerify.removeAttribute('disabled');
          btnVerify.classList.remove('opacity-75', 'cursor-not-allowed');
          if (spinner) spinner.classList.add('hidden');
          if (btnText) btnText.textContent = originalText;
        }
      });
    }
  </script>
</Layout>
