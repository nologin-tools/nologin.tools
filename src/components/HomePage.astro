      const toast = document.getElementById('home-toast');
      const toastMsg = document.getElementById('home-toast-msg');

      const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
      if (bookmarkKey) {
        bookmarkKey.textContent = isMac ? '⌘+D' : 'Ctrl+D';
