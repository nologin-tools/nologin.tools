---
import Layout from '../layouts/Layout.astro';
import HealthBadge from './HealthBadge.astro';
import { getCollection } from 'astro:content';
import { TAG_DEFINITIONS, categoryToSlug, TAG_PAGES_ALLOWLIST, tagValueToSlug } from '../lib/tags';
import { getApprovedTools, getToolHealthStatus, computeScore as computeToolScore, getLocalizedDescription, getToolEditorial } from '../data/loader';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import { LOCALES, DEFAULT_LOCALE, type Locale } from '../i18n/config';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
await loadTranslations(locale);

const approvedTools = getApprovedTools();

const toolsWithMeta = approvedTools.map(tool => {
  const health = getToolHealthStatus(tool);
  const score = computeToolScore(tool, health);
  const editorial = getToolEditorial(tool.slug, locale);
  return { ...tool, health, score, editorial };
});

const allTools = [...toolsWithMeta].sort((a, b) => b.score - a.score);

// Group tools by category
const categoryDef = TAG_DEFINITIONS.find(d => d.key === 'category');
const categoryOrder = categoryDef ? categoryDef.values : [];
type ToolType = (typeof allTools)[number];
const groupMap = new Map<string, ToolType[]>();
for (const cat of categoryOrder) groupMap.set(cat, []);

for (const tool of allTools) {
  const catTag = tool.tags.find(t => t.tagKey === 'category');
  const cat = catTag ? catTag.tagValue : 'Other';
  if (!groupMap.has(cat)) groupMap.set(cat, []);
  groupMap.get(cat)!.push(tool);
}

const categoryGroups: { category: string; tools: ToolType[] }[] = [];
for (const cat of categoryOrder) {
  const catTools = groupMap.get(cat) || [];
  if (catTools.length > 0) categoryGroups.push({ category: cat, tools: catTools });
}
const otherGroupTools = groupMap.get('Other') || [];
if (otherGroupTools.length > 0) categoryGroups.push({ category: 'Other', tools: otherGroupTools });

const editorsChoiceTools = allTools.filter(t => t.editorial?.verdictTier === 'editors-choice');
const totalTools = allTools.length;

// Fetch blog posts for featured guides
const allPosts = await getCollection('blog');
const localePosts = allPosts
  .filter((post) => {
    if (locale === 'en') {
      return !post.id.includes('/');
    }
    return post.id.startsWith(`${locale}/`);
  })
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const isBlogFallback = localePosts.length === 0;
const displayPosts = !isBlogFallback
  ? localePosts
  : allPosts
      .filter((post) => !post.id.includes('/'))
      .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const blogLinkLocale = isBlogFallback ? 'en' as const : locale;
const featuredPosts = displayPosts.slice(0, 4);

function getPostSlug(postId: string): string {
  return postId.includes('/') ? postId.split('/').slice(1).join('/') : postId;
}

function formatDate(date: Date): string {
  return date.toISOString().split('T')[0];
}

function getHostname(url: string): string {
  try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return ''; }
}

function catAnchor(cat: string): string {
  return 'cat-' + cat.toLowerCase().replace(/\s+/g, '-');
}

function translateCategory(cat: string): string {
  const key = `tag.category.${cat}`;
  const translated = t(locale, key);
  return translated === key ? cat : translated;
}

function translateTagValue(key: string, value: string): string {
  const i18nKey = `tag.${key}.${value}`;
  const translated = t(locale, i18nKey);
  return translated === i18nKey ? value : translated;
}
---

<Layout
  title={t(locale, 'home.title')}
  description={t(locale, 'home.description', { count: String(approvedTools.length) })}
  hideHeader
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "nologin.tools",
    "url": "https://nologin.tools",
    "description": t(locale, 'home.description', { count: String(approvedTools.length) }),
    "inLanguage": locale,
    "publisher": {
      "@id": "https://nologin.tools/#organization"
    },
    "about": {
      "@type": "Thing",
      "name": "No-Login Web Tools",
      "description": "A curated directory of privacy-friendly online tools that work without login or accounts."
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": t(locale, 'home.jsonLd.itemListName'),
    "numberOfItems": allTools.length,
    "inLanguage": locale,
    "itemListElement": allTools.map((tool, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": tool.name,
      "url": `https://nologin.tools${getLocalizedPath(`/tool/${tool.slug}`, locale)}`,
    })),
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://nologin.tools/#organization",
    "name": "NoLoginTools.org",
    "url": "https://nologintools.org",
    "logo": {
      "@type": "ImageObject",
      "url": "https://nologin.tools/og-default.png",
      "width": 1200,
      "height": 630,
    },
    "description": t(locale, 'home.jsonLd.orgDescription'),
    "foundingDate": "2025",
    "sameAs": [
      "https://x.com/nologin_tools",
      "https://github.com/nologin-tools",
    ],
    "knowsAbout": [
      "Privacy Tools",
      "No-Login Web Software",
      "Client-Side Data Processing",
      "Open Source Software",
      "Browser Utilities"
    ],
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "inLanguage": locale,
    "mainEntity": [
      {
        "@type": "Question",
        "name": t(locale, 'home.faq.q1'),
        "acceptedAnswer": { "@type": "Answer", "text": t(locale, 'home.faq.a1') },
      },
      {
        "@type": "Question",
        "name": t(locale, 'home.faq.q2'),
        "acceptedAnswer": { "@type": "Answer", "text": t(locale, 'home.faq.a2') },
      },
      {
        "@type": "Question",
        "name": t(locale, 'home.faq.q3'),
        "acceptedAnswer": { "@type": "Answer", "text": t(locale, 'home.faq.a3') },
      },
    ],
  })} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <!-- Hero -->
    <header class="mb-16 border-b-4 border-neutral-900 pb-8">
      <div class="flex items-start justify-between">
        <h1 class="text-4xl sm:text-5xl font-black text-neutral-900 mb-4 tracking-tight uppercase italic">
          nologin.tools
        </h1>
        <LanguageSwitcher locale={locale} />
      </div>
      <p class="text-xl text-neutral-700 font-medium mb-6">
        {t(locale, 'home.tagline')} <span class="bg-yellow-200 px-1">{t(locale, 'home.taglineHighlight')}</span>
      </p>
      <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-retro-mono font-bold uppercase tracking-wider items-center">
        <span class="text-neutral-500">{t(locale, 'home.toolsVerified', { count: totalTools })}</span>
        <a href={getLocalizedPath('/finder', locale)} class="text-neutral-900 font-black hover:bg-neutral-900 hover:text-white px-1 transition-colors">🔍 {t(locale, 'nav.finder')}</a>
        <a href={getLocalizedPath('/submit', locale)} class="text-neutral-900 hover:bg-neutral-900 hover:text-white px-1 transition-colors">{t(locale, 'nav.submit')}</a>
        <a href={getLocalizedPath('/blog', locale)} class="text-neutral-900 hover:bg-neutral-900 hover:text-white px-1 transition-colors">{t(locale, 'nav.blog')}</a>
        <a href={getLocalizedPath('/badge', locale)} class="text-neutral-900 hover:bg-neutral-900 hover:text-white px-1 transition-colors">{t(locale, 'nav.badge')}</a>
        <a href={getLocalizedPath('/about', locale)} class="text-neutral-900 hover:bg-neutral-900 hover:text-white px-1 transition-colors">{t(locale, 'nav.about')}</a>

        <button id="bookmark-btn" class="hidden sm:inline-flex items-center gap-2 px-2 py-1 bg-yellow-300 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] text-[11px] font-black uppercase tracking-tight hover:bg-yellow-400 transition-all active:translate-x-[1px] active:translate-y-[1px] active:shadow-none ml-2 cursor-pointer">
          <span class="text-sm">★</span>
          <span>{t(locale, 'nav.bookmark')} <span id="bookmark-key" class="bg-white/50 px-1">Ctrl+D</span></span>
        </button>
      </div>

      <!-- Non-blocking toast -->
      <div
        id="home-toast"
        role="status"
        aria-live="polite"
        class="hidden fixed bottom-6 right-6 z-50 bg-neutral-900 text-white border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] px-4 py-2.5 text-xs font-mono font-bold flex items-center gap-2 transition-opacity"
      >
        <span class="text-yellow-400">★</span>
        <span id="home-toast-msg"></span>
      </div>
    </header>

    <script>
      const bookmarkKey = document.getElementById('bookmark-key');
      const bookmarkBtn = document.getElementById('bookmark-btn');
      const toast = document.getElementById('home-toast');
      const toastMsg = document.getElementById('home-toast-msg');

      const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
      if (bookmarkKey) {
        bookmarkKey.textContent = isMac ? '⌘+D' : 'Ctrl+D';
      }

      let toastTimer: any = null;
      bookmarkBtn?.addEventListener('click', () => {
        const shortcut = isMac ? '⌘+D' : 'Ctrl+D';
        if (toast && toastMsg) {
          toastMsg.textContent = `Press ${shortcut} to bookmark this site`;
          toast.classList.remove('hidden');
          clearTimeout(toastTimer);
          toastTimer = setTimeout(() => {
            toast.classList.add('hidden');
          }, 2500);
        }
      });
    </script>

    <!-- Category Navigation -->
    <nav class="mb-6 text-sm text-retro-mono" aria-label="Category navigation">
      <div class="flex flex-wrap gap-x-3 gap-y-2 items-center">
        {editorsChoiceTools.length > 0 && (
          <a
            href="#editors-choice"
            class="px-2.5 py-1 border-2 border-amber-500 bg-amber-100/90 text-amber-950 hover:bg-amber-200 transition-all uppercase font-bold shadow-[2px_2px_0px_0px_rgba(217,119,6,1)] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none"
          >
            {t(locale, 'home.editorsChoiceSpotlight', { count: String(editorsChoiceTools.length) })}
          </a>
        )}
        {categoryGroups.map((group) => (
          <a
            href={`#${catAnchor(group.category)}`}
            class="px-2 py-1 border border-neutral-200 hover:border-neutral-900 hover:bg-neutral-900 hover:text-white transition-all uppercase font-bold"
          >
            {translateCategory(group.category)}
          </a>
        ))}
      </div>
    </nav>

    <!-- Trust Tags / Verification Standards -->
    <div class="mb-12">
      <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-400 mb-2">
        {t(locale, 'home.trustTags')}
      </div>
      <div class="flex flex-wrap gap-2">
        {TAG_PAGES_ALLOWLIST.map((tag) => (
          <a
            href={getLocalizedPath(`/tag/${tagValueToSlug(tag.value)}`, locale)}
            class="px-2.5 py-1 text-xs font-mono font-bold bg-neutral-50 text-neutral-700 border border-neutral-200 hover:border-neutral-900 hover:bg-neutral-900 hover:text-white transition-all"
          >
            #{translateTagValue(tag.key, tag.value)}
          </a>
        ))}
      </div>
    </div>

    <!-- Featured In-Depth Guides & Analysis -->
    {featuredPosts.length > 0 && (
      <section class="mb-16 border-t-2 border-b-2 border-neutral-900 py-8 bg-neutral-50/50" aria-label="Featured guides">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-6">
          <h2 class="text-base font-black uppercase tracking-tight text-neutral-900 flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-neutral-900 inline-block"></span>
            {t(locale, 'home.featuredGuides')}
          </h2>
          <a
            href={getLocalizedPath('/blog', locale)}
            class="text-xs font-bold text-neutral-600 hover:text-neutral-900 hover:underline uppercase tracking-wider font-mono"
          >
            {t(locale, 'home.viewAllArticles', { count: String(displayPosts.length) })}
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {featuredPosts.map((post) => (
            <article class="border border-neutral-200 bg-white p-5 hover:border-neutral-900 transition-all flex flex-col justify-between">
              <div>
                <time class="text-[11px] font-mono font-bold text-neutral-400 uppercase tracking-wider">
                  {formatDate(post.data.publishedAt)}
                </time>
                <h3 class="text-base font-bold text-neutral-900 mt-1 mb-2 leading-snug">
                  <a
                    href={getLocalizedPath(`/blog/${getPostSlug(post.id)}`, blogLinkLocale)}
                    class="hover:underline decoration-1 underline-offset-2"
                  >
                    {post.data.title}
                  </a>
                </h3>
                <p class="text-neutral-600 text-xs leading-relaxed line-clamp-2 mb-4">
                  {post.data.description}
                </p>
              </div>
              <div class="pt-3 border-t border-neutral-100 flex items-center justify-between text-xs font-mono">
                <span class="text-neutral-400">{post.data.author}</span>
                <a
                  href={getLocalizedPath(`/blog/${getPostSlug(post.id)}`, blogLinkLocale)}
                  class="font-bold text-neutral-900 hover:underline"
                >
                  {t(locale, 'blog.readMore')} &rarr;
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Tool Lists by Category -->
    <div class="space-y-16">
      <!-- Editor's Choice Workstations Showcase -->
      {editorsChoiceTools.length > 0 && (
        <section id="editors-choice" class="scroll-mt-10 bg-amber-50/50 border-2 border-amber-300/90 p-5 sm:p-6 shadow-[3px_3px_0px_0px_rgba(217,119,6,0.25)]">
          <div class="border-b-2 border-amber-400/80 pb-3 mb-4">
            <h2 class="text-xl sm:text-2xl font-black text-amber-950 uppercase tracking-tight flex items-baseline justify-between">
              <span>
                👑 {t(locale, 'home.editorsChoiceHeading')} <span class="ml-2 text-sm font-bold text-amber-700">[{editorsChoiceTools.length}]</span>
              </span>
            </h2>
            <p class="text-xs sm:text-sm text-amber-900/80 mt-1 leading-relaxed font-sans">
              {t(locale, 'home.editorsChoiceSubtitle')}
            </p>
          </div>
          <ul class="divide-y divide-amber-200/50">
            {editorsChoiceTools.map((tool) => {
              const hostname = getHostname(tool.url);
              return (
                <li class="tool-item group py-2.5">
                  <div class="flex items-start gap-3 min-w-0 flex-1">
                    <img
                      src={`https://www.google.com/s2/favicons?domain=${hostname}&sz=32`}
                      alt={tool.name}
                      width="16"
                      height="16"
                      class="w-4 h-4 mt-1.5 shrink-0 grayscale group-hover:grayscale-0 transition-all"
                      loading="lazy"
                      onerror={`this.style.display='none'`}
                    />
                    <div class="min-w-0 flex flex-col flex-1">
                      <div class="flex items-center gap-2 min-w-0 flex-wrap">
                        {tool.isFeatured && (
                          <span class="text-yellow-600 shrink-0 text-xs font-mono" title={t(locale, 'common.featured')}>★</span>
                        )}
                        {tool.badgeDisplayType === 'explicit' && (
                          <span class="text-green-600 shrink-0 inline-flex items-center" title={t(locale, 'tool.badgeActiveDesc')}>
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                              <polyline points="9 12 11 14 15 10"></polyline>
                            </svg>
                          </span>
                        )}
                        <a
                          href={getLocalizedPath(`/tool/${tool.slug}`, locale)}
                          class="font-bold text-lg text-neutral-900 hover:underline decoration-2 underline-offset-4"
                        >
                          {tool.name}
                        </a>
                        <a
                          href={tool.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-neutral-400 hover:text-neutral-900 text-xs font-mono transition-colors hidden sm:inline"
                        >
                          ({hostname})
                        </a>
                        {tool.editorial?.productScore && (
                          <a
                            href={getLocalizedPath(`/tool/${tool.slug}`, locale)}
                            class="inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-mono font-bold border transition-colors shrink-0 bg-amber-100 text-amber-950 border-amber-400 hover:bg-amber-200"
                            title={tool.editorial.benchmarkNotes || t(locale, 'tool.productScore.badgeTitle', { score: String(tool.editorial.productScore.overall) })}
                          >
                            <span>⚡ {tool.editorial.productScore.overall}</span>
                            <span class="font-bold">· {t(locale, 'tool.productScore.tier.editorsChoice')}</span>
                          </a>
                        )}
                      </div>
                      {getLocalizedDescription(tool, locale) && (
                        <p class="text-neutral-700 text-sm leading-relaxed mt-0.5">
                          {getLocalizedDescription(tool, locale)}
                        </p>
                      )}
                    </div>
                  </div>
                  <div class="shrink-0 self-start sm:self-center pl-2">
                    <HealthBadge status={tool.health?.status ?? null} lastCheckedAt={null} locale={locale} />
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      )}
      {categoryGroups.map((group) => (
        <section id={catAnchor(group.category)} class="scroll-mt-10">
          <h2 class="category-heading uppercase flex items-baseline justify-between">
            <span>
              {translateCategory(group.category)} <span class="ml-2 text-sm font-normal text-neutral-400">[{group.tools.length}]</span>
            </span>
            {group.category !== 'Other' && (
              <a
                href={getLocalizedPath(`/category/${categoryToSlug(group.category)}`, locale)}
                class="text-xs font-bold text-neutral-400 hover:text-neutral-900 hover:underline decoration-2 underline-offset-4 normal-case not-italic"
              >
                {t(locale, 'category.page.viewAll')}
              </a>
            )}
          </h2>
          <ul class="mt-4">
            {group.tools.map((tool) => {
              const hostname = getHostname(tool.url);
              return (
                <li class="tool-item group">
                  <div class="flex items-start gap-3 min-w-0 flex-1">
                    <img
                      src={`https://www.google.com/s2/favicons?domain=${hostname}&sz=32`}
                      alt={tool.name}
                      width="16"
                      height="16"
                      class="w-4 h-4 mt-1.5 shrink-0 grayscale group-hover:grayscale-0 transition-all"
                      loading="lazy"
                      onerror={`this.style.display='none'`}
                    />
                    <div class="min-w-0 flex flex-col flex-1">
                      <div class="flex items-center gap-2 min-w-0 flex-wrap">
                        {tool.isFeatured && (
                          <span class="text-yellow-600 shrink-0 text-xs font-mono" title={t(locale, 'common.featured')}>★</span>
                        )}
                        {tool.badgeDisplayType === 'explicit' && (
                          <span class="text-green-600 shrink-0 inline-flex items-center" title={t(locale, 'tool.badgeActiveDesc')}>
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                              <polyline points="9 12 11 14 15 10"></polyline>
                            </svg>
                          </span>
                        )}
                        <a
                          href={getLocalizedPath(`/tool/${tool.slug}`, locale)}
                          class="font-bold text-lg text-neutral-900 hover:underline decoration-2 underline-offset-4"
                        >
                          {tool.name}
                        </a>
                        <a
                          href={tool.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-neutral-400 hover:text-neutral-900 text-xs font-mono transition-colors hidden sm:inline"
                        >
                          ({hostname})
                        </a>
                        {tool.editorial?.productScore && (
                          <a
                            href={getLocalizedPath(`/tool/${tool.slug}`, locale)}
                            class:list={[
                              "inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-mono font-bold border transition-colors shrink-0",
                              tool.editorial.verdictTier === 'editors-choice'
                                ? "bg-amber-100/90 text-amber-950 border-amber-400 hover:bg-amber-200"
                                : tool.editorial.verdictTier === 'highly-recommended'
                                ? "bg-emerald-50 text-emerald-950 border-emerald-300 hover:bg-emerald-100"
                                : "bg-neutral-100 text-neutral-800 border-neutral-300 hover:bg-neutral-200"
                            ]}
                            title={tool.editorial.benchmarkNotes || t(locale, 'tool.productScore.badgeTitle', { score: String(tool.editorial.productScore.overall) })}
                          >
                            <span>⚡ {tool.editorial.productScore.overall}</span>
                            {tool.editorial.verdictTier === 'editors-choice' && (
                              <span class="hidden md:inline font-bold">· {t(locale, 'tool.productScore.tier.editorsChoice')}</span>
                            )}
                          </a>
                        )}
                      </div>
                      {getLocalizedDescription(tool, locale) && (
                        <p class="text-neutral-600 text-sm leading-relaxed mt-0.5">
                          {getLocalizedDescription(tool, locale)}
                        </p>
                      )}
                    </div>
                  </div>
                  <div class="shrink-0 self-start sm:self-center pl-2">
                    <HealthBadge status={tool.health?.status ?? null} lastCheckedAt={null} locale={locale} />
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <!-- FAQ -->
    <section class="mt-16 border-t border-neutral-200 pt-8">
      <h2 class="text-lg font-bold text-neutral-900 mb-6 uppercase">{t(locale, 'home.faq.heading')}</h2>
      <dl class="space-y-4">
        {[
          { q: t(locale, 'home.faq.q1'), a: t(locale, 'home.faq.a1') },
          { q: t(locale, 'home.faq.q2'), a: t(locale, 'home.faq.a2') },
          { q: t(locale, 'home.faq.q3'), a: t(locale, 'home.faq.a3') },
        ].map((faq) => (
          <div>
            <dt class="text-sm font-bold text-neutral-700">{faq.q}</dt>
            <dd class="mt-1 text-sm text-neutral-500">{faq.a}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>

</Layout>
