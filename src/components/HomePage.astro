---
import Layout from '../layouts/Layout.astro';
import TestedWorkflowLinks from './TestedWorkflowLinks.astro';
import HealthBadge from './HealthBadge.astro';
import { getCollection } from 'astro:content';
import { TAG_DEFINITIONS, categoryToSlug, TAG_PAGES_ALLOWLIST, tagValueToSlug } from '../lib/tags';
import { getApprovedTools, getToolHealthStatus, computeScore as computeToolScore, getLocalizedDescription, getToolEditorial, getToolContentDate } from '../data/loader';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import { LOCALES, DEFAULT_LOCALE, type Locale } from '../i18n/config';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getAlternativeTargets } from '../lib/alternatives';
import { getComparisonPairs } from '../lib/comparisons';
import { getWorkflowRecipes } from '../lib/workflows';
import { CURATED_COLLECTIONS } from '../lib/collections';
import { CHROME_STORE_URL } from '../lib/extension';
import extManifest from '../../packages/extension/manifest.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
await loadTranslations(locale);
const isZh = locale === 'zh';
const l = (zh: string, en: string) => (isZh ? zh : en);
const extVersion = extManifest?.version || '2.0.0';

const approvedTools = getApprovedTools();

const toolsWithMeta = approvedTools.map(tool => {
  const health = getToolHealthStatus(tool);
  const score = computeToolScore(tool, health);
  const editorial = getToolEditorial(tool.slug, locale);
  return { ...tool, health, score, editorial };
});

const allTools = [...toolsWithMeta].sort((a, b) => b.score - a.score);

const latestApprovedAt = approvedTools.map(tool => getToolContentDate(tool, locale)).filter(Boolean).sort().at(-1);

// Group tools by category
const categoryDef = TAG_DEFINITIONS.find(d => d.key === 'category');
const categoryOrder = categoryDef ? categoryDef.values : [];
type ToolType = (typeof allTools)[number];
const groupMap = new Map<string, ToolType[]>();
for (const cat of categoryOrder) groupMap.set(cat, []);

for (const tool of allTools) {
  const catTag = tool.tags.find(t => t.tagKey === 'category');
  const cat = catTag ? catTag.tagValue : 'Other';
  if (!groupMap.has(cat)) groupMap.set(cat, []);
  groupMap.get(cat)!.push(tool);
}

const categoryGroups: { category: string; tools: ToolType[] }[] = [];
for (const cat of categoryOrder) {
  const catTools = groupMap.get(cat) || [];
  if (catTools.length > 0) categoryGroups.push({ category: cat, tools: catTools });
}
const otherGroupTools = groupMap.get('Other') || [];
if (otherGroupTools.length > 0) categoryGroups.push({ category: 'Other', tools: otherGroupTools });

const editorsChoiceTools = allTools.filter(t => t.editorial?.verdictTier === 'editors-choice');
const totalTools = allTools.length;

// Fetch blog posts for featured guides
const allPosts = await getCollection('blog');
const localePosts = allPosts
  .filter((post) => {
    if (locale === 'en') {
      return !post.id.includes('/');
    }
    return post.id.startsWith(`${locale}/`);
  })
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const isBlogFallback = localePosts.length === 0;
const displayPosts = !isBlogFallback
  ? localePosts
  : allPosts
      .filter((post) => !post.id.includes('/'))
      .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const blogLinkLocale = isBlogFallback ? 'en' as const : locale;
const featuredPosts = displayPosts.slice(0, 4);

function getPostSlug(postId: string): string {
  return postId.includes('/') ? postId.split('/').slice(1).join('/') : postId;
}

function formatDate(date: Date): string {
  return date.toISOString().split('T')[0];
}

function getHostname(url: string): string {
  try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return ''; }
}

function catAnchor(cat: string): string {
  return 'cat-' + cat.toLowerCase().replace(/\s+/g, '-');
}

function translateCategory(cat: string): string {
  const key = `tag.category.${cat}`;
  const translated = t(locale, key);
  return translated === key ? cat : translated;
}

function translateTagValue(key: string, value: string): string {
  const i18nKey = `tag.${key}.${value}`;
  const translated = t(locale, i18nKey);
  return translated === i18nKey ? value : translated;
}
---

