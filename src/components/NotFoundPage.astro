---
import Layout from '../layouts/Layout.astro';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import { categoryToSlug } from '../lib/tags';
import { getApprovedTools, getLocalizedDescription } from '../data/loader';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
await loadTranslations(locale);

const approvedTools = getApprovedTools();
const featuredSlugs = ['photopea-com', 'excalidraw-com', 'squoosh-app', 'tools-pdf24-org-en'];
const popularTools = featuredSlugs
  .map(slug => approvedTools.find(t => t.slug === slug))
  .filter((tool): tool is NonNullable<typeof tool> => Boolean(tool));

const popularCategories = ['AI', 'Design', 'Development', 'Privacy', 'Productivity'];

function translateCategory(cat: string): string {
  const key = `tag.category.${cat}`;
  const translated = t(locale, key);
  return translated === key ? cat : translated;
}
---

<Layout title={t(locale, 'notFound.title')} description={t(locale, 'notFound.description')} locale={locale} noindex>
  <div class="max-w-3xl mx-auto px-6 py-16 text-center">
    <div class="border-b-4 border-neutral-900 pb-8 mb-12">
      <h1 class="text-7xl font-black text-neutral-900 mb-4 tracking-tight uppercase italic">{t(locale, 'notFound.heading')}</h1>
      <p class="text-xl font-bold text-neutral-800 mb-2">{t(locale, 'notFound.message')}</p>
      <p class="text-sm text-neutral-500 max-w-md mx-auto">
        {t(locale, 'notFound.detail')}
      </p>
    </div>

    <!-- Recovery Navigation -->
    <div class="text-left space-y-10">
      <!-- Popular Categories -->
      <section>
        <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500 mb-3">
          {t(locale, 'notFound.popularCategories')}
        </h2>
        <div class="flex flex-wrap gap-2">
          {popularCategories.map((cat) => (
            <a
              href={getLocalizedPath(`/category/${categoryToSlug(cat)}`, locale)}
              class="px-3 py-1.5 text-xs font-mono font-bold border-2 border-neutral-900 bg-white shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-yellow-50 transition-none uppercase"
            >
              {translateCategory(cat)}
            </a>
          ))}
        </div>
      </section>

      <!-- Popular Verified Tools -->
      <section>
        <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500 mb-3">
          {t(locale, 'notFound.featuredTools')}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {popularTools.map((tool) => (
            <a
              href={getLocalizedPath(`/tool/${tool.slug}`, locale)}
              class="border-2 border-neutral-900 p-4 bg-white shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-yellow-50 hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] transition-none block group"
            >
              <div class="font-bold text-sm text-neutral-900 group-hover:underline decoration-1 underline-offset-2 flex items-center justify-between">
                <span>{tool.name}</span>
                <span class="text-xs font-mono text-neutral-500 group-hover:text-neutral-900">&rarr;</span>
              </div>
              {getLocalizedDescription(tool, locale) && (
                <p class="text-xs text-neutral-600 mt-1 line-clamp-2">
                  {getLocalizedDescription(tool, locale)}
                </p>
              )}
            </a>
          ))}
        </div>
      </section>
    </div>

    <div class="mt-12 pt-8 border-t-2 border-neutral-900">
      <a
        href={getLocalizedPath('/', locale)}
        class="btn-primary inline-block px-5 py-2.5 text-xs font-mono font-bold uppercase tracking-wider shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px]"
      >
        &larr; {t(locale, 'notFound.backHome')}
      </a>
    </div>
  </div>
</Layout>
