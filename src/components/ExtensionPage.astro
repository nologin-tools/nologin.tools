---
import Layout from '../layouts/Layout.astro';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import { CHROME_STORE_URL, EXTENSION_SOURCE_URL } from '../lib/extension';
import { getApprovedTools } from '../data/loader';
import { getAlternativeTargets } from '../lib/alternatives';
import extManifest from '../../packages/extension/manifest.json';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
await loadTranslations(locale);

const isZh = locale === 'zh';
const l = (zh: string, en: string) => (isZh ? zh : en);

const approvedTools = getApprovedTools();
const totalTools = approvedTools.length;
const alternativeTargets = getAlternativeTargets();
const extVersion = extManifest?.version || '2.0.0';
const indexJsonPath = isZh ? '/zh/api/extension-index.json' : '/api/extension-index.json';

const title = t(locale, 'extension.title');
const description = t(locale, 'extension.description');

const extensionLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'NoLogin Tools — Zero-Signup Switcher & Privacy Benchmark',
  operatingSystem: 'Chrome, Brave, Edge, Arc, Ego, Firefox',
  applicationCategory: 'BrowserApplication',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  url: CHROME_STORE_URL,
  installUrl: CHROME_STORE_URL,
  downloadUrl: 'https://nologin.tools/downloads/nologin-quick-switcher-chrome.zip',
  softwareVersion: extVersion,
  description: description,
  author: {
    '@type': 'Organization',
    name: 'NoLoginTools.org',
    url: 'https://nologintools.org',
  },
};
---

<Layout title={title} description={description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(extensionLd)} />
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    {/* Breadcrumbs */}
    <nav class="mb-8 text-xs text-neutral-500 font-mono flex items-center gap-2">
      <a href={getLocalizedPath('/', locale)} class="hover:underline hover:text-neutral-900">{t(locale, 'common.home')}</a>
      <span>/</span>
      <span class="text-neutral-900 font-semibold">{t(locale, 'nav.extension')}</span>
    </nav>

    {/* Hero Section */}
    <header class="mb-14 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-bold bg-yellow-300 text-neutral-900 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] uppercase tracking-wider mb-6 font-mono">
        <span>🛡️</span>
        <span>{t(locale, 'extension.hero.badge')}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-neutral-900 tracking-tight uppercase italic mb-5">
        {t(locale, 'extension.hero.heading')}
      </h1>

      <p class="text-base sm:text-lg text-neutral-700 leading-relaxed mb-8">
        {t(locale, 'extension.hero.subtitle')}
      </p>

      {/* Live Catalog Coverage Bar */}
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8 text-left font-mono">
        <div class="bg-white border-2 border-neutral-900 p-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
          <div class="text-xl font-black text-emerald-700">{totalTools}+</div>
          <div class="text-[11px] text-neutral-600 font-bold uppercase">{l('CADES 实测免登录工具', 'CADES Verified Tools')}</div>
        </div>
        <div class="bg-white border-2 border-neutral-900 p-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
          <div class="text-xl font-black text-amber-600">55+</div>
          <div class="text-[11px] text-neutral-600 font-bold uppercase">{l('封闭 SaaS 域名拦截平替', 'SaaS Paywall Switchers')}</div>
        </div>
        <div class="bg-white border-2 border-neutral-900 p-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
          <div class="text-xl font-black text-neutral-900">30+</div>
          <div class="text-[11px] text-neutral-600 font-bold uppercase">{l('全球与 AI 搜索引擎支持', 'Search & AI Engines')}</div>
        </div>
        <div class="bg-white border-2 border-neutral-900 p-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
          <div class="text-xl font-black text-sky-700">0 DOM</div>
          <div class="text-[11px] text-neutral-600 font-bold uppercase">{l('工具画布零悬浮窗遮挡', 'Workspace Clutter')}</div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3.5">
        <a
          href={CHROME_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-6 py-3.5 bg-emerald-600 text-white font-mono text-xs sm:text-sm font-black uppercase tracking-wider border-2 border-neutral-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:bg-emerald-500 hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] transition-all cursor-pointer"
        >
          <span class="text-base">🌐</span>
          <span>{t(locale, 'extension.btn.chromestore')} ↗</span>
        </a>

        <a
          href="/downloads/nologin-quick-switcher-chrome.zip"
          download="nologin-quick-switcher-chrome.zip"
          class="inline-flex items-center gap-2 px-4 py-3.5 bg-white text-neutral-900 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-neutral-100 transition-none active:translate-x-[2px] active:translate-y-[2px] active:shadow-none cursor-pointer"
        >
          <span>📦</span>
          <span>{t(locale, 'extension.btn.download')}</span>
        </a>

        <a
          href={indexJsonPath}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-3.5 bg-yellow-100 text-neutral-900 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-yellow-200 transition-none"
        >
          <span>📊</span>
          <span>{l('查看实时索引 JSON ↗', 'Inspect Live Index JSON ↗')}</span>
        </a>

        <a
          href={EXTENSION_SOURCE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-3.5 bg-neutral-100 text-neutral-700 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-neutral-200 transition-none"
        >
          <span>🐙</span>
          <span>{t(locale, 'extension.btn.github')}</span>
        </a>
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5 text-xs text-neutral-500 font-mono">
        <span class="px-2 py-0.5 bg-emerald-100 text-emerald-900 font-bold border border-emerald-400">✓ {l('Chrome 官方商店已上架', 'Chrome Web Store Verified')}</span>
        <span>·</span>
        <span>{l('24h 自动静默热更新', '24h Silent Index Sync')}</span>
        <span>·</span>
        <span>{l('中英双语自适应', 'EN / 中文 Bilingual')}</span>
        <span>·</span>
        <span class="font-bold text-neutral-900">Chrome / Edge / Brave / Arc / Ego / Firefox</span>
      </div>
    </header>

    {/* Interactive 3-Scenario Browser Sandbox */}
    <section class="mb-16">
      <div class="text-center mb-6">
        <h2 class="text-xl sm:text-2xl font-black text-neutral-900 uppercase italic tracking-tight font-mono mb-2">
          {t(locale, 'extension.demo.title')}
        </h2>
        <p class="text-xs sm:text-sm text-neutral-600 max-w-2xl mx-auto font-mono">
          {t(locale, 'extension.demo.desc')}
        </p>
      </div>

      {/* Scenario Switcher Tabs */}
      <div class="flex flex-wrap gap-2 mb-4 font-mono">
        <button
          type="button"
          data-demo-tab="serp"
          class="demo-tab-btn px-3.5 py-2 text-xs font-black uppercase border-2 border-neutral-900 bg-neutral-900 text-white shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] cursor-pointer"
        >
          🔍 {l('场景 1：搜索引擎 (SERP) 实测条与对比栏', '1. Search Engine (SERP) Truth Badges')}
        </button>
        <button
          type="button"
          data-demo-tab="paywall"
          class="demo-tab-btn px-3.5 py-2 text-xs font-black uppercase border-2 border-neutral-900 bg-white text-neutral-800 hover:bg-yellow-100 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] cursor-pointer"
        >
          ⚡ {l('场景 2：访问封闭 SaaS 付费墙 (ProStudio)', '2. SaaS Paywall Auto-Switcher (ProStudio)')}
        </button>
        <button
          type="button"
          data-demo-tab="verified"
          class="demo-tab-btn px-3.5 py-2 text-xs font-black uppercase border-2 border-neutral-900 bg-white text-neutral-800 hover:bg-emerald-50 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] cursor-pointer"
        >
          🛡️ {l('场景 3：访问已验证工具 5D 角标 (Photopea)', '3. Verified Tool 5D Lab HUD (Photopea)')}
        </button>
      </div>

      <div class="bg-white border-2 border-neutral-900 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] overflow-hidden">
        {/* Mockup Browser Chrome Bar */}
        <div class="bg-neutral-100 border-b-2 border-neutral-900 px-4 py-3 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 shrink-0">
            <span class="w-3 h-3 bg-red-400 border border-neutral-900 inline-block"></span>
            <span class="w-3 h-3 bg-yellow-400 border border-neutral-900 inline-block"></span>
            <span class="w-3 h-3 bg-green-400 border border-neutral-900 inline-block"></span>
          </div>

          <div class="flex-1 max-w-xl">
            <div class="bg-white border-2 border-neutral-900 px-3 py-1 text-xs font-mono text-neutral-800 flex items-center justify-between gap-2">
              <span id="demo-address" class="truncate">https://www.google.com/search?q=online+image+editor+no+signup</span>
              <span class="text-neutral-500 text-[10px] font-bold shrink-0">🔒 HTTPS</span>
            </div>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <span class="px-2.5 py-1 bg-neutral-900 text-white font-mono text-[11px] font-bold border border-neutral-900 flex items-center gap-1.5">
              <span>🛡️</span>
              <span id="demo-toolbar-badge" class="bg-emerald-600 text-white px-1.5 py-0.2 text-[10px] font-black">SERP</span>
            </span>
          </div>
        </div>

        {/* Scenario 1: SERP Inline Badges + Multi-Tool Comparison Bar */}
        <div id="demo-panel-serp" class="p-6 sm:p-8 bg-neutral-50 space-y-5 font-sans">
          {/* Top SERP Summary Bar */}
          <div class="bg-emerald-50 border-2 border-emerald-600 rounded px-3.5 py-2.5 flex flex-wrap items-center justify-between gap-3 text-xs">
            <div class="text-emerald-950">
              <strong class="text-emerald-700 font-bold">🛡️ nologin.tools：</strong>
              <span>{l('已为本页结果匹配 3 款免登录工具（Photopea ⚡95 · Squoosh ⚡95 · Excalidraw ⚡96）', '3 verified zero-login tools matched for this search (Photopea ⚡95 · Squoosh ⚡95 · Excalidraw ⚡96)')}</span>
            </div>
            <div class="flex items-center gap-3 font-bold text-emerald-800 shrink-0">
              <a href={getLocalizedPath('/compare/squoosh-vs-tinypng', locale)} class="underline hover:text-emerald-950">
                ⚔️ {l('Squoosh vs TinyPNG 对比 ↗', 'Squoosh vs TinyPNG ↗')}
              </a>
              <a href={getLocalizedPath('/finder', locale)} class="underline hover:text-emerald-950">
                {l('免登录罗盘 ↗', 'No-Login Finder ↗')}
              </a>
            </div>
          </div>

          {/* Search Result 1: Verified Tool */}
          <div class="bg-white border border-neutral-200 p-4 rounded shadow-xs space-y-1.5">
            <div class="text-[11px] text-neutral-500 font-mono">https://www.photopea.com</div>
            <div class="text-base font-bold text-blue-700">Photopea | Online Photo Editor — PSD, AI, XD, Sketch</div>
            {/* Injected Verified Strip */}
            <div class="inline-flex flex-wrap items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-50 border border-emerald-300 text-xs text-emerald-950 font-medium">
              <strong class="text-emerald-800 font-bold">✓ {l('NoLogin 已验证', 'NoLogin Verified')}</strong>
              <span class="px-1.5 py-0.5 rounded bg-[#08695d] text-white text-[11px] font-extrabold">95/100</span>
              <span class="text-neutral-400">·</span>
              <span class="text-emerald-800 font-semibold">{l('★ 编辑精选', "★ Editor's Choice")}</span>
              <span class="text-neutral-400">·</span>
              <span class="text-emerald-800 font-semibold">{l('本地处理', '100% Local')}</span>
              <span class="text-neutral-400">·</span>
              <a href={getLocalizedPath('/tool/photopea-com', locale)} class="text-emerald-800 font-bold underline">
                {l('实测档案 ↗', 'Lab Report ↗')}
              </a>
            </div>
            <p class="text-xs text-neutral-600">
              Free online photo editor supporting PSD, XCF, Sketch, XD and CDR formats. Runs locally in WebAssembly memory.
            </p>
          </div>

          {/* Search Result 2: Paywalled SaaS Target */}
          <div class="bg-white border border-neutral-200 p-4 rounded shadow-xs space-y-1.5">
            <div class="text-[11px] text-neutral-500 font-mono">https://prostudio.example › photo-editor</div>
            <div class="text-base font-bold text-blue-700">ProStudio Cloud — Online Photo Editor & Graphic Design Suite</div>
            {/* Injected Paywall Switch Strip */}
            <div class="inline-flex flex-wrap items-center gap-1.5 px-2.5 py-1 rounded bg-amber-50 border border-amber-300 text-xs text-amber-950 font-medium">
              <strong class="text-amber-800 font-bold">{l('需登录/付费墙 · 免登录平替：', 'Signup Wall · No-Login Switch:')}</strong>
              <a href={getLocalizedPath('/tool/photopea-com', locale)} class="inline-flex items-center gap-1 px-1.5 py-0.5 bg-white border border-amber-300 rounded text-amber-900 font-bold hover:underline">
                <span>Photopea</span>
                <span class="px-1 py-0.2 rounded bg-[#08695d] text-white text-[10px] font-extrabold">95</span>
                <span>↗</span>
              </a>
              <span class="text-neutral-400">·</span>
              <a href={getLocalizedPath('/tool/excalidraw-com', locale)} class="inline-flex items-center gap-1 px-1.5 py-0.5 bg-white border border-amber-300 rounded text-amber-900 font-bold hover:underline">
                <span>Excalidraw</span>
                <span class="px-1 py-0.2 rounded bg-[#08695d] text-white text-[10px] font-extrabold">96</span>
                <span>↗</span>
              </a>
              <span class="text-neutral-400">·</span>
              <a href={getLocalizedPath('/category/design', locale)} class="text-amber-800 font-bold underline">
                {l('全部 4 款对比 ↗', 'Compare all 4 ↗')}
              </a>
            </div>
            <p class="text-xs text-neutral-600">
              Create designs with ProStudio Cloud. Sign up with email or social account and start a subscription trial to export HD files.
            </p>
          </div>
        </div>

        {/* Scenario 2: Visiting Paywalled SaaS (ProStudio) */}
        <div id="demo-panel-paywall" class="hidden p-6 sm:p-8 bg-neutral-50 flex flex-col md:flex-row gap-6 items-center">
          <div class="flex-1 bg-white border-2 border-neutral-900 p-6 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] text-center space-y-3 w-full">
            <div class="text-xs font-bold font-mono uppercase text-amber-700 tracking-wider">
              {l('检测到强制注册 / 导出付费墙 · 页面零遮挡注入', 'Forced Login Wall Detected · Zero DOM Injection')}
            </div>
            <h3 class="text-xl font-bold text-neutral-900">"Create an account to export your design"</h3>
            <p class="text-xs text-neutral-600 max-w-sm mx-auto">
              {l(
                '您刚花了 15 分钟排好版，SaaS 平台却弹出强制邮箱注册与信用卡绑定。此时右上角工具栏图标亮起橙色角标「4」。',
                'You spent 15 minutes editing a graphic, and now the SaaS platform demands an account. Meanwhile, your toolbar badge lights up with "4" verified replacements.'
              )}
            </p>
            <div class="pt-2">
              <div class="inline-block px-4 py-2 bg-neutral-200 text-neutral-500 text-xs font-mono font-bold border border-neutral-400 cursor-not-allowed">
                Sign in with Google / Email
              </div>
            </div>
          </div>

          <div class="w-full md:w-84 bg-white border-2 border-neutral-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] p-4 space-y-3 font-mono">
            <div class="flex items-center justify-between border-b-2 border-neutral-900 pb-2">
              <span class="text-xs font-black uppercase text-neutral-900">🛡️ nologin.tools v2.0</span>
              <span class="text-[9px] bg-amber-100 text-amber-950 font-bold px-1.5 py-0.5 border border-neutral-900">4 SWITCHES</span>
            </div>

            <div class="bg-yellow-50 border-2 border-amber-600 p-2.5 text-xs space-y-1.5">
              <div class="font-bold text-amber-900">⚡ {l('检测到付费墙 · 一键免登录平替：', 'Signup Wall Detected · Switch to No-Login:')}</div>
              <div class="space-y-1.5 pt-1">
                <div class="p-2 bg-white border border-amber-400 flex items-center justify-between">
                  <div>
                    <div class="font-bold text-neutral-900">Photopea <span class="text-[9px] bg-[#08695d] text-white px-1 rounded">95</span></div>
                    <div class="text-[10px] text-neutral-500">🔒 {l('纯本地 WebAssembly · 免登录', '100% Local · Zero Login')}</div>
                  </div>
                  <a href={getLocalizedPath('/tool/photopea-com', locale)} class="px-2 py-1 bg-neutral-900 text-white text-[10px] font-bold hover:bg-emerald-600">
                    {l('启动 ↗', 'Launch ↗')}
                  </a>
                </div>
                <div class="p-2 bg-white border border-amber-400 flex items-center justify-between">
                  <div>
                    <div class="font-bold text-neutral-900">Excalidraw <span class="text-[9px] bg-[#08695d] text-white px-1 rounded">96</span></div>
                    <div class="text-[10px] text-neutral-500">🔒 {l('端到端加密手绘白板', 'Local & E2EE Whiteboard')}</div>
                  </div>
                  <a href={getLocalizedPath('/tool/excalidraw-com', locale)} class="px-2 py-1 bg-neutral-900 text-white text-[10px] font-bold hover:bg-emerald-600">
                    {l('启动 ↗', 'Launch ↗')}
                  </a>
                </div>
              </div>
              <div class="pt-1 border-t border-amber-300 text-[10px]">
                <a href={getLocalizedPath('/category/design', locale)} class="font-bold text-amber-900 underline">
                  {l('查看设计修图免登录工具全榜单 →', 'Browse All Zero-Login Design Tools →')}
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* Scenario 3: Visiting a Verified Tool (Photopea 5D Lab HUD) */}
        <div id="demo-panel-verified" class="hidden p-6 sm:p-8 bg-neutral-50 flex flex-col md:flex-row gap-6 items-center">
          <div class="flex-1 bg-white border-2 border-neutral-900 p-6 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] text-center space-y-3 w-full">
            <div class="text-xs font-bold font-mono uppercase text-emerald-700 tracking-wider">
              {l('工具画布 100% 纯净 · 工具栏角标显示实测分「95」', '100% Clean Workspace Canvas · Toolbar Shows "95"')}
            </div>
            <h3 class="text-xl font-bold text-neutral-900">Photopea Workspace (photopea.com)</h3>
            <p class="text-xs text-neutral-600 max-w-sm mx-auto">
              {l(
                '访问已收录的 320+ 款免登录工具时，绝不在画布中注入任何遮挡图层的悬浮条。右上角工具栏直接显示翠绿色实测分「95」，点击即可展开 CADES 2.0 五维档案与同分类高分对比。',
                'When working inside any of the 320+ verified tools, the extension never injects floating widgets over your canvas. The toolbar icon displays "95" in emerald; click it to view the 5D CADES scorecard and peer comparisons.'
              )}
            </p>
          </div>

          <div class="w-full md:w-84 bg-emerald-50 border-2 border-emerald-700 shadow-[4px_4px_0px_0px_rgba(5,150,105,0.6)] p-4 space-y-2.5 font-mono">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-black uppercase text-emerald-900">🛡️ NoLogin Verified · {l('编辑精选', "Editor's Choice")}</span>
              <span class="text-xs font-black bg-emerald-600 text-white px-2 py-0.5">⚡ 95/100</span>
            </div>
            <div class="text-sm font-black text-neutral-900">Photopea (photopea.com)</div>
            <div class="flex flex-wrap gap-1 text-[9px] font-bold">
              <span class="bg-white border border-emerald-300 text-emerald-900 px-1.5 py-0.5">UX 19/20</span>
              <span class="bg-white border border-emerald-300 text-emerald-900 px-1.5 py-0.5">Depth 24/25</span>
              <span class="bg-white border border-emerald-300 text-emerald-900 px-1.5 py-0.5">Export 19/20</span>
              <span class="bg-white border border-emerald-300 text-emerald-900 px-1.5 py-0.5">Privacy 19/20</span>
              <span class="bg-white border border-emerald-300 text-emerald-900 px-1.5 py-0.5">Polish 14/15</span>
            </div>
            <div class="flex flex-wrap gap-1 text-[9px] font-bold">
              <span class="bg-emerald-200 text-emerald-950 px-1.5 py-0.5">🔒 100% Client-Side</span>
              <span class="bg-emerald-200 text-emerald-950 px-1.5 py-0.5">🐙 Open Source</span>
            </div>
            <p class="text-[10px] text-neutral-700 leading-snug">
