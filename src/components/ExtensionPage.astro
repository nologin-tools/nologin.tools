<script>
  // 1. Installation Guide Tabs
  const storeBtn = document.getElementById('tab-btn-chrome-store');
  const firefoxBtn = document.getElementById('tab-btn-firefox');
  const manualBtn = document.getElementById('tab-btn-manual');

  const storeContent = document.getElementById('tab-content-chrome-store');
  const firefoxContent = document.getElementById('tab-content-firefox');
  const manualContent = document.getElementById('tab-content-manual');

  const buttons = [storeBtn, firefoxBtn, manualBtn];
  const contents = [storeContent, firefoxContent, manualContent];

  function setActiveTab(activeBtn: HTMLElement | null, activeContent: HTMLElement | null) {
    buttons.forEach((btn) => {
      if (!btn) return;
      if (btn === activeBtn) {
        btn.classList.replace('bg-neutral-100', 'bg-neutral-900');
        btn.classList.replace('text-neutral-600', 'text-white');
        btn.classList.add('border-neutral-900');
      } else {
        btn.classList.replace('bg-neutral-900', 'bg-neutral-100');
        btn.classList.replace('text-white', 'text-neutral-600');
        btn.classList.remove('border-neutral-900');
      }
    });

    contents.forEach((c) => {
      if (!c) return;
      if (c === activeContent) {
        c.classList.remove('hidden');
      } else {
        c.classList.add('hidden');
      }
    });
  }

  storeBtn?.addEventListener('click', () => setActiveTab(storeBtn, storeContent));
  firefoxBtn?.addEventListener('click', () => setActiveTab(firefoxBtn, firefoxContent));
  manualBtn?.addEventListener('click', () => setActiveTab(manualBtn, manualContent));

  // 2. Interactive 3-Scenario Sandbox Switcher
  const demoTabs = document.querySelectorAll<HTMLButtonElement>('[data-demo-tab]');
  const addressEl = document.getElementById('demo-address');
  const badgeEl = document.getElementById('demo-toolbar-badge');
  const panelSerp = document.getElementById('demo-panel-serp');
  const panelPaywall = document.getElementById('demo-panel-paywall');
  const panelVerified = document.getElementById('demo-panel-verified');

  const DEMO_STATES: Record<string, { url: string; badgeText: string; badgeClass: string }> = {
    serp: {
      url: 'https://www.google.com/search?q=online+image+editor+no+signup',
      badgeText: 'SERP',
      badgeClass: 'bg-emerald-600 text-white px-1.5 py-0.2 text-[10px] font-black',
    },
    paywall: {
      url: 'https://prostudio.example/design/export',
      badgeText: '4',
      badgeClass: 'bg-amber-600 text-white px-1.5 py-0.2 text-[10px] font-black',
    },
    verified: {
      url: 'https://www.photopea.com',
      badgeText: '95',
      badgeClass: 'bg-emerald-600 text-white px-1.5 py-0.2 text-[10px] font-black',
    },
  };

  demoTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.demoTab || 'serp';
      const state = DEMO_STATES[mode];
      if (!state) return;

      demoTabs.forEach((b) => {
        if (b === btn) {
          b.classList.remove('bg-white', 'text-neutral-800');
          b.classList.add('bg-neutral-900', 'text-white');
        } else {
          b.classList.remove('bg-neutral-900', 'text-white');
          b.classList.add('bg-white', 'text-neutral-800');
        }
      });

      if (addressEl) addressEl.textContent = state.url;
      if (badgeEl) {
        badgeEl.textContent = state.badgeText;
        badgeEl.className = state.badgeClass;
      }

      panelSerp?.classList.toggle('hidden', mode !== 'serp');
      panelPaywall?.classList.toggle('hidden', mode !== 'paywall');
      panelVerified?.classList.toggle('hidden', mode !== 'verified');
    });
  });
</script>
