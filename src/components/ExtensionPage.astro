---
import Layout from '../layouts/Layout.astro';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
await loadTranslations(locale);

const title = t(locale, 'extension.title');
const description = t(locale, 'extension.description');
---

<Layout title={title} description={description} locale={locale}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    {/* Breadcrumbs */}
    <nav class="mb-8 text-xs text-neutral-500 font-mono flex items-center gap-2">
      <a href={getLocalizedPath('/', locale)} class="hover:underline hover:text-neutral-900">Home</a>
      <span>/</span>
      <span class="text-neutral-900 font-semibold">{t(locale, 'nav.extension')}</span>
    </nav>

    {/* Hero Section */}
    <header class="mb-14 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-yellow-300 text-neutral-900 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] uppercase tracking-wider mb-6">
        <span>🛡️</span>
        <span>{t(locale, 'extension.hero.badge')}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-neutral-900 tracking-tight uppercase italic mb-6">
        {t(locale, 'extension.hero.heading')}
      </h1>

      <p class="text-base sm:text-lg text-neutral-600 leading-relaxed mb-8">
        {t(locale, 'extension.hero.subtitle')}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/downloads/nologin-quick-switcher-chrome.zip"
          download="nologin-quick-switcher-chrome.zip"
          class="inline-flex items-center gap-2 px-6 py-3.5 bg-neutral-900 text-white font-mono text-xs sm:text-sm font-bold uppercase tracking-wider border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-emerald-600 hover:border-emerald-600 transition-all active:translate-x-[2px] active:translate-y-[2px] active:shadow-none cursor-pointer"
        >
          <span>📦</span>
          <span>{t(locale, 'extension.btn.download')}</span>
        </a>

        <a
          href="https://github.com/nologin-tools/nologin.tools/tree/main/packages/extension"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3.5 bg-white text-neutral-900 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider border-2 border-neutral-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-neutral-50 transition-all active:translate-x-[2px] active:translate-y-[2px] active:shadow-none"
        >
          <span>🐙</span>
          <span>{t(locale, 'extension.btn.github')}</span>
        </a>
      </div>

      <div class="mt-6 flex items-center justify-center gap-3 text-xs text-neutral-500 font-mono">
        <span>Supports:</span>
        <span class="font-bold text-neutral-700">Chrome</span>
        <span>·</span>
        <span class="font-bold text-neutral-700">Brave</span>
        <span>·</span>
        <span class="font-bold text-neutral-700">Edge</span>
        <span>·</span>
        <span class="font-bold text-neutral-700">Firefox</span>
      </div>
    </header>

    {/* Interactive Browser Mockup */}
    <section class="mb-16">
      <div class="bg-white border-2 border-neutral-900 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] rounded-2xl overflow-hidden">
        {/* Mockup Window Header */}
        <div class="bg-neutral-100 border-b-2 border-neutral-900 px-4 py-3 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-400 border border-neutral-900 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-400 border border-neutral-900 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-400 border border-neutral-900 inline-block"></span>
          </div>

          <div class="flex-1 max-w-md mx-4">
            <div class="bg-white border border-neutral-300 rounded px-3 py-1 text-xs font-mono text-neutral-600 flex items-center justify-between">
              <span id="demo-address">https://canva.com/design</span>
              <span class="text-neutral-400 text-[10px]">🔒 Secure</span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <div class="relative">
              <span class="px-2 py-0.5 rounded bg-neutral-900 text-white font-mono text-[10px] font-bold">
                🛡️ <span class="bg-emerald-500 text-white px-1 rounded-xs">3</span>
              </span>
            </div>
          </div>
        </div>

        {/* Mockup Window Content */}
        <div class="p-6 sm:p-8 bg-neutral-50 flex flex-col md:flex-row gap-6 items-center">
          {/* Target Website Simulation */}
          <div class="flex-1 bg-white border border-neutral-300 p-6 rounded-xl shadow-xs text-center space-y-3 w-full">
            <div class="text-xs font-bold uppercase text-red-600 tracking-wider">Forced Login Wall Detected</div>
            <h3 class="text-xl font-bold text-neutral-800">"Create an account to export your design"</h3>
            <p class="text-xs text-neutral-500 max-w-sm mx-auto">
              You just spent 15 minutes formatting a quick social graphic, and now the SaaS platform demands an email, password, and credit card.
            </p>
            <div class="pt-2">
              <div class="inline-block px-4 py-2 bg-neutral-200 text-neutral-400 text-xs font-bold rounded cursor-not-allowed">
                Sign in with Google / Email
              </div>
            </div>
          </div>

          {/* Extension Quick Switch Popup Simulation */}
          <div class="w-full md:w-80 bg-[#fdfdfc] border-2 border-neutral-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] p-4 rounded-xl space-y-3 font-mono">
            <div class="flex items-center justify-between border-b border-neutral-200 pb-2">
              <span class="text-xs font-black uppercase text-neutral-900">nologin.tools</span>
              <span class="text-[9px] bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.5 rounded">DETECTED</span>
            </div>

            <div class="bg-yellow-100 border border-yellow-400 p-2.5 rounded text-xs space-y-1">
              <div class="font-bold text-neutral-900">⚡ Visiting Canva?</div>
              <div class="text-[11px] text-neutral-700">Switch to verified no-login alternatives:</div>
            </div>

            <div class="space-y-2 text-xs">
              <div class="p-2 bg-white border border-neutral-200 rounded flex items-center justify-between">
                <div>
                  <div class="font-bold text-neutral-900">Photopea</div>
                  <div class="text-[10px] text-neutral-500">Photoshop in-browser, zero login</div>
                </div>
                <a href={getLocalizedPath('/tool/photopea-com', locale)} class="px-2 py-1 bg-neutral-900 text-white text-[10px] font-bold rounded hover:bg-emerald-600">
                  Open ↗
                </a>
              </div>

              <div class="p-2 bg-white border border-neutral-200 rounded flex items-center justify-between">
                <div>
                  <div class="font-bold text-neutral-900">Excalidraw</div>
                  <div class="text-[10px] text-neutral-500">Hand-drawn sketches & E2EE</div>
                </div>
                <a href={getLocalizedPath('/tool/excalidraw-com', locale)} class="px-2 py-1 bg-neutral-900 text-white text-[10px] font-bold rounded hover:bg-emerald-600">
                  Open ↗
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Feature Pillars */}
    <section class="mb-16">
      <h2 class="text-2xl font-black text-neutral-900 tracking-tight uppercase italic text-center mb-8">
        {t(locale, 'extension.feat.title')}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white border-2 border-neutral-900 p-6 rounded-xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
          <div class="text-2xl mb-3">🎯</div>
          <h3 class="font-bold text-sm text-neutral-900 uppercase tracking-tight mb-2">
            {t(locale, 'extension.feat.1.title')}
          </h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            {t(locale, 'extension.feat.1.desc')}
          </p>
        </div>

        <div class="bg-white border-2 border-neutral-900 p-6 rounded-xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
          <div class="text-2xl mb-3">⚡</div>
          <h3 class="font-bold text-sm text-neutral-900 uppercase tracking-tight mb-2">
            {t(locale, 'extension.feat.2.title')}
          </h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            {t(locale, 'extension.feat.2.desc')}
          </p>
        </div>

        <div class="bg-white border-2 border-neutral-900 p-6 rounded-xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
          <div class="text-2xl mb-3">🔒</div>
          <h3 class="font-bold text-sm text-neutral-900 uppercase tracking-tight mb-2">
            {t(locale, 'extension.feat.3.title')}
          </h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            {t(locale, 'extension.feat.3.desc')}
          </p>
        </div>
      </div>
    </section>

    {/* Installation Guide Tabs */}
    <section class="mb-16 bg-white border-2 border-neutral-900 p-6 sm:p-8 rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
      <h2 class="text-xl sm:text-2xl font-black text-neutral-900 uppercase italic tracking-tight mb-6">
        {t(locale, 'extension.install.title')}
      </h2>

      <div class="space-y-6">
        {/* Tab Buttons */}
        <div class="flex border-b-2 border-neutral-900 gap-2">
          <button
            id="tab-btn-chrome"
            class="px-4 py-2 font-mono text-xs font-bold uppercase bg-neutral-900 text-white border-t-2 border-l-2 border-r-2 border-neutral-900 -mb-[2px] cursor-pointer"
          >
            {t(locale, 'extension.install.chrome.tab')}
          </button>
          <button
            id="tab-btn-firefox"
            class="px-4 py-2 font-mono text-xs font-bold uppercase bg-neutral-100 text-neutral-600 hover:text-neutral-900 border-t-2 border-l-2 border-r-2 border-transparent -mb-[2px] cursor-pointer"
          >
            {t(locale, 'extension.install.firefox.tab')}
          </button>
        </div>

        {/* Tab 1: Chrome / Brave / Edge */}
        <div id="tab-content-chrome" class="space-y-4 text-xs font-mono">
          <div class="pb-2">
            <a
              href="/downloads/nologin-quick-switcher-chrome.zip"
              download="nologin-quick-switcher-chrome.zip"
              class="inline-flex items-center gap-2 px-4 py-2 bg-neutral-900 text-white font-mono text-xs font-bold uppercase rounded-lg hover:bg-neutral-800 transition-colors shadow-xs"
            >
              <span>🌐</span>
              <span>Download Chrome / Edge / Brave Package (.zip)</span>
            </a>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-yellow-300 border border-neutral-900 font-bold flex items-center justify-center flex-shrink-0">1</span>
            <p class="pt-0.5 text-neutral-700">{t(locale, 'extension.install.chrome.step1')}</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-yellow-300 border border-neutral-900 font-bold flex items-center justify-center flex-shrink-0">2</span>
            <p class="pt-0.5 text-neutral-700">{t(locale, 'extension.install.chrome.step2')}</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-yellow-300 border border-neutral-900 font-bold flex items-center justify-center flex-shrink-0">3</span>
            <p class="pt-0.5 text-neutral-700">{t(locale, 'extension.install.chrome.step3')}</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-yellow-300 border border-neutral-900 font-bold flex items-center justify-center flex-shrink-0">4</span>
            <p class="pt-0.5 text-neutral-700">{t(locale, 'extension.install.chrome.step4')}</p>
          </div>
        </div>

        {/* Tab 2: Firefox */}
        <div id="tab-content-firefox" class="hidden space-y-4 text-xs font-mono">
          <div class="pb-2">
            <a
              href="/downloads/nologin-quick-switcher-firefox.zip"
              download="nologin-quick-switcher-firefox.zip"
              class="inline-flex items-center gap-2 px-4 py-2 bg-orange-600 text-white font-mono text-xs font-bold uppercase rounded-lg hover:bg-orange-700 transition-colors shadow-xs"
            >
              <span>🦊</span>
              <span>Download Firefox Add-on Package (.zip)</span>
            </a>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-orange-300 border border-neutral-900 font-bold flex items-center justify-center flex-shrink-0">1</span>
            <p class="pt-0.5 text-neutral-700">{t(locale, 'extension.install.firefox.step1')}</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-orange-300 border border-neutral-900 font-bold flex items-center justify-center flex-shrink-0">2</span>
            <p class="pt-0.5 text-neutral-700">{t(locale, 'extension.install.firefox.step2')}</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-orange-300 border border-neutral-900 font-bold flex items-center justify-center flex-shrink-0">3</span>
            <p class="pt-0.5 text-neutral-700">{t(locale, 'extension.install.firefox.step3')}</p>
          </div>
        </div>
      </div>
    </section>

    {/* Bottom CTA */}
    <div class="text-center py-8">
      <h3 class="text-lg font-bold text-neutral-900 uppercase italic mb-3">Prefer the full web experience?</h3>
      <div class="flex items-center justify-center gap-4">
        <a href={getLocalizedPath('/finder', locale)} class="text-xs font-mono font-bold text-neutral-600 hover:text-neutral-900 hover:underline">
          Open No-Login Finder →
        </a>
        <span>·</span>
        <a href={getLocalizedPath('/developers', locale)} class="text-xs font-mono font-bold text-neutral-600 hover:text-neutral-900 hover:underline">
          Developer API & MCP →
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  const chromeBtn = document.getElementById('tab-btn-chrome');
  const firefoxBtn = document.getElementById('tab-btn-firefox');
  const chromeContent = document.getElementById('tab-content-chrome');
  const firefoxContent = document.getElementById('tab-content-firefox');

  chromeBtn?.addEventListener('click', () => {
    chromeBtn.classList.replace('bg-neutral-100', 'bg-neutral-900');
    chromeBtn.classList.replace('text-neutral-600', 'text-white');
    chromeBtn.classList.add('border-neutral-900');

    firefoxBtn?.classList.replace('bg-neutral-900', 'bg-neutral-100');
    firefoxBtn?.classList.replace('text-white', 'text-neutral-600');
    firefoxBtn?.classList.remove('border-neutral-900');

    chromeContent?.classList.remove('hidden');
    firefoxContent?.classList.add('hidden');
  });

  firefoxBtn?.addEventListener('click', () => {
    firefoxBtn.classList.replace('bg-neutral-100', 'bg-neutral-900');
    firefoxBtn.classList.replace('text-neutral-600', 'text-white');
    firefoxBtn.classList.add('border-neutral-900');

    chromeBtn?.classList.replace('bg-neutral-900', 'bg-neutral-100');
    chromeBtn?.classList.replace('text-white', 'text-neutral-600');
    chromeBtn?.classList.remove('border-neutral-900');

    firefoxContent?.classList.remove('hidden');
    chromeContent?.classList.add('hidden');
  });
</script>
