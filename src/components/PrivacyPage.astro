---
import Layout from '../layouts/Layout.astro';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
await loadTranslations(locale);

const effectiveDate = 'September 17, 2026';
---

<Layout title={t(locale, 'privacy.title')} description={t(locale, 'privacy.description')} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'common.home'), item: `https://nologin.tools${getLocalizedPath('/', locale)}` },
      { '@type': 'ListItem', position: 2, name: t(locale, 'privacy.heading'), item: `https://nologin.tools${getLocalizedPath('/privacy', locale)}` },
    ],
  })} />

  <div class="max-w-4xl mx-auto px-6 py-16 sm:py-24">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-2 text-xs font-mono font-bold text-neutral-500">
        <li>
          <a href={getLocalizedPath('/', locale)} class="hover:text-neutral-900 transition-colors">{t(locale, 'common.home')}</a>
        </li>
        <li aria-hidden="true">
          <svg class="w-3.5 h-3.5 text-neutral-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
        </li>
        <li aria-current="page" class="text-neutral-900 font-bold">{t(locale, 'privacy.heading')}</li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="mb-12 border-b-2 border-neutral-900 pb-8">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 text-xs font-mono font-bold bg-emerald-100 text-emerald-800 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] uppercase tracking-wider mb-4">
        <span>🔒 Zero Data Collection Guarantee</span>
      </div>
      <h1 class="text-3xl font-black tracking-tight text-neutral-900 mb-3">{t(locale, 'privacy.heading')}</h1>
      <p class="text-base text-neutral-700 max-w-2xl leading-relaxed">
        This Privacy Policy outlines the data handling practices for <strong>nologin.tools</strong> (the website) and the <strong>NoLogin Tools - Privacy &amp; Zero-Signup Switcher</strong> browser extension.
      </p>
      <p class="text-xs font-mono font-bold text-neutral-500 mt-3">
        Effective Date: {effectiveDate} · Maintained by <a href="https://nologintools.org" target="_blank" rel="noopener noreferrer" class="text-neutral-900 underline hover:text-emerald-700 transition-colors">NoLoginTools.org</a>
      </p>
    </div>

    <!-- 1. Executive Summary -->
    <section class="border-2 border-neutral-900 bg-white p-6 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] mb-8">
      <h2 class="text-lg font-bold font-mono text-neutral-900 mb-3 uppercase tracking-wide">1. Executive Summary &amp; Core Philosophy</h2>
      <p class="text-sm text-neutral-700 leading-relaxed mb-4">
        We believe privacy is a fundamental human right. Our core mission is to index and promote software tools that function completely without requiring account creation, login credentials, personal email harvesting, or behavioral tracking.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono">
        <div class="p-3 bg-neutral-50 border border-neutral-300">
          <span class="text-emerald-700 font-bold block mb-1">✓ ZERO ACCOUNTS</span>
          No user profiles, passwords, social logins, or cloud session cookies.
        </div>
        <div class="p-3 bg-neutral-50 border border-neutral-300">
          <span class="text-emerald-700 font-bold block mb-1">✓ ZERO TRACKERS</span>
          No Google Analytics, Meta Pixels, ad beacons, or fingerprinting.
        </div>
        <div class="p-3 bg-neutral-50 border border-neutral-300">
          <span class="text-emerald-700 font-bold block mb-1">✓ 100% LOCAL</span>
          Search indexing and matching execute directly on your device.
        </div>
      </div>
    </section>

    <!-- 2. Browser Extension Privacy Disclosure -->
    <section class="border-b-2 border-neutral-900 pb-8 mb-8">
      <h2 class="text-xl font-bold font-mono text-neutral-900 mb-4 uppercase tracking-wide">
        2. Browser Extension Privacy Policy
      </h2>
      <p class="text-xs font-mono text-neutral-500 mb-4">
        Applicable to: <strong>NoLogin Tools - Privacy &amp; Zero-Signup Switcher</strong> (Chrome Web Store, Firefox AMO, Edge Add-ons)
      </p>

      <div class="space-y-4 text-sm text-neutral-700 leading-relaxed">
        <div class="border-2 border-neutral-900 bg-white p-5 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
          <h3 class="font-bold text-neutral-900 mb-2 font-mono uppercase text-xs">2.1 Single Purpose Specification</h3>
          <p>
            The extension has one single, clearly defined purpose: to contextually identify when you are visiting restrictive, closed, or paywalled web tools (such as graphic editors, diagram whiteboards, or document utilities) and immediately recommend verified, zero-login, client-side web alternatives directly within your browser.
          </p>
        </div>

        <div class="border-2 border-neutral-900 bg-white p-5 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
          <h3 class="font-bold text-neutral-900 mb-2 font-mono uppercase text-xs">2.2 Permission Disclosures &amp; Strict Scope</h3>
          <p class="mb-3">
            In compliance with the Chrome Web Store Minimum Permissions Policy, the extension requests only one permission:
          </p>
          <ul class="space-y-2 text-xs font-mono">
            <li class="p-2 bg-neutral-50 border border-neutral-200">
              <strong class="text-neutral-900">activeTab:</strong> Granted temporarily <em>only when you explicitly click the toolbar icon</em>. The extension inspects solely the hostname of your currently active tab (e.g., matching a domain like <code class="bg-neutral-200 px-1">canva.com</code> against an offline table) to suggest relevant alternatives.
            </li>
          </ul>
          <p class="mt-3 text-xs text-neutral-600">
            <strong>Explicit Restrictions:</strong> The extension <strong>CANNOT</strong> and <strong>DOES NOT</strong> read website content, DOM nodes, form fields, passwords, keystrokes, browsing history across other tabs, or background network traffic.
          </p>
        </div>

        <div class="border-2 border-neutral-900 bg-white p-5 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
          <h3 class="font-bold text-neutral-900 mb-2 font-mono uppercase text-xs">2.3 External Network Requests &amp; Third-Party Services</h3>
          <p class="mb-2">
            The extension runs completely offline using a bundled, pre-compiled JSON database of verified tools.
          </p>
          <p class="text-xs text-neutral-600 mb-3">
            <strong>Favicon Display Disclosure:</strong> To provide visual cues in search results, the extension requests public website favicons via Google's Favicon Service (<code class="bg-neutral-100 px-1">https://www.google.com/s2/favicons?domain=...</code>). These requests contain only the public domain name of the curated tool (e.g., <code class="bg-neutral-100 px-1">excalidraw.com</code>). No user identity, IP-identifying data, browser cookies, or browsing history are ever transmitted.
          </p>
          <p class="text-xs text-neutral-600">
            <strong>No Remote Code Execution:</strong> The extension contains zero dynamically evaluated code (<code class="bg-neutral-100 px-1">eval</code>, remote scripts, or external WASM). All code is bundled inside the static package reviewed by store operators.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. Website Privacy Policy -->
    <section class="border-b-2 border-neutral-900 pb-8 mb-8">
      <h2 class="text-xl font-bold font-mono text-neutral-900 mb-4 uppercase tracking-wide">
        3. Website Privacy Policy (nologin.tools)
      </h2>
      <div class="space-y-4 text-sm text-neutral-700 leading-relaxed">
        <p>
          <strong>No Cookies or User Tracking:</strong> The nologin.tools website does not set tracking cookies, local storage identifiers for cross-site tracking, or session identifiers. Language preferences are stored locally in your browser to deliver your preferred translation.
        </p>
        <p>
          <strong>Server &amp; CDN Infrastructure:</strong> The website is served statically via Cloudflare Pages. Cloudflare may process transient network connection metadata (such as IP address and request headers) strictly for DDoS mitigation, caching efficiency, and security auditing per Cloudflare's standard infrastructure terms. We do not store or inspect individual visitor access logs.
        </p>
        <p>
          <strong>Tool Submissions:</strong> If you choose to submit a tool via <a href={getLocalizedPath('/submit', locale)} class="underline hover:text-neutral-900">/submit</a>, providing an email address is entirely optional. Any submitted email is used strictly for review status notifications and is never sold, shared, or used for marketing.
        </p>
      </div>
    </section>

    <!-- 4. Data Retention, Sharing & Rights -->
    <section class="border-b-2 border-neutral-900 pb-8 mb-8">
      <h2 class="text-xl font-bold font-mono text-neutral-900 mb-4 uppercase tracking-wide">
        4. Data Retention, Sharing &amp; User Rights
      </h2>
      <ul class="space-y-3 text-sm text-neutral-700 leading-relaxed">
        <li class="flex items-start gap-2">
          <span class="text-emerald-700 font-mono font-bold shrink-0">[✓]</span>
          <span><strong>No Data Sale:</strong> We never sell, rent, monetize, or trade any user information to data brokers, advertisers, or third parties under any circumstances.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-emerald-700 font-mono font-bold shrink-0">[✓]</span>
          <span><strong>No Targeted Advertising:</strong> Neither the website nor the browser extension displays advertisements, affiliate trackers, or sponsored search injections.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-emerald-700 font-mono font-bold shrink-0">[✓]</span>
          <span><strong>GDPR &amp; CCPA Compliance:</strong> Because we do not collect personal identifying information or maintain user databases, there is no personal profile to request deletion of. If you have submitted an email during tool submission and wish for it to be purged, contact us at any time.</span>
        </li>
      </ul>
    </section>

    <!-- 5. Open Source Transparency & Contact -->
    <section class="border-2 border-neutral-900 bg-neutral-50 p-6 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
      <h2 class="text-lg font-bold font-mono text-neutral-900 mb-2 uppercase tracking-wide">5. Open Source Transparency &amp; Contact</h2>
      <p class="text-sm text-neutral-700 leading-relaxed mb-4">
        Our complete source code—including the website, the browser extension, the review pipeline, and database export scripts—is publicly available and auditable under open-source licenses.
      </p>
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono font-bold">
        <a
          href="https://github.com/nologin-tools/nologin.tools"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-retro uppercase"
        >
          View Source on GitHub &rarr;
        </a>
        <a
          href="https://github.com/nologin-tools/nologin.tools/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-minimal"
        >
          Report Privacy Issue
        </a>
      </div>
    </section>
  </div>
</Layout>
