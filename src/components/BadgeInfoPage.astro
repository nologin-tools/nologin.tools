---
import Layout from '../layouts/Layout.astro';
import { t, loadTranslations, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import { getApprovedTools, getLocalizedDescription } from '../data/loader';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
await loadTranslations(locale);

const approvedTools = getApprovedTools();
const verifiedExhibitors = approvedTools.filter((t) => t.badgeDisplayType === 'explicit');
const badgeModifiedDate = '2026-03-20T00:00:00.000Z';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'nologin.tools',
  url: 'https://nologin.tools',
  description: 'Curated directory of verified privacy-friendly web tools that work without login or accounts.',
  inLanguage: locale,
  publisher: {
    '@type': 'Organization',
    name: 'NoLoginTools.org',
    url: 'https://nologintools.org',
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: `https://nologin.tools${getLocalizedPath('/finder', locale)}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'NoLoginTools.org',
  url: 'https://nologintools.org',
  logo: 'https://nologin.tools/icon-192.png',
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hello@nologin.tools',
    contactType: 'editorial and privacy inquiries',
  },
  sameAs: [
    'https://x.com/nologin_tools',
    'https://github.com/nologin-tools',
    'https://nologin.tools',
  ],
  knowsAbout: [
    'Privacy Tools',
    'No-Login Web Software',
    'Client-Side Computing',
  ],
};
---

<Layout
  title={t(locale, 'badge.title')}
  description={t(locale, 'badge.description')}
  locale={locale}
  modifiedTime={badgeModifiedDate}
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: locale,
    mainEntity: [
      {
        '@type': 'Question',
        name: t(locale, 'badge.faq.q1'),
        acceptedAnswer: { '@type': 'Answer', text: t(locale, 'badge.faq.a1') },
      },
      {
        '@type': 'Question',
        name: t(locale, 'badge.faq.q2'),
        acceptedAnswer: { '@type': 'Answer', text: t(locale, 'badge.faq.a2') },
      },
      {
        '@type': 'Question',
        name: t(locale, 'badge.faq.q3'),
        acceptedAnswer: { '@type': 'Answer', text: t(locale, 'badge.faq.a3') },
      },
      {
        '@type': 'Question',
        name: t(locale, 'badge.faq.q4'),
        acceptedAnswer: { '@type': 'Answer', text: t(locale, 'badge.faq.a4') },
      },
    ],
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    inLanguage: locale,
    name: t(locale, 'badge.howToName'),
    description: t(locale, 'badge.joinDesc'),
    step: [
      { '@type': 'HowToStep', position: 1, name: t(locale, 'badge.step1'), text: t(locale, 'badge.step1'), url: `https://nologin.tools${getLocalizedPath('/submit', locale)}` },
      { '@type': 'HowToStep', position: 2, name: t(locale, 'badge.step2'), text: t(locale, 'badge.step2') },
      { '@type': 'HowToStep', position: 3, name: t(locale, 'badge.step3'), text: t(locale, 'badge.step3') },
      { '@type': 'HowToStep', position: 4, name: t(locale, 'badge.step4'), text: t(locale, 'badge.step4') },
    ],
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'common.home'), item: `https://nologin.tools${getLocalizedPath('/', locale)}` },
      { '@type': 'ListItem', position: 2, name: t(locale, 'badge.title'), item: `https://nologin.tools${getLocalizedPath('/badge', locale)}` },
    ],
  })} />

  <div class="max-w-4xl mx-auto px-6 py-16 sm:py-24">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-2 text-sm font-bold text-neutral-400">
        <li>
          <a href={getLocalizedPath('/', locale)} class="hover:text-neutral-900 transition-colors">{t(locale, 'common.home')}</a>
        </li>
        <li aria-hidden="true">
          <svg class="w-4 h-4 text-neutral-300" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
        </li>
        <li aria-current="page" class="text-neutral-900">{t(locale, 'badge.title')}</li>
      </ol>
    </nav>
    <!-- Hero -->
    <div class="text-center mb-16">
      <div class="mb-8">
        <img
          src="/badge.svg"
          alt="NoLogin Verified"
          class="w-48 mx-auto"
        />
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 mb-4">
        {t(locale, 'badge.heroTitle')}
      </h1>
      <p class="text-base text-neutral-500 max-w-2xl mx-auto leading-relaxed">
        {t(locale, 'badge.heroDesc')}
      </p>
    </div>

    <!-- Certificate Quick Lookup -->
    <div class="max-w-xl mx-auto mb-16">
      <div class="border-2 border-neutral-900 bg-white p-5 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
        <label for="cert-lookup-input" class="block text-xs font-mono font-bold uppercase tracking-wider text-neutral-700 mb-2">
          Verify a Tool's Digital Certificate
        </label>
        <form id="cert-lookup-form" class="flex flex-col sm:flex-row items-center gap-2">
          <div class="relative w-full flex-1">
            <input
              type="text"
              id="cert-lookup-input"
              name="slug"
              list="approved-tools-datalist"
              placeholder="Search by tool name or slug (e.g. excalidraw-com)..."
              class="w-full px-3.5 py-2 text-xs sm:text-sm font-mono bg-white border-2 border-neutral-900 rounded-none focus:outline-none focus:bg-yellow-50 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
              autocomplete="off"
            />
            <datalist id="approved-tools-datalist">
              {approvedTools.map((t) => (
                <option value={t.slug}>{t.name} ({t.slug})</option>
              ))}
            </datalist>
          </div>
          <button
            type="submit"
            class="w-full sm:w-auto px-4 py-2.5 text-xs font-mono font-bold uppercase tracking-wider text-white bg-neutral-900 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-neutral-800 whitespace-nowrap cursor-pointer transition-none"
          >
            Inspect Certificate
          </button>
        </form>
        <p class="text-[11px] font-mono text-neutral-500 mt-2.5">
          Enter any verified tool name or slug to inspect its real-time SSL digital certificate, health monitoring, and trust signals.
        </p>
      </div>
    </div>

    <!-- What is NoLogin Verified? -->
    <div class="border-b-2 border-neutral-900 pb-8 mb-8">
      <h2 class="text-xl font-bold font-mono text-neutral-900 mb-4 uppercase tracking-wide">{t(locale, 'badge.whatIsTitle')}</h2>
      <div class="space-y-3 text-neutral-700 leading-relaxed">
        <p>
          {t(locale, 'badge.whatIsP1')} <a href="https://nologintools.org" target="_blank" rel="noopener noreferrer" class="text-neutral-900 underline hover:text-emerald-700 font-bold transition-colors">NoLoginTools.org</a> {t(locale, 'badge.whatIsP1Suffix')}
        </p>
        <p>
          {t(locale, 'badge.whatIsP2')}
        </p>
        <p class="text-xs font-mono text-neutral-500">
          Governed by the <a href="https://nologintools.org/standards" target="_blank" rel="noopener noreferrer" class="text-neutral-900 underline hover:text-emerald-700 font-bold transition-colors">NLW-STD-001 Verification Standard</a>.
        </p>
      </div>
    </div>

    <!-- Three-column grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-16">
      <div class="border-2 border-neutral-900 bg-white p-4 text-center shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <h3 class="font-bold font-mono text-neutral-900 mb-1 text-sm uppercase tracking-wide">{t(locale, 'badge.noAccountsTitle')}</h3>
        <p class="text-xs text-neutral-600 font-mono">{t(locale, 'badge.noAccountsDesc')}</p>
      </div>
      <div class="border-2 border-neutral-900 bg-white p-4 text-center shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <h3 class="font-bold font-mono text-neutral-900 mb-1 text-sm uppercase tracking-wide">{t(locale, 'badge.privacyFirstTitle')}</h3>
        <p class="text-xs text-neutral-600 font-mono">{t(locale, 'badge.privacyFirstDesc')}</p>
      </div>
      <div class="border-2 border-neutral-900 bg-white p-4 text-center shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <h3 class="font-bold font-mono text-neutral-900 mb-1 text-sm uppercase tracking-wide">{t(locale, 'badge.instantValueTitle')}</h3>
        <p class="text-xs text-neutral-600 font-mono">{t(locale, 'badge.instantValueDesc')}</p>
      </div>
    </div>

    <div class="space-y-12">
      <!-- Two Column Layout for Users/Creators -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- For Users -->
        <section class="border-2 border-neutral-900 bg-white p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
          <h2 class="text-lg font-bold font-mono text-neutral-900 mb-4 flex items-center gap-2 uppercase tracking-wide">
            <span class="w-6 h-6 border-2 border-neutral-900 bg-emerald-200 flex items-center justify-center text-neutral-900 text-xs font-mono font-bold shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">U</span>
            {t(locale, 'badge.sealTitle')}
          </h2>
          <p class="text-sm text-neutral-700 leading-relaxed mb-4">
            {t(locale, 'badge.sealDesc')}
          </p>
          <ul class="space-y-3">
            {[
              { title: t(locale, 'badge.manualReview'), desc: t(locale, 'badge.manualReviewDesc') },
              { title: t(locale, 'badge.coreTaskVerified'), desc: t(locale, 'badge.coreTaskVerifiedDesc') },
              { title: t(locale, 'badge.healthMonitoring'), desc: t(locale, 'badge.healthMonitoringDesc') },
              { title: t(locale, 'badge.digitalPreservation'), desc: t(locale, 'badge.digitalPreservationDesc') },
            ].map(item => (
              <li class="flex items-start gap-3">
                <span class="text-emerald-700 font-mono font-bold shrink-0 mt-0.5">[✓]</span>
                <div>
                  <p class="text-sm font-bold text-neutral-900">{item.title}</p>
                  <p class="text-xs text-neutral-600 mt-0.5 leading-relaxed">{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <!-- For Creators -->
        <section class="border-2 border-neutral-900 bg-white p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
          <h2 class="text-lg font-bold font-mono text-neutral-900 mb-4 flex items-center gap-2 uppercase tracking-wide">
            <span class="w-6 h-6 border-2 border-neutral-900 bg-blue-200 flex items-center justify-center text-neutral-900 text-xs font-mono font-bold shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">C</span>
            {t(locale, 'badge.joinTitle')}
          </h2>
          <p class="text-sm text-neutral-700 leading-relaxed mb-6">
            {t(locale, 'badge.joinDesc')}
          </p>
          <div class="space-y-4 font-mono">
            {[t(locale, 'badge.step1'), t(locale, 'badge.step2'), t(locale, 'badge.step3'), t(locale, 'badge.step4')].map((step, i) => (
              <div class="flex items-center gap-3">
                 <div class="w-7 h-7 bg-neutral-100 border-2 border-neutral-900 flex items-center justify-center text-neutral-900 text-xs font-bold shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">{i + 1}</div>
                 <p class="text-xs sm:text-sm font-bold text-neutral-800">{step}</p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <!-- Ranking Boost -->
      <section class="border-t-2 border-neutral-900 pt-8 mt-8">
        <h2 class="text-xl font-bold font-mono text-neutral-900 mb-2 text-center uppercase tracking-wide">{t(locale, 'badge.rankingBoostTitle')}</h2>
        <p class="text-neutral-600 mb-8 max-w-xl mx-auto text-center text-xs font-mono">
          {t(locale, 'badge.rankingBoostDesc')}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 border-2 border-neutral-900 bg-white shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] text-center">
            <p class="font-mono font-bold text-neutral-900 mb-1 text-xs uppercase tracking-wider">{t(locale, 'badge.svgBadge')}</p>
            <p class="text-emerald-700 font-mono font-black text-3xl">+4</p>
            <p class="text-[10px] text-neutral-500 font-mono uppercase tracking-widest font-bold mt-1">{t(locale, 'badge.rankPoints')}</p>
          </div>

          <div class="p-5 border-2 border-neutral-900 bg-white shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] text-center">
            <p class="font-mono font-bold text-neutral-900 mb-1 text-xs uppercase tracking-wider">{t(locale, 'badge.metaLink')}</p>
            <p class="text-blue-700 font-mono font-black text-3xl">+2</p>
            <p class="text-[10px] text-neutral-500 font-mono uppercase tracking-widest font-bold mt-1">{t(locale, 'badge.rankPoints')}</p>
          </div>

          <div class="p-5 border-2 border-neutral-900 bg-white shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] text-center">
            <p class="font-mono font-bold text-neutral-900 mb-1 text-xs uppercase tracking-wider">{t(locale, 'badge.noBadge')}</p>
            <p class="text-neutral-400 font-mono font-black text-3xl">0</p>
            <p class="text-[10px] text-neutral-500 font-mono uppercase tracking-widest font-bold mt-1">{t(locale, 'badge.rankPoints')}</p>
          </div>
        </div>
      </section>

      <!-- Wall of Fame / Active Exhibitors -->
      <section class="border-t-2 border-neutral-900 pt-10 mt-10">
        <div class="text-center mb-8">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-emerald-100 text-emerald-950 border-2 border-neutral-900 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] text-xs font-mono font-bold uppercase tracking-wider mb-3">
            🛡️ Wall of Fame
          </span>
          <h2 class="text-xl sm:text-2xl font-bold font-mono text-neutral-900 mb-2 uppercase">
            Active Verified Exhibitors (Level 3)
          </h2>
          <p class="text-neutral-600 max-w-xl mx-auto text-xs font-mono leading-relaxed">
            These tools proudly embed the official NoLogin Verified badge on their website or repository, earning our highest trust level and algorithm boost (+4 pts).
          </p>
        </div>

        {verifiedExhibitors.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
            {verifiedExhibitors.map((tool) => {
              const hostname = new URL(tool.url).hostname.replace(/^www\./, '');
              const desc = getLocalizedDescription(tool, locale) || tool.description || '';
              return (
                <div class="p-4 border-2 border-neutral-900 bg-white shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <div class="flex items-center gap-2 min-w-0">
                        <img
                          src={`https://www.google.com/s2/favicons?domain=${hostname}&sz=32`}
                          alt={`${tool.name} icon`}
                          width="16"
                          height="16"
                          class="w-4 h-4 rounded-none shrink-0"
                          loading="lazy"
                          onerror="this.style.display='none'"
                        />
                        <a
                          href={getLocalizedPath(`/tool/${tool.slug}`, locale)}
                          class="font-bold text-sm text-neutral-900 hover:underline truncate"
                        >
                          {tool.name}
                        </a>
                      </div>
                      <span class="inline-flex items-center gap-0.5 text-[10px] font-mono font-bold px-1.5 py-0.5 bg-emerald-100 text-emerald-950 border border-neutral-900 shrink-0">
                        🛡️ Level 3
                      </span>
                    </div>
                    <p class="text-xs text-neutral-600 line-clamp-2 mb-3 leading-relaxed">
                      {desc}
                    </p>
                  </div>
                  <div class="pt-3 border-t-2 border-neutral-900 flex items-center justify-between text-xs font-mono">
                    <a
                      href={getLocalizedPath(`/badge/${tool.slug}`, locale)}
                      class="text-neutral-900 hover:underline font-bold inline-flex items-center gap-1"
                    >
                      Certificate &rarr;
                    </a>
                    <a
                      href={tool.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-neutral-500 hover:text-neutral-900 truncate max-w-[120px]"
                    >
                      {hostname} ↗
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="border-2 border-dashed border-neutral-900 p-8 text-center bg-white mb-8 max-w-xl mx-auto shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
            <div class="text-3xl mb-2">🛡️</div>
            <h3 class="font-bold font-mono text-neutral-900 text-sm mb-1 uppercase">Be the Next Level 3 Verified Exhibitor</h3>
            <p class="text-xs text-neutral-600 font-mono max-w-md mx-auto leading-relaxed mb-4">
              Add the badge to your website footer or GitHub README, and click "Verify Badge Now" on your certificate page to be instantly featured here.
            </p>
            <a
              href={getLocalizedPath('/submit', locale)}
              class="btn-primary inline-flex items-center gap-1 text-xs font-mono font-bold uppercase px-4 py-2 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[1px] hover:translate-y-[1px]"
            >
              Get Your Badge &rarr;
            </a>
          </div>
        )}
      </section>

      <!-- CTA -->
      <div class="text-center pt-4">
        <a
          href={getLocalizedPath('/submit', locale)}
          class="btn-primary inline-block px-8 py-3 font-mono font-bold uppercase tracking-wider text-sm shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px]"
        >
          {t(locale, 'badge.submitYourTool')}
        </a>
      </div>
    </div>
  </div>

  <script define:vars={{ locale }}>
    const form = document.getElementById('cert-lookup-form');
    const input = document.getElementById('cert-lookup-input');
    if (form && input) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = input.value.trim().toLowerCase();
        if (!val) return;
        const match = val.match(/\(([^)]+)\)$/);
        const slug = match ? match[1] : val;
        const targetPath = locale === 'en' ? `/badge/${encodeURIComponent(slug)}` : `/${locale}/badge/${encodeURIComponent(slug)}`;
        window.location.href = targetPath;
      });
    }
  </script>
</Layout>
