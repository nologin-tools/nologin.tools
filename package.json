{
  "name": "nologin.tools",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply nologin-tools-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nologin-tools-db --remote",
    "deploy": "astro build && wrangler pages deploy dist/ --project-name nologin-tools",
    "build:extension": "node scripts/build-extension.mjs",
    "mcp": "node packages/mcp/bin/cli.mjs",
    "test": "node --test scripts/__tests__/*.test.mjs packages/mcp/__tests__/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@cf-wasm/og": "^0.3.7",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.0",
    "astro": "^5.17.1",
    "drizzle-orm": "^0.45.1",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260218.0",
    "drizzle-kit": "^0.31.9",
    "wrangler": "^4.66.0"
  }
}
