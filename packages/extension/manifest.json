      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/extension-index.en.json",
        "src/extension-index.zh.json",
        "src/tools-data.json",
        "src/alternatives-data.json"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
